/-- Walk `p = start, start + 1, ...`; composite `p` are skipped by `hasDiv`, each prime `p`
consumes the next certificate, which must name `p`. -/
def walk : ℕ → ℕ → List (ℕ × ℕ) → Bool
  | 0, _, _ => true
  | fuel + 1, p, c =>
    if p < 2 || hasDiv p p 2 then walk fuel (p + 1) c else
      match c with
      | (q, d) :: c' => (q == p && certOK (nRec - p) d) && walk fuel (p + 1) c'
      | [] => false

theorem walk_sound : ∀ fuel p c, walk fuel p c = true →
    ∀ m, p ≤ m → m < p + fuel → m.Prime → ¬ (nRec - m).Prime := by
  intro fuel
  induction fuel with
  | zero => intro p c _ m h1 h2; omega
  | succ k ih =>
    intro p c h m h1 h2 hm
    simp only [walk] at h
    by_cases hc : (p < 2 || hasDiv p p 2) = true
    · rw [if_pos hc] at h
      rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
      · simp only [Bool.or_eq_true, decide_eq_true_eq] at hc
        rcases hc with hc | hc
        · exact absurd hm (by interval_cases p <;> norm_num)
        · exact absurd hm (hasDiv_sound p p 2 le_rfl hc)
      · exact ih (p + 1) c h m hlt (by omega) hm
    · rw [if_neg hc] at h
      match c, h with
      | (q, d) :: c', h =>
        simp only [Bool.and_eq_true, beq_iff_eq] at h
        obtain ⟨⟨hq, hd⟩, hw⟩ := h
        rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
        · exact not_prime_of_certOK hd
        · exact ih (p + 1) c' hw m hlt (by omega) hm

theorem checkAll : walk 9781 0 minCert = true := by decide +kernel

/-- No prime `p < 9781` gives a Goldbach partition of `nRec`. -/
theorem no_small_partition : ∀ p, p < 9781 → p.Prime → ¬ (nRec - p).Prime :=
  fun p hp => walk_sound 9781 0 minCert checkAll p (Nat.zero_le _) (by omega)

/-- Cited, P0005 pages: `nRec - 9781` is prime. -/
theorem prime_nRec_sub : (nRec - 9781).Prime :=
  Pratt.prime_nRec_sub_literal

/-- So the least prime of a Goldbach partition of `nRec` is 9781, from the cited primality. -/
theorem minGB_nRec : minGB nRec = 9781 := by
  have hex : ∃ p, p.Prime ∧ (nRec - p).Prime := ⟨9781, by norm_num, prime_nRec_sub⟩
  unfold minGB
  rw [dif_pos hex, Nat.find_eq_iff]
  refine ⟨⟨by norm_num, prime_nRec_sub⟩, fun m hm hmp => no_small_partition m hm hmp.1 hmp.2⟩

/-- Cited, P0005: every even `n` with `4 ≤ n ≤ 4e18` has `minGB n ≤ 9781`. -/
theorem minGB_le_9781 : ∀ n, Even n → 4 ≤ n → n ≤ 4 * 10 ^ 18 → minGB n ≤ 9781 := by sorry

