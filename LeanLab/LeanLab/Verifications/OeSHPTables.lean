def walkK : ℕ → ℕ → List (ℕ × ℕ) → Bool
  | 0, _, _ => true
  | fuel + 1, k, c =>
    if (pGap + k) % 2 = 0 then certOK (pGap + k) 2 && walkK fuel (k + 1) c else
      match c with
      | (q, d) :: c' => (q == k && certOK (pGap + k) d) && walkK fuel (k + 1) c'
      | [] => false

theorem walkK_sound : ∀ fuel k c, walkK fuel k c = true →
    ∀ m, k ≤ m → m < k + fuel → ¬ (pGap + m).Prime := by
  intro fuel
  induction fuel with
  | zero => intro k c _ m h1 h2; omega
  | succ n ih =>
    intro k c h m h1 h2
    simp only [walkK] at h
    by_cases hc : (pGap + k) % 2 = 0
    · rw [if_pos hc, Bool.and_eq_true] at h
      rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
      · exact not_prime_of_certOK h.1
      · exact ih (k + 1) c h.2 m hlt (by omega)
    · rw [if_neg hc] at h
      match c, h with
      | (q, d) :: c', h =>
        simp only [Bool.and_eq_true, beq_iff_eq] at h
        obtain ⟨⟨hq, hd⟩, hw⟩ := h
        rcases Nat.eq_or_lt_of_le h1 with rfl | hlt
        · exact not_prime_of_certOK hd
        · exact ih (k + 1) c' hw m hlt (by omega)

theorem checkGap : walkK 1475 1 gapCert = true := by decide +kernel

/-- No prime lies strictly between `pGap` and `pGap + 1476`. -/
theorem gap_composite : ∀ k, 0 < k → k < 1476 → ¬ (pGap + k).Prime :=
  fun k hk hk' => walkK_sound 1475 1 gapCert checkGap k hk (by omega)

/-- Cited, P0005 pages: both ends are prime. -/
theorem pGap_prime : pGap.Prime ∧ (pGap + 1476).Prime :=
  ⟨Pratt.pGap_prime_lo_literal, Pratt.pGap_prime_hi_literal⟩

/-- Cited, P0005: no gap between consecutive primes below 4e18 exceeds 1476. -/
theorem maxGap : ∀ p q, p.Prime → q.Prime → p < q → q ≤ 4 * 10 ^ 18 →
    (∀ r, p < r → r < q → ¬ r.Prime) → q - p ≤ 1476 := by sorry

