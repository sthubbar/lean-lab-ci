/-- The witness changes no coefficient except the fifth, within its rounding cell. -/
theorem table6_witness_rounding : ∀ r ∈ printedC241,
    (r.1 ≠ 5 → table7CoefficientWitness r.1 = r.2) ∧
    (r.1 = 5 → |table7CoefficientWitness r.1 - r.2| < 5 / 10^14) := by
  norm_num [printedC241, table7CoefficientWitness, List.lookup]

