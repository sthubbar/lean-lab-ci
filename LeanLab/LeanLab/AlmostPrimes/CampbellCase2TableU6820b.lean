/-- The kernel check of the base step for a list `L` over `PL`. -/
def baseCheckL (L : List (ℕ × ℕ)) (m0 e0 : ℕ) : Bool :=
  decide (m0 * ((mainL L 29921).map Prod.fst).prod ≤
    R * ((mainL L 29921).map (fun q => q.1 - 2)).prod) &&
  decide (R * ((errL L 29921).map (fun q => q.2 + 8 * 1000)).prod ≤
    e0 * ((errL L 29921).map Prod.snd).prod)

/-- **Base of a chain from any valid list covering the primes below 29921, PROVED.** -/
theorem good_baseL {L : List (ℕ × ℕ)} {a b m0 e0 : ℕ} (hb : 0 < b)
    (hval : validL L 1000 a b = true)
    (hcomp : ∀ p, p.Prime → p < 29921 → p ∈ L.map Prod.fst)
    (hc : baseCheckL L m0 e0 = true) : Good a b 29921 m0 e0 := by
  simp only [baseCheckL, Bool.and_eq_true, decide_eq_true_eq] at hc
  refine good_step hb (good_zero a b) (mainL L 29921) (errL L 29921)
    (fun q hq => (mem_mainL.mp hq).2.2) (validL_filter _ _ _ _ _ hval) ?_ ?_ hc.1 hc.2
  · intro p hp h5 _ hpB
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcomp p hp hpB)
    exact List.mem_map.mpr ⟨q, mem_mainL.mpr ⟨hq, hpB, h5⟩, rfl⟩
  · intro p hp h3 _ hpB
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (hcomp p hp hpB)
    exact List.mem_map.mpr ⟨q, mem_errL.mpr ⟨hq, hpB, h3⟩, rfl⟩

