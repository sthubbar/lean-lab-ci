/-! ### Coverage of the primes of an interval -/

/-- `cov n k l`: walking `n, n+1, …, n+k-1` against the sorted list `l`, every integer not at
the head of `l` has a divisor found by `tdiv`. -/
def cov (n : ℕ) : ℕ → List ℕ → Bool
  | 0, _ => true
  | k + 1, [] => tdiv n n 2 && cov (n + 1) k []
  | k + 1, p :: l => if p = n then cov (n + 1) k l else (tdiv n n 2 && cov (n + 1) k (p :: l))

/-- **`cov` is sound, PROVED**: every prime of `[n, n + k)` is in the list. -/
theorem cov_sound : ∀ k n l, cov n k l = true → ∀ p, p.Prime → n ≤ p → p < n + k → p ∈ l := by
  intro k
  induction k with
  | zero => intro n l _ p _ h1 h2; omega
  | succ k ih =>
    intro n l hc p hp h1 h2
    cases l with
    | nil =>
      simp only [cov, Bool.and_eq_true] at hc
      rcases Nat.eq_or_lt_of_le h1 with h | h
      · subst h; rw [tdiv_prime hp _ 2 le_rfl] at hc; exact absurd hc.1 (by simp)
      · exact ih (n + 1) [] hc.2 p hp h (by omega)
    | cons q l =>
      simp only [cov] at hc
      by_cases hq : q = n
      · rw [if_pos hq] at hc
        rcases Nat.eq_or_lt_of_le h1 with h | h
        · subst h; subst hq; simp
        · exact List.mem_cons_of_mem q (ih (n + 1) l hc p hp h (by omega))
      · rw [if_neg hq, Bool.and_eq_true] at hc
        rcases Nat.eq_or_lt_of_le h1 with h | h
        · subst h; rw [tdiv_prime hp _ 2 le_rfl] at hc; exact absurd hc.1 (by simp)
        · exact ih (n + 1) (q :: l) hc.2 p hp h (by omega)

/-! ### The running products -/

/-- The scale of the chain. -/
def R : ℕ := 10 ^ 40

/-- `∏_{5 ≤ p < v} (1 - 2/p)`, the product in `S2`. -/
noncomputable def P5 (v : ℕ) : ℝ := ∏ p ∈ primes5Below (v : ℝ), (1 - 2 / (p : ℝ))

/-- `∏_{p < v, p ≠ 3} (1 + 8/p^{a/b})`, the error product in `S2`. -/
noncomputable def PE (a b v : ℕ) : ℝ := ∏ p ∈ primesBelow (v : ℝ), (1 + 8 / (p : ℝ) ^ ((a : ℝ) / b))

/-- `Good a b v m e`: `m/R` is a lower bound for `P5 v` and `e/R` an upper bound for `PE a b v`. -/
def Good (a b v m e : ℕ) : Prop := (m : ℝ) / R ≤ P5 v ∧ PE a b v ≤ (e : ℝ) / R

lemma g_mem {x : ℕ} (h5 : 5 ≤ x) : 0 ≤ 1 - 2 / (x : ℝ) ∧ 1 - 2 / (x : ℝ) ≤ 1 := by
  have h5' : (5 : ℝ) ≤ x := by exact_mod_cast h5
  have : 2 / (x : ℝ) ≤ 1 := by rw [div_le_one (by linarith)]; linarith
  have : 0 ≤ 2 / (x : ℝ) := by positivity
  constructor <;> linarith

lemma P5_nonneg (v : ℕ) : 0 ≤ P5 v := by
  unfold P5
  refine prod_nonneg (fun p hp => ?_)
  unfold primes5Below at hp
  rw [Finset.mem_filter, mem_primesBelow] at hp
  exact (g_mem (two_le_of_ne3 hp.1.1 hp.2 hp.1.2.1)).1

lemma f_ge (δ : ℝ) (x : ℕ) : 1 ≤ 1 + 8 / (x : ℝ) ^ δ := by
  have : 0 ≤ (x : ℝ) ^ δ := rpow_nonneg (Nat.cast_nonneg x) _
  have : 0 ≤ 8 / (x : ℝ) ^ δ := by positivity
  linarith

/-- **Main step, PROVED**: `P5 A · ∏ (p - 2)/p ≤ P5 B` when the list covers the primes
`5 ≤ p` of `[A, B)` and has entries `≥ 5`. -/
theorem main_step {A B : ℕ} (l : List (ℕ × ℕ)) (h5 : ∀ q ∈ l, 5 ≤ q.1)
    (hcov : ∀ p, p.Prime → 5 ≤ p → A ≤ p → p < B → p ∈ l.map Prod.fst) :
    P5 A * (((l.map (fun q => q.1 - 2)).prod : ℕ) : ℝ) / (((l.map Prod.fst).prod : ℕ) : ℝ)
      ≤ P5 B := by
  set X := primes5Below (A : ℝ)
  set Y := (l.map Prod.fst).toFinset
  set g : ℕ → ℝ := fun x => 1 - 2 / (x : ℝ)
  have hX : ∀ x ∈ X, 5 ≤ x := by
    intro x hx
    unfold X primes5Below at hx
    rw [Finset.mem_filter, mem_primesBelow] at hx
    exact two_le_of_ne3 hx.1.1 hx.2 hx.1.2.1
  have hY : ∀ x ∈ Y, 5 ≤ x := by
    intro x hx
    rw [List.mem_toFinset] at hx
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hx
    exact h5 q hq
  have hXY : ∀ x ∈ X ∪ Y, 0 ≤ g x ∧ g x ≤ 1 := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · exact g_mem (hX x h)
    · exact g_mem (hY x h)
  have hsub : primes5Below (B : ℝ) ⊆ X ∪ Y := by
    intro p hp
    have hp' := hp
    unfold primes5Below at hp
    rw [Finset.mem_filter, mem_primesBelow] at hp
    obtain ⟨⟨hpr, hp3, hpB⟩, hp2⟩ := hp
    have hpB' : p < B := by exact_mod_cast hpB
    rcases Nat.lt_or_ge p A with h | h
    · apply Finset.mem_union_left
      unfold X primes5Below
      rw [Finset.mem_filter, mem_primesBelow]
      exact ⟨⟨hpr, hp3, by exact_mod_cast h⟩, hp2⟩
    · apply Finset.mem_union_right
      rw [List.mem_toFinset]
      exact hcov p hpr (two_le_of_ne3 hpr hp2 hp3) h hpB'
  have h1 : ∏ x ∈ X ∪ Y, g x ≤ P5 B := prod_ge_of_subset_le_one hsub g hXY
  have h2 : (∏ x ∈ X, g x) * ∏ x ∈ Y, g x ≤ ∏ x ∈ X ∪ Y, g x := by
    have e := Finset.prod_union_inter (s₁ := X) (s₂ := Y) (f := g)
    have hi : ∏ x ∈ X ∩ Y, g x ≤ 1 := prod_le_one₀
      (fun x hx => (hXY x (Finset.mem_union_left _ (Finset.mem_inter.mp hx).1)).1)
      (fun x hx => (hXY x (Finset.mem_union_left _ (Finset.mem_inter.mp hx).1)).2)
    have h0 : 0 ≤ ∏ x ∈ X ∪ Y, g x := prod_nonneg (fun x hx => (hXY x hx).1)
    nlinarith
  have h3 : ((l.map Prod.fst).map g).prod ≤ ∏ x ∈ Y, g x :=
    le_prod_toFinset _ _ (fun x hx => g_mem (hY x (List.mem_toFinset.mpr hx)))
  have h4 : ((l.map Prod.fst).map g).prod =
      (((l.map (fun q => q.1 - 2)).prod : ℕ) : ℝ) / (((l.map Prod.fst).prod : ℕ) : ℝ) := by
    rw [List.map_map, ← list_prod_div l (fun q => q.1 - 2) Prod.fst]
    congr 1
    apply List.map_congr_left
    intro q hq
    have h5q := h5 q hq
    simp only [Function.comp, g]
    have hq0 : (q.1 : ℝ) ≠ 0 := by
      have : (5 : ℝ) ≤ q.1 := by exact_mod_cast h5q
      linarith
    rw [Nat.cast_sub (by omega)]
    field_simp
    push_cast; ring
  have hX0 : 0 ≤ ∏ x ∈ X, g x := prod_nonneg (fun x hx => (g_mem (hX x hx)).1)
  have : P5 A = ∏ x ∈ X, g x := rfl
  rw [mul_div_assoc, ← h4, this]
  calc (∏ x ∈ X, g x) * ((l.map Prod.fst).map g).prod ≤ (∏ x ∈ X, g x) * ∏ x ∈ Y, g x :=
        mul_le_mul_of_nonneg_left h3 hX0
    _ ≤ _ := h2
    _ ≤ _ := h1

/-- **Error step, PROVED**: `PE B ≤ PE A · ∏ (ℓ + 8D)/ℓ` when the list covers the primes
`p ≠ 3` of `[A, B)` and every pair has `ℓ/D ≤ p^{a/b}`. -/
theorem err_step {A B a b : ℕ} (hb : 0 < b) (l : List (ℕ × ℕ)) (hval : validL l 1000 a b = true)
    (hcov : ∀ p, p.Prime → p ≠ 3 → A ≤ p → p < B → p ∈ l.map Prod.fst) :
    PE a b B ≤ PE a b A * (((l.map (fun q => q.2 + 8 * 1000)).prod : ℕ) : ℝ) /
      (((l.map Prod.snd).prod : ℕ) : ℝ) := by
  set δ : ℝ := (a : ℝ) / b
  set X := primesBelow (A : ℝ)
  set Y := (l.map Prod.fst).toFinset
  set f : ℕ → ℝ := fun x => 1 + 8 / (x : ℝ) ^ δ
  simp only [validL, List.all_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hval
  have hD' : (0 : ℝ) < (1000 : ℕ) := by norm_num
  have hsub : primesBelow (B : ℝ) ⊆ X ∪ Y := by
    intro p hp
    rw [mem_primesBelow] at hp
    obtain ⟨hpr, hp3, hpB⟩ := hp
    have hpB' : p < B := by exact_mod_cast hpB
    rcases Nat.lt_or_ge p A with h | h
    · apply Finset.mem_union_left
      rw [mem_primesBelow]
      exact ⟨hpr, hp3, by exact_mod_cast h⟩
    · apply Finset.mem_union_right
      rw [List.mem_toFinset]
      exact hcov p hpr hp3 h hpB'
  have h1 : PE a b B ≤ ∏ x ∈ X ∪ Y, f x := prod_le_of_subset_one hsub f (fun x _ => f_ge δ x)
  have h2 : ∏ x ∈ X ∪ Y, f x ≤ (∏ x ∈ X, f x) * ∏ x ∈ Y, f x := by
    have e := Finset.prod_union_inter (s₁ := X) (s₂ := Y) (f := f)
    have hi : 1 ≤ ∏ x ∈ X ∩ Y, f x := one_le_prod₀ (fun x _ => f_ge δ x)
    have h0 : 0 ≤ ∏ x ∈ X ∪ Y, f x := prod_nonneg (fun x _ => by linarith [f_ge δ x])
    nlinarith
  have h3 : ∏ x ∈ Y, f x ≤ ((l.map Prod.fst).map f).prod :=
    prod_toFinset_le _ _ (fun x _ => f_ge δ x)
  have h4 : ((l.map Prod.fst).map f).prod ≤
      (((l.map (fun q => q.2 + 8 * 1000)).prod : ℕ) : ℝ) / (((l.map Prod.snd).prod : ℕ) : ℝ) := by
    rw [List.map_map, ← list_prod_div l (fun q => q.2 + 8 * 1000) Prod.snd]
    apply list_prod_le
    intro q hq
    obtain ⟨hq1, hq2⟩ := hval q hq
    have hpos : (0 : ℝ) < (q.2 : ℝ) / (1000 : ℕ) := by
      have : (0 : ℝ) < q.2 := by exact_mod_cast hq1
      positivity
    have hle : (q.2 : ℝ) / (1000 : ℕ) ≤ (q.1 : ℝ) ^ δ := le_rpow_of_pow hb (by norm_num) hq2
    refine ⟨by simp only [Function.comp]; linarith [f_ge δ q.1], ?_⟩
    simp only [Function.comp, f]
    have : 8 / (q.1 : ℝ) ^ δ ≤ 8 / ((q.2 : ℝ) / (1000 : ℕ)) :=
      div_le_div_of_nonneg_left (by norm_num) hpos hle
    have hq2' : (q.2 : ℝ) ≠ 0 := by have : (0 : ℝ) < q.2 := by exact_mod_cast hq1
                                    exact this.ne'
    have e : ((q.2 + 8 * 1000 : ℕ) : ℝ) / (q.2 : ℝ) = 1 + 8 / ((q.2 : ℝ) / (1000 : ℕ)) := by
      push_cast; field_simp; ring
    rw [e]; linarith
  have hX0 : 0 ≤ ∏ x ∈ X, f x := prod_nonneg (fun x _ => by linarith [f_ge δ x])
  have : PE a b A = ∏ x ∈ X, f x := rfl
  rw [mul_div_assoc, this]
  calc PE a b B ≤ _ := h1
    _ ≤ _ := h2
    _ ≤ _ := mul_le_mul_of_nonneg_left (le_trans h3 h4) hX0

/-- **Chain step, PROVED.** -/
theorem good_step {a b A B m e m' e' : ℕ} (hb : 0 < b) (h : Good a b A m e)
    (lm le : List (ℕ × ℕ)) (h5 : ∀ q ∈ lm, 5 ≤ q.1) (hval : validL le 1000 a b = true)
    (hcm : ∀ p, p.Prime → 5 ≤ p → A ≤ p → p < B → p ∈ lm.map Prod.fst)
    (hce : ∀ p, p.Prime → p ≠ 3 → A ≤ p → p < B → p ∈ le.map Prod.fst)
    (hm : m' * (lm.map Prod.fst).prod ≤ m * (lm.map (fun q => q.1 - 2)).prod)
    (he : e * (le.map (fun q => q.2 + 8 * 1000)).prod ≤ e' * (le.map Prod.snd).prod) :
    Good a b B m' e' := by
  obtain ⟨hP, hE⟩ := h
  have hR : (0 : ℝ) < R := by unfold R; positivity
  set NP := (lm.map (fun q => q.1 - 2)).prod
  set DP := (lm.map Prod.fst).prod
  set NE := (le.map (fun q => q.2 + 8 * 1000)).prod
  set DE := (le.map Prod.snd).prod
  have hDP : 0 < DP := list_prod_pos _ _ (fun q hq => by have := h5 q hq; omega)
  have hDE : 0 < DE := by
    simp only [validL, List.all_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hval
    exact list_prod_pos _ _ (fun q hq => (hval q hq).1)
  have hDPr : (0 : ℝ) < DP := by exact_mod_cast hDP
  have hDEr : (0 : ℝ) < DE := by exact_mod_cast hDE
  have hms := main_step lm h5 hcm
  have hes := err_step hb le hval hce
  constructor
  · have hmR : ((m' * DP : ℕ) : ℝ) ≤ ((m * NP : ℕ) : ℝ) := by exact_mod_cast hm
    push_cast at hmR
    have hNP0 : (0 : ℝ) ≤ NP := Nat.cast_nonneg _
    have k0 : (m' : ℝ) ≤ (m : ℝ) * NP / DP := by
      rw [le_div_iff₀ hDPr]; linarith
    have k1 : (m' : ℝ) / R ≤ (m : ℝ) / R * NP / DP := by
      have : (m : ℝ) / R * NP / DP = ((m : ℝ) * NP / DP) / R := by ring
      rw [this]; exact div_le_div_of_nonneg_right k0 hR.le
    have k2 : (m : ℝ) / R * NP / DP ≤ P5 A * NP / DP := by
      apply div_le_div_of_nonneg_right _ hDPr.le
      exact mul_le_mul_of_nonneg_right hP hNP0
    linarith
  · have heR : ((e * NE : ℕ) : ℝ) ≤ ((e' * DE : ℕ) : ℝ) := by exact_mod_cast he
    push_cast at heR
    have hNE0 : (0 : ℝ) ≤ NE := Nat.cast_nonneg _
    have k2 : PE a b A * NE / DE ≤ (e : ℝ) / R * NE / DE := by
      apply div_le_div_of_nonneg_right _ hDEr.le
      exact mul_le_mul_of_nonneg_right hE hNE0
    have k0 : (e : ℝ) * NE / DE ≤ (e' : ℝ) := by
      rw [div_le_iff₀ hDEr]; linarith
    have k1 : (e : ℝ) / R * NE / DE ≤ (e' : ℝ) / R := by
      have : (e : ℝ) / R * NE / DE = ((e : ℝ) * NE / DE) / R := by ring
      rw [this]; exact div_le_div_of_nonneg_right k0 hR.le
    linarith

/-- The kernel check of one block. -/
def blockCheck (l : List (ℕ × ℕ)) (a b m e m' e' : ℕ) : Bool :=
  decide (0 < b) && validL l 1000 a b && l.all (fun q => decide (5 ≤ q.1)) &&
  decide (m' * (l.map Prod.fst).prod ≤ m * (l.map (fun q => q.1 - 2)).prod) &&
  decide (e * (l.map (fun q => q.2 + 8 * 1000)).prod ≤ e' * (l.map Prod.snd).prod)

/-- **One block of the chain, PROVED**: from `Good` at `A`, a passing `blockCheck` and a
passing `cov` on `[A, B)` give `Good` at `B`. -/
theorem good_step_block {a b A B m e m' e' : ℕ} {l : List (ℕ × ℕ)} (h : Good a b A m e)
    (hAB : A ≤ B) (hc : blockCheck l a b m e m' e' = true)
    (hcov : cov A (B - A) (l.map Prod.fst) = true) : Good a b B m' e' := by
  simp only [blockCheck, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hc
  obtain ⟨⟨⟨⟨hb, hval⟩, h5⟩, hm⟩, he⟩ := hc
  have hc' := cov_sound _ _ _ hcov
  exact good_step hb h l l h5 hval (fun p hp _ h1 h2 => hc' p hp h1 (by omega))
    (fun p hp _ h1 h2 => hc' p hp h1 (by omega)) hm he

lemma good_zero (a b : ℕ) : Good a b 0 R R := by
  have hR : (R : ℝ) ≠ 0 := by unfold R; positivity
  have hP : P5 0 = 1 := by
    unfold P5
    refine prod_eq_one (fun p hp => ?_)
    unfold primes5Below at hp
    rw [Finset.mem_filter, mem_primesBelow] at hp
    have := hp.1.2.2
    push_cast at this
    exact absurd this (not_lt.mpr (Nat.cast_nonneg p))
  have hE : PE a b 0 = 1 := by
    unfold PE
    refine prod_eq_one (fun p hp => ?_)
    rw [mem_primesBelow] at hp
    have := hp.2.2
    push_cast at this
    exact absurd this (not_lt.mpr (Nat.cast_nonneg p))
  refine ⟨?_, ?_⟩
  · rw [hP, div_self hR]
  · rw [hE, div_self hR]

lemma validL_filter (L : List (ℕ × ℕ)) (D a b : ℕ) (p : ℕ × ℕ → Bool)
    (h : validL L D a b = true) : validL (L.filter p) D a b = true := by
  simp only [validL, List.all_eq_true] at h ⊢
  intro q hq
  exact h q (List.mem_filter.mp hq).1

/-- The kernel check of the base step, all primes below 29921 from `L_17_20`. -/
def baseCheck (m0 e0 : ℕ) : Bool :=
  decide (m0 * ((mainL L_17_20 29921).map Prod.fst).prod ≤
    R * ((mainL L_17_20 29921).map (fun q => q.1 - 2)).prod) &&
  decide (R * ((errL L_17_20 29921).map (fun q => q.2 + 8 * 1000)).prod ≤
    e0 * ((errL L_17_20 29921).map Prod.snd).prod)

/-- **Base of the chain, PROVED**, from the existing kernel checked list `L_17_20`. -/
theorem good_base_of {m0 e0 : ℕ} (hc : baseCheck m0 e0 = true) : Good 17 20 29921 m0 e0 := by
  simp only [baseCheck, Bool.and_eq_true, decide_eq_true_eq] at hc
  refine good_step (by norm_num) (good_zero 17 20) (mainL L_17_20 29921) (errL L_17_20 29921)
    (fun q hq => (mem_mainL.mp hq).2.2) (validL_filter _ _ _ _ _ L_17_20_valid) ?_ ?_ hc.1 hc.2
  · intro p hp h5 _ hpB
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (L_17_20_comp p hp hpB)
    exact List.mem_map.mpr ⟨q, mem_mainL.mpr ⟨hq, hpB, h5⟩, rfl⟩
  · intro p hp h3 _ hpB
    obtain ⟨q, hq, rfl⟩ := List.mem_map.mp (L_17_20_comp p hp hpB)
    exact List.mem_map.mpr ⟨q, mem_errL.mpr ⟨hq, hpB, h3⟩, rfl⟩

/-- The kernel check of one row: `M ≤ u^{16.5}`, `v^{14.8 a/b} ≤ T` and
`19/3 · T · e/R < (M - 1)/6 · m/R · 0.042`. -/
def rowCheck2 (a b u v M T m e : ℕ) : Bool :=
  decide (0 < b) && decide (1 ≤ M) && decide (M * M ≤ u ^ 33) &&
  decide (v ^ (74 * a) ≤ T ^ (5 * b)) && decide (114000 * T * e < 126 * (M - 1) * m)

/-- **Row criterion, PROVED**: `Good` at `v` and a passing `rowCheck2` give `S2 > 0`. -/
theorem S2_pos_of_good {a b u v m e : ℕ} (h : Good a b v m e) (M T : ℕ)
    (hc : rowCheck2 a b u v M T m e = true) : 0 < S2 u v 14.8 ((a : ℕ) / (b : ℕ)) := by
  simp only [rowCheck2, Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨⟨⟨⟨hb, hM1⟩, hMu⟩, hvT⟩, hmain⟩ := hc
  obtain ⟨hMain, hErr⟩ := h
  set δ : ℝ := (a : ℝ) / b with hδ
