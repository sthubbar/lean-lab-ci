/-! ### Abel sums by structural recursion -/

/-- `Σ_{i<n} U (i+1) (F i - F (i+1))` by recursion, for kernel evaluation. -/
def abelR (F U : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n + 1 => abelR F U n + U (n + 1) * (F n - F (n + 1))

theorem abelN_eq (F U : ℕ → ℕ) (n : ℕ) : abelN F U n = F n * U n + abelR F U n := by
  unfold abelN
