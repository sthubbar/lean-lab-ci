/-- Every prime below 29921 is in `PL`. -/
theorem PL_complete : ∀ p, p.Prime → p < 29921 → p ∈ PL := by
  intro p hp hpV
  rcases Nat.lt_or_ge p 2500 with h | h0
  · exact PL_blk0 p hp (by omega) h
  rcases Nat.lt_or_ge p 5000 with h | h1
  · exact PL_blk1 p hp (by omega) h
  rcases Nat.lt_or_ge p 7500 with h | h2
  · exact PL_blk2 p hp (by omega) h
  rcases Nat.lt_or_ge p 10000 with h | h3
  · exact PL_blk3 p hp (by omega) h
  rcases Nat.lt_or_ge p 12500 with h | h4
  · exact PL_blk4 p hp (by omega) h
  rcases Nat.lt_or_ge p 15000 with h | h5
  · exact PL_blk5 p hp (by omega) h
  rcases Nat.lt_or_ge p 17500 with h | h6
  · exact PL_blk6 p hp (by omega) h
  rcases Nat.lt_or_ge p 20000 with h | h7
  · exact PL_blk7 p hp (by omega) h
  rcases Nat.lt_or_ge p 22500 with h | h8
  · exact PL_blk8 p hp (by omega) h
  rcases Nat.lt_or_ge p 25000 with h | h9
  · exact PL_blk9 p hp (by omega) h
  rcases Nat.lt_or_ge p 27500 with h | h10
  · exact PL_blk10 p hp (by omega) h
  exact PL_blk11 p hp (by omega) hpV

