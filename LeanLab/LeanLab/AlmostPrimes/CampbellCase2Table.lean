/-! ### Theorem 1.2 with the remaining table only -/

/-- Cited, the part of `Case2Table` this file does not prove: the script's partition for
`Z < z = N^{1/16.5} < 10^8`. -/
def Case2TableAbove (Z : ℝ) : Prop :=
  ∀ N : ℕ, N0 < N → N < N1 → Z < zOf N → ∃ u v δ : ℝ, 1 ≤ u ∧ u < zOf N ∧ zOf N ≤ v ∧
    0 < δ ∧ δ < 1 ∧ 0 < S2 u v 14.8 δ

/-- **`Case2Table` from its part above 29921, PROVED by `table_upto29921`.** -/
theorem case2Table_of_above (h : Case2TableAbove 29921) : Case2Table := by
  intro N h0 h1
  rcases le_or_gt (zOf N) 29921 with hz | hz
  · exact table_upto29921 N h0 hz
  · exact h N h0 h1 hz

/-- **Theorem 1.2, Ω(ab) ≤ 33 for every N ≥ 2, CONDITIONAL ON `GapTable`, `Case2Sieve`,
`Case2TableAbove 29921` and `Case3Sieve`.** -/
theorem theorem1_2_of_inputs_above (hG : GapTable) (hs : Case2Sieve)
    (ht : Case2TableAbove 29921) (h3 : Case3Sieve) : ∀ N : ℕ, 2 ≤ N → TwoAlmostPrimes 33 N :=
  theorem1_2_of_inputs hG hs (case2Table_of_above ht) h3

end LeanLab.AlmostPrimes.CampbellCase2Table
