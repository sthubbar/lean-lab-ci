/-- One certificate gives the `Case2Table` conclusion for `z` in its interval. -/
lemma key (N u v a b : ℕ) (hu : 1 ≤ u) (ha : 0 < a) (hab : a < b) (h1 : (u : ℝ) < zOf N)
    (h2 : zOf N ≤ (v : ℝ)) (h3 : 0 < S2 u v 14.8 ((a : ℕ) / (b : ℕ))) :
    ∃ u v δ : ℝ, 1 ≤ u ∧ u < zOf N ∧ zOf N ≤ v ∧ 0 < δ ∧ δ < 1 ∧ 0 < S2 u v 14.8 δ := by
  refine ⟨u, v, (a : ℝ) / b, by exact_mod_cast hu, h1, h2,
    div_pos (by exact_mod_cast ha) (by exact_mod_cast (by omega : 0 < b)), ?_, h3⟩
  rw [div_lt_one (by exact_mod_cast (by omega : 0 < b))]
  exact_mod_cast hab

