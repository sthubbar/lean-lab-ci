/-! ### Trial division -/

/-- `tdiv n f d` is true when some `d' ≥ d` with `d'^2 ≤ n` divides `n`, `f` steps of fuel. -/
def tdiv (n : ℕ) : ℕ → ℕ → Bool
  | 0, _ => false
  | f + 1, d => if n < d * d then false else if n % d = 0 then true else tdiv n f (d + 1)

/-- Trial division primality test. Only `isP_of_prime` is used, never its converse. -/
def isP (n : ℕ) : Bool := decide (2 ≤ n) && !(tdiv n n 2)

lemma tdiv_prime {p : ℕ} (hp : p.Prime) : ∀ f d, 2 ≤ d → tdiv p f d = false := by
  intro f
  induction f with
  | zero => intro d _; rfl
  | succ f ih =>
    intro d hd
    unfold tdiv
    by_cases h1 : p < d * d
    · simp [h1]
    · by_cases h2 : p % d = 0
      · exfalso
        have hdvd : d ∣ p := Nat.dvd_of_mod_eq_zero h2
        rcases hp.eq_one_or_self_of_dvd d hdvd with h | h
        · omega
        · subst h
          have : d < d * d := by nlinarith [hp.two_le]
          exact h1 this
      · simp [h1, h2, ih (d + 1) (by omega)]

lemma isP_of_prime {p : ℕ} (hp : p.Prime) : isP p = true := by
  unfold isP
  rw [tdiv_prime hp p 2 le_rfl]
  simp [hp.two_le]

/-! ### Products over lists and finsets -/

lemma prod_toFinset_le (l : List ℕ) (g : ℕ → ℝ) (hg : ∀ x ∈ l, 1 ≤ g x) :
    ∏ x ∈ l.toFinset, g x ≤ (l.map g).prod := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ih' := ih (fun x hx => hg x (List.mem_cons_of_mem a hx))
    have ha : 1 ≤ g a := hg a (by simp)
    have h0 : 0 ≤ ∏ x ∈ l.toFinset, g x := prod_nonneg (fun x hx => by
      have := hg x (List.mem_cons_of_mem a (List.mem_toFinset.mp hx)); linarith)
    rw [List.toFinset_cons, List.map_cons, List.prod_cons]
    by_cases hm : a ∈ l.toFinset
    · rw [insert_eq_of_mem hm]; nlinarith
    · rw [prod_insert hm]; nlinarith

lemma le_prod_toFinset (l : List ℕ) (g : ℕ → ℝ) (hg : ∀ x ∈ l, 0 ≤ g x ∧ g x ≤ 1) :
    (l.map g).prod ≤ ∏ x ∈ l.toFinset, g x := by
  induction l with
  | nil => simp
  | cons a l ih =>
    have ih' := ih (fun x hx => hg x (List.mem_cons_of_mem a hx))
    have ha := hg a (by simp)
    have h0 : 0 ≤ (l.map g).prod := List.prod_nonneg (by
      intro y hy
      obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hy
      exact (hg x (List.mem_cons_of_mem a hx)).1)
    rw [List.toFinset_cons, List.map_cons, List.prod_cons]
    by_cases hm : a ∈ l.toFinset
    · rw [insert_eq_of_mem hm]; nlinarith
    · rw [prod_insert hm]
      exact mul_le_mul_of_nonneg_left ih' ha.1

lemma prod_le_of_subset_one {A B : Finset ℕ} (h : A ⊆ B) (g : ℕ → ℝ)
    (hg : ∀ x ∈ B, 1 ≤ g x) : ∏ x ∈ A, g x ≤ ∏ x ∈ B, g x := by
  rw [← prod_sdiff h]
  have h1 : ∏ x ∈ B \ A, (1 : ℝ) ≤ ∏ x ∈ B \ A, g x :=
    prod_le_prod₀ (fun _ _ => zero_le_one) (fun x hx => hg x (mem_sdiff.mp hx).1)
  rw [prod_const_one] at h1
  have h0 : 0 ≤ ∏ x ∈ A, g x := prod_nonneg (fun x hx => by linarith [hg x (h hx)])
  nlinarith

lemma prod_ge_of_subset_le_one {A B : Finset ℕ} (h : A ⊆ B) (g : ℕ → ℝ)
    (hg : ∀ x ∈ B, 0 ≤ g x ∧ g x ≤ 1) : ∏ x ∈ B, g x ≤ ∏ x ∈ A, g x := by
  rw [← prod_sdiff h]
  have h1 : ∏ x ∈ B \ A, g x ≤ 1 :=
    prod_le_one₀ (fun x hx => (hg x (mem_sdiff.mp hx).1).1)
      (fun x hx => (hg x (mem_sdiff.mp hx).1).2)
  have h0 : 0 ≤ ∏ x ∈ A, g x := prod_nonneg (fun x hx => (hg x (h hx)).1)
  nlinarith

lemma list_prod_le (l : List (ℕ × ℕ)) (f g : ℕ × ℕ → ℝ) (h : ∀ q ∈ l, 0 ≤ f q ∧ f q ≤ g q) :
    (l.map f).prod ≤ (l.map g).prod := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.prod_cons]
    have ha := h a (by simp)
    have ih' := ih (fun q hq => h q (List.mem_cons_of_mem a hq))
    have h0 : 0 ≤ (l.map f).prod := List.prod_nonneg (by
      intro y hy
      obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hy
      exact (h q (List.mem_cons_of_mem a hq)).1)
    exact mul_le_mul ha.2 ih' h0 (le_trans ha.1 ha.2)

lemma list_prod_div (l : List (ℕ × ℕ)) (A B : ℕ × ℕ → ℕ) :
    (l.map (fun q => (A q : ℝ) / B q)).prod = ((l.map A).prod : ℝ) / ((l.map B).prod : ℝ) := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.prod_cons, Nat.cast_mul, ih, div_mul_div_comm]

lemma list_prod_pos (l : List (ℕ × ℕ)) (A : ℕ × ℕ → ℕ) (h : ∀ q ∈ l, 0 < A q) :
    0 < (l.map A).prod := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.prod_cons]
    exact Nat.mul_pos (h a (by simp)) (ih (fun q hq => h q (List.mem_cons_of_mem a hq)))

/-! ### Real powers from integer powers -/

lemma rpow_le_of_pow {v T m n : ℕ} (hn : 0 < n) (h : v ^ m ≤ T ^ n) :
    (v : ℝ) ^ ((m : ℝ) / n) ≤ T := by
  have hx : 0 ≤ (v : ℝ) ^ ((m : ℝ) / n) := rpow_nonneg (Nat.cast_nonneg v) _
  have hn' : n ≠ 0 := by omega
  rw [← pow_le_pow_iff_left₀ hx (Nat.cast_nonneg T) hn', ← rpow_natCast, ← rpow_mul
    (Nat.cast_nonneg v), div_mul_cancel₀ _ (by exact_mod_cast hn'), rpow_natCast]
  exact_mod_cast h

lemma le_rpow_of_pow {l p D a b : ℕ} (hb : 0 < b) (hD : 0 < D) (h : l ^ b ≤ p ^ a * D ^ b) :
    (l : ℝ) / D ≤ (p : ℝ) ^ ((a : ℝ) / b) := by
  have hx : 0 ≤ (p : ℝ) ^ ((a : ℝ) / b) := rpow_nonneg (Nat.cast_nonneg p) _
  have hb' : b ≠ 0 := by omega
  have hD' : (0 : ℝ) < D := by exact_mod_cast hD
  rw [← pow_le_pow_iff_left₀ (by positivity) hx hb', ← rpow_natCast ((p : ℝ) ^ _),
    ← rpow_mul (Nat.cast_nonneg p), div_mul_cancel₀ _ (by exact_mod_cast hb'), rpow_natCast,
    div_pow, div_le_iff₀ (by positivity)]
  exact_mod_cast h

/-! ### The certificate criterion -/

/-- Pairs of `L` that enter the error product: `p < v`, `p ≠ 3`. -/
def errL (L : List (ℕ × ℕ)) (v : ℕ) : List (ℕ × ℕ) :=
  L.filter (fun q => decide (q.1 < v) && decide (q.1 ≠ 3))

/-- Pairs of `L` that enter the main product: `5 ≤ p < v`. -/
def mainL (L : List (ℕ × ℕ)) (v : ℕ) : List (ℕ × ℕ) :=
  L.filter (fun q => decide (q.1 < v) && decide (5 ≤ q.1))

/-- Every pair `(p, ℓ)` has `0 < ℓ` and `ℓ^b ≤ p^a D^b`, so `ℓ/D ≤ p^{a/b}`. -/
def validL (L : List (ℕ × ℕ)) (D a b : ℕ) : Bool :=
  L.all (fun q => decide (0 < q.2) && decide (q.2 ^ b ≤ q.1 ^ a * D ^ b))

/-- The row check: `M ≤ u^{16.5}`, `v^{14.8 a/b} ≤ T` and the cross multiplied inequality
`19/3 · T · ∏ (ℓ + 8D)/ℓ < (M - 1)/6 · ∏_{5 ≤ p < v} (p - 2)/p · 0.042`. -/
def rowCheck (L : List (ℕ × ℕ)) (D a b u v M T : ℕ) : Bool :=
  decide (1 ≤ M) && decide (M * M ≤ u ^ 33) && decide (v ^ (74 * a) ≤ T ^ (5 * b)) &&
  decide (19 * 6 * 1000 * T * ((errL L v).map (fun q => q.2 + 8 * D)).prod *
      ((mainL L v).map Prod.fst).prod <
    3 * 42 * (M - 1) * ((mainL L v).map (fun q => q.1 - 2)).prod *
      ((errL L v).map Prod.snd).prod)

lemma mem_errL {L : List (ℕ × ℕ)} {v : ℕ} {q : ℕ × ℕ} :
    q ∈ errL L v ↔ q ∈ L ∧ q.1 < v ∧ q.1 ≠ 3 := by
  simp [errL, List.mem_filter]

lemma mem_mainL {L : List (ℕ × ℕ)} {v : ℕ} {q : ℕ × ℕ} :
    q ∈ mainL L v ↔ q ∈ L ∧ q.1 < v ∧ 5 ≤ q.1 := by
  simp [mainL, List.mem_filter]

