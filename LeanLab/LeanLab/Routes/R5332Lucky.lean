/-- Lucky Goldbach for every even 2N in [2, 2000], kernel checked. -/
theorem lucky_goldbach_2000 (N : ℕ) (h1 : 1 ≤ N) (h2 : N ≤ 1000) :
    ∃ a ∈ luckyList 2000, 2 * N - a ∈ luckyList 2000 := by
  have hN : N ∈ cert2000.map Prod.fst := by
    rw [cert2000_fst, List.mem_range'_1]; omega
  obtain ⟨pr, hpr, rfl⟩ := List.mem_map.mp hN
  rw [luckyList_2000]
  exact ⟨pr.2, (cert2000_ok pr hpr).1, (cert2000_ok pr hpr).2⟩

end LeanLab.Routes.R5332

