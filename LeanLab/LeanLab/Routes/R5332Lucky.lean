/-
R-5332, CLOUD MANUAL-M3, unit U-7002, T3 MOONSHOT.
AI wrote this Lean code. Not progress on binary Goldbach, which is OPEN.

The lucky numbers route.  Gardiner, Lazarus, Metropolis and Ulam 1956: from the odd
numbers, at step j remove every L-th survivor, L the survivor at index j.  The lucky
numbers have prime density, ℓₙ ∼ n log n by Hawkins and Briggs 1957, and no
multiplicative structure, so Selberg's parity barrier has no formulation for them;
yet lucky Goldbach is as open as Goldbach.
* `dropEvery`, `luckyAux`, `luckyList B`: the positional sieve on the odd numbers up
  to B.  A positional deletion of a prefix is the prefix of the deletion, so
  `luckyList B` lists the lucky numbers up to B; that remark is the definition's
  justification, not a theorem here.
* `mem_dropEvery`, `mem_luckyAux`: every step only deletes.
* `dropEvery_three_mod`: on the odd numbers, deleting every third leaves only
  n ≢ 2 mod 3.
* `lucky_mod_three`: for every B, every member of `luckyList B` is ≢ 2 mod 3, the
  exact local obstruction that makes the lucky singular series at 3 the mirror of
  the primes'.
* `lucky_rep_mod_three`: so N ≡ 2 mod 3 is a sum of two lucky numbers only as 1 + 1 mod 3.
* `luckyList_100`, `lucky_goldbach_200`: the list to 100, and lucky Goldbach for every
  even N in [2, 200], by `decide`.
* `luckyList_2000`, `cert2000_ok`, `cert2000_fst`, `lucky_goldbach_2000`: the 276 lucky
  numbers to 2000 by `decide +kernel`, and lucky Goldbach for every even 2N in [2, 2000]
  from one witness per N; numerics/r5332_lucky.py checks it to 10⁶.
-/
import Mathlib

namespace LeanLab.Routes.R5332

/-- Delete every k-th element of a list, the counter c counting elements kept since
the last deletion. -/
def dropEvery (k : ℕ) : ℕ → List ℕ → List ℕ
  | _, [] => []
  | c, x :: xs => if c + 1 = k then dropEvery k 0 xs else x :: dropEvery k (c + 1) xs

/-- The lucky sieve with fuel f, sieving with the element at index j. -/
def luckyAux : ℕ → ℕ → List ℕ → List ℕ
  | 0, _, l => l
  | f + 1, j, l =>
    match l[j]? with
    | none => l
    | some L => if L ≤ 1 then l else luckyAux f (j + 1) (dropEvery L 0 l)

/-- The odd numbers up to B. -/
def odds (B : ℕ) : List ℕ := (List.range' 0 ((B + 1) / 2)).map (fun i => 2 * i + 1)

/-- The lucky numbers up to B. -/
def luckyList (B : ℕ) : List ℕ := luckyAux B 1 (odds B)

theorem mem_dropEvery {k c : ℕ} {l : List ℕ} {x : ℕ} (h : x ∈ dropEvery k c l) : x ∈ l := by
  induction l generalizing c with
  | nil => simp [dropEvery] at h
  | cons y ys ih =>
    simp only [dropEvery] at h
    split_ifs at h with hc
    · exact List.mem_cons_of_mem _ (ih h)
    · rcases List.mem_cons.mp h with h | h
      · exact h ▸ List.mem_cons_self
      · exact List.mem_cons_of_mem _ (ih h)

theorem mem_luckyAux {f j : ℕ} {l : List ℕ} {x : ℕ} (h : x ∈ luckyAux f j l) : x ∈ l := by
  induction f generalizing j l with
  | zero => simpa [luckyAux] using h
  | succ f ih =>
    simp only [luckyAux] at h
    split at h
    · exact h
    · split_ifs at h
      · exact h
      · exact mem_dropEvery (ih h)

/-- On the odd numbers 2i + 1, i ≥ s, deleting every third with the counter in phase
leaves only numbers ≢ 2 mod 3. -/
theorem dropEvery_three_mod (n s : ℕ) :
    ∀ x ∈ dropEvery 3 (s % 3) ((List.range' s n).map (fun i => 2 * i + 1)), x % 3 ≠ 2 := by
  induction n generalizing s with
  | zero => simp [dropEvery]
  | succ n ih =>
    intro x hx
    rw [List.range'_succ, List.map_cons] at hx
    simp only [dropEvery] at hx
    split_ifs at hx with hc
    · have h0 : (0 : ℕ) = (s + 1) % 3 := by omega
      rw [h0] at hx
      exact ih (s + 1) x hx
    · rcases List.mem_cons.mp hx with h | h
      · omega
      · have h1 : s % 3 + 1 = (s + 1) % 3 := by omega
        rw [h1] at h
        exact ih (s + 1) x h

/-- Every lucky number up to B is ≢ 2 mod 3, for every B. -/
theorem lucky_mod_three (B : ℕ) : ∀ x ∈ luckyList B, x % 3 ≠ 2 := by
  intro x hx
  unfold luckyList at hx
  rcases Nat.lt_or_ge ((B + 1) / 2) 2 with hm | hm
  · have hx' := mem_luckyAux hx
    simp only [odds, List.mem_map, List.mem_range'_1] at hx'
    obtain ⟨i, hi, rfl⟩ := hx'
    omega
  · obtain ⟨m, hm'⟩ : ∃ m, (B + 1) / 2 = m + 2 := ⟨(B + 1) / 2 - 2, by omega⟩
    cases B with
    | zero => omega
    | succ B =>
      have hodd : odds (B + 1) = (List.range' 0 (m + 2)).map (fun i => 2 * i + 1) := by
        rw [odds, hm']
      have h1 : (odds (B + 1))[1]? = some 3 := by
        rw [hodd]; simp [List.range'_succ]
      simp only [luckyAux, h1] at hx
      simp only [show ¬ (3 ≤ 1) from by decide, ite_false] at hx
      have := mem_luckyAux hx
      rw [hodd] at this
      exact dropEvery_three_mod (m + 2) 0 x this

theorem lucky_rep_mod_three {B a b N : ℕ} (ha : a ∈ luckyList B) (hb : b ∈ luckyList B)
    (hab : a + b = N) (hN : N % 3 = 2) : a % 3 = 1 ∧ b % 3 = 1 := by
  have h1 := lucky_mod_three B a ha
  have h2 := lucky_mod_three B b hb
  omega

theorem luckyList_100 : luckyList 100 =
    [1, 3, 7, 9, 13, 15, 21, 25, 31, 33, 37, 43, 49, 51, 63, 67, 69, 73, 75, 79, 87, 93, 99] := by
  decide

/-- Lucky Goldbach for every even N in [2, 200]. -/
theorem lucky_goldbach_200 :
    ∀ N ∈ List.range 101, 1 ≤ N → ∃ a ∈ luckyList 200, 2 * N - a ∈ luckyList 200 := by
  decide

