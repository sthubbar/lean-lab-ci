/-- One step of the sawtooth: the deficit drops by at most `0.3921` at a counted integer and
never drops at an uncounted one. -/
private theorem dev_step (k : ℕ) :
    0.6079 * (k : ℝ) + 0.68 * √(k : ℝ) - (cP k : ℝ)
      ≤ 0.6079 * ((k + 1 : ℕ) : ℝ) + 0.68 * √((k + 1 : ℕ) : ℝ) - (cP (k + 1) : ℝ)
        + 0.3921 * ((cP (k + 1) : ℝ) - (cP k : ℝ)) := by
  have hk : (((k + 1 : ℕ)) : ℝ) = (k : ℝ) + 1 := by push_cast; ring
  rw [hk]
  have hs : √(k : ℝ) ≤ √((k : ℝ) + 1) := Real.sqrt_le_sqrt (by linarith)
  have hcu : (cP (k + 1) : ℝ) ≤ (cP k : ℝ) + 1 := by
    rw [cP_succ]; split_ifs <;> push_cast <;> linarith
  have hcl : (cP k : ℝ) ≤ (cP (k + 1) : ℝ) := by exact_mod_cast cP_succ_le k
  nlinarith [hs, hcu, hcl]

private theorem dev_lower (a : ℕ) :
    ∀ m : ℕ, a ≤ m →
