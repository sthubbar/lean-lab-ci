/-- The exact polynomial integral fits the reciprocal budget for the smaller tail cap.
Wu 2004 page 26, D2,13 at Table 1 row four page 30. -/
theorem r3Thirteen_polynomial_certificate :
    (∫ x in domain r3ThirteenLo r3ThirteenHi, r3ThirteenPoly x) ≤ ((360523 / 25000000) : ℝ) := by
  have he (x : Fin 3 → ℝ) :
      listEvalN r3ThirteenTerms (fun j => x j - r3ThirteenLo j) = r3ThirteenPoly x := by
    rw [r3ThirteenTerms_eval]
    congr 1
    funext j
    ring
  have h := integral_listEvalBox r3ThirteenTerms (![(25 / 103), (25 / 89), (100 / 291)]) (![(25 / 89), (100 / 291), (2 / 5)])
    (by intro j; fin_cases j <;> norm_num)
  have hlo : (fun j : Fin 3 => ((![(25 / 103), (25 / 89), (100 / 291)] : Fin 3 → ℚ) j : ℝ)) = r3ThirteenLo := by
    ext j; fin_cases j <;> norm_num [r3ThirteenLo]
  have hhi : (fun j : Fin 3 => ((![(25 / 89), (100 / 291), (2 / 5)] : Fin 3 → ℚ) j : ℝ)) = r3ThirteenHi := by
    ext j; fin_cases j <;> norm_num [r3ThirteenHi]
  have hval (j : Fin 3) : ((![(25 / 103), (25 / 89), (100 / 291)] : Fin 3 → ℚ) j : ℝ) = r3ThirteenLo j := congrFun hlo j
  have hvalhi (j : Fin 3) : ((![(25 / 89), (100 / 291), (2 / 5)] : Fin 3 → ℚ) j : ℝ) = r3ThirteenHi j := congrFun hhi j
