/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r2j16_moment : listMomentN r2j16_terms (100 / 287) (5 / 12) = (2165714472688524862929898808528251575864431463187330499089843518337 / 19689600140510902116350095640211800855091372864659105598225678336000000) := by
  decide +kernel

/-- The coefficient list is exactly the centered reciprocal polynomial after translation.
Wu 2004 page 26, derived exact algebraic identity. -/
theorem r2j16_eval (y : Fin 4 → ℝ) :
    listEvalN r2j16_terms y = cellPoly 4 (2 : Fin 4) r2j16_lo r2j16_hi (fun j => (r2j16_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r2j16_terms, cellPoly, r2j16_lo, r2j16_hi, reciprocalUpper,
    sum_range_succ, Fin.prod_univ_succ]
  <;> ring

/-- The reciprocal polynomial has its exact rational integral on the ordered domain.
Wu 2004 page 26, derived polynomial quadrature. -/
theorem r2j16_integral :
    (∫ x in domain (fun j => (r2j16_lo j : ℝ)) (fun j => (r2j16_hi j : ℝ)), cellPoly 4 (2 : Fin 4) r2j16_lo r2j16_hi x) = ((2165714472688524862929898808528251575864431463187330499089843518337 / 19689600140510902116350095640211800855091372864659105598225678336000000) : ℝ) := by
  have h := integral_listEvalN r2j16_terms (a := (100 / 287)) (b := (5 / 12)) (by norm_num)
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 4 → ℝ) : listEvalN r2j16_terms (fun j => x j - (fun _ : Fin 4 => ((100 / 287) : ℝ)) j) = cellPoly 4 (2 : Fin 4) r2j16_lo r2j16_hi x := by
    rw [r2j16_eval]
    congr 1
    funext j
    fin_cases j <;> norm_num [r2j16_lo, Fin.snoc, Fin.cons] <;> ring
  simp only [he] at h
  have hL : (fun _ : Fin 4 => ((100 / 287) : ℝ)) = (fun j => (r2j16_lo j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r2j16_lo, Fin.snoc, Fin.cons]
  have hH : (fun _ : Fin 4 => ((5 / 12) : ℝ)) = (fun j => (r2j16_hi j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r2j16_hi, Fin.snoc, Fin.cons]
  rw [hL, hH] at h
  rw [r2j16_moment] at h
  push_cast at h
  exact h

/-- The original I2 budget holds throughout phi at least seven halves.
Wu 2004 page 26, Table 1 row 3 page 30. -/
theorem r2j16_tail {ω : ℝ → ℝ} (hω : IsBuchstab ω) {φ : ℝ} (hφ : (7 / 2 : ℝ) ≤ φ) :
    buchstabIntegral ω 2 (fun j => (r2j16_lo j : ℝ)) (fun j => (r2j16_hi j : ℝ)) φ ≤ ((42971 / 500000000) : ℝ) := by
  have h := cell_tail_integral hω (n := 2) (by norm_num) 4 r2j16_lo r2j16_hi hφ
    (by intro j; fin_cases j <;> norm_num [r2j16_lo, Fin.snoc, Fin.cons])
    (by intro j; fin_cases j <;> norm_num [r2j16_lo, r2j16_hi])
    (by intro j; fin_cases j <;> norm_num [r2j16_hi, Fin.snoc, Fin.cons])
  change buchstabIntegral ω 2 (fun j => (r2j16_lo j : ℝ)) (fun j => (r2j16_hi j : ℝ)) φ ≤ (5618 / 10000 : ℝ) * (∫ x in domain (fun j => (r2j16_lo j : ℝ)) (fun j => (r2j16_hi j : ℝ)), cellPoly 4 (2 : Fin 4) r2j16_lo r2j16_hi x) at h
  rw [r2j16_integral] at h
  exact h.trans (by norm_num)

