    (∫ x in domain (fun j => (r2j13_lo j : ℝ)) (fun j => (r2j13_hi j : ℝ)), cellPoly 4 (1 : Fin 3) r2j13_lo r2j13_hi x) = ((6273263554346634319907028005467868571 / 225027367594973109861806482441190489600) : ℝ) := by
  have h := integral_listEvalBox r2j13_terms r2j13_lo r2j13_hi (by intro j; fin_cases j <;> norm_num [r2j13_lo, r2j13_hi])
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 3 → ℝ) : listEvalN r2j13_terms (fun j => x j - (fun j : Fin 3 => (r2j13_lo j : ℝ)) j) = cellPoly 4 (1 : Fin 3) r2j13_lo r2j13_hi x := by
