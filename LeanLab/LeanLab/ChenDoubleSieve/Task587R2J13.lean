  simp only [he] at h
  have hD : Set.Icc (fun j : Fin 3 => (r2j13_lo j : ℝ)) (fun j : Fin 3 => (r2j13_hi j : ℝ)) = domain (fun j : Fin 3 => (r2j13_lo j : ℝ)) (fun j : Fin 3 => (r2j13_hi j : ℝ)) := by
