/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r1j9_moment : listMomentN r1j9_terms (50 / 177) (100 / 243) = (19202155203527423659384231508484945125428930237640334726078336591261083 / 734857852517302051208533586300364155535587901309844537088888921462362500) := by
