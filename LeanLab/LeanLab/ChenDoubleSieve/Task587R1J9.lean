    congr 1
    funext j
    fin_cases j <;> norm_num [r1j9_lo, Fin.snoc, Fin.cons] <;> ring
  simp only [he] at h
  have hL : (fun _ : Fin 3 => ((50 / 177) : ℝ)) = (fun j => (r1j9_lo j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r1j9_lo, Fin.snoc, Fin.cons]
  have hH : (fun _ : Fin 3 => ((100 / 243) : ℝ)) = (fun j => (r1j9_hi j : ℝ)) := by
