/-- The coefficient list is exactly the centered reciprocal polynomial after translation.
Wu 2004 page 26, derived exact algebraic identity. -/
theorem r1j9_eval (y : Fin 3 → ℝ) :
    listEvalN r1j9_terms y = cellPoly 6 (1 : Fin 3) r1j9_lo r1j9_hi (fun j => (r1j9_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r1j9_terms, cellPoly, r1j9_lo, r1j9_hi, reciprocalUpper,
    sum_range_succ, Fin.prod_univ_succ]
  <;> ring

/-- The reciprocal polynomial has its exact rational integral on the ordered domain.
Wu 2004 page 26, derived polynomial quadrature. -/
theorem r1j9_integral :
    (∫ x in domain (fun j => (r1j9_lo j : ℝ)) (fun j => (r1j9_hi j : ℝ)), cellPoly 6 (1 : Fin 3) r1j9_lo r1j9_hi x) = ((19202155203527423659384231508484945125428930237640334726078336591261083 / 734857852517302051208533586300364155535587901309844537088888921462362500) : ℝ) := by
  have h := integral_listEvalN r1j9_terms (a := (50 / 177)) (b := (100 / 243)) (by norm_num)
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 3 → ℝ) : listEvalN r1j9_terms (fun j => x j - (fun _ : Fin 3 => ((50 / 177) : ℝ)) j) = cellPoly 6 (1 : Fin 3) r1j9_lo r1j9_hi x := by
