theorem inner_le (t : ℝ) (h0 : 3 ≤ t) (h1 : t ≤ 5) :
    0 ≤ (∫ s in (3:ℝ)..t, Real.log (s - 2) / (s - 1)) ∧
      (∫ s in (3:ℝ)..t, Real.log (s - 2) / (s - 1)) ≤ primL pc 3 t := by
  have hfi : IntervalIntegrable (fun s : ℝ => Real.log (s - 2) / (s - 1)) volume 3 t := by
    apply ContinuousOn.intervalIntegrable
    rw [Set.uIcc_of_le h0]
    apply ContinuousOn.div
    · apply ContinuousOn.log (by fun_prop)
      intro s hs; exact ne_of_gt (by linarith [hs.1])
    · fun_prop
    · intro s hs; exact ne_of_gt (by linarith [hs.1])
  constructor
  · apply intervalIntegral.integral_nonneg h0
    intro s hs
    exact div_nonneg (Real.log_nonneg (by linarith [hs.1])) (by linarith [hs.1])
  · rw [← integral_evalL]
    refine intervalIntegral.integral_mono_on h0 hfi ((evalL_cont pc).intervalIntegrable _ _) ?_
    intro s hs
    exact (f_le s hs.1 (by linarith [hs.2])).trans_eq (p_expand s)

/-- Wu 2004 arXiv 0705.1652 page 39 equation 10.4 and page 42: the part of the index 3 leaf
integral with t from 3 to 5 is at most 15.2679445. -/
theorem high_le :
    4 * (∫ t in (3:ℝ)..5,
      (2 + 2 * ∫ s in (3:ℝ)..max t 3, Real.log (s - 2) / (s - 1)) / t / (1 - t / 6))
      ≤ (152679445 / 10000000 : ℝ) := by
  by_cases hint : IntervalIntegrable (fun t : ℝ =>
      (2 + 2 * ∫ s in (3:ℝ)..max t 3, Real.log (s - 2) / (s - 1)) / t / (1 - t / 6)) volume 3 5
  · have key : (∫ t in (3:ℝ)..5,
        (2 + 2 * ∫ s in (3:ℝ)..max t 3, Real.log (s - 2) / (s - 1)) / t / (1 - t / 6)) ≤
        ∫ t in (3:ℝ)..5, evalL qc t := by
      refine intervalIntegral.integral_mono_on (by norm_num) hint
        ((evalL_cont qc).intervalIntegrable _ _) ?_
      intro t ht
      rw [max_eq_left ht.1]
      obtain ⟨hI0, hI⟩ := inner_le t ht.1 ht.2
      have hw := w_le t ht.1 ht.2
      have hw0 : 0 ≤ 1 / t / (1 - t / 6) := by
        apply div_nonneg (by apply div_nonneg <;> linarith [ht.1]) (by linarith [ht.2])
