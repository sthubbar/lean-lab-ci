theorem inner_le (t : ℝ) (h0 : 3 ≤ t) (h1 : t ≤ 5) :
    0 ≤ (∫ s in (3:ℝ)..t, Real.log (s - 2) / (s - 1)) ∧
      (∫ s in (3:ℝ)..t, Real.log (s - 2) / (s - 1)) ≤ primL pc 3 t := by
  have hfi : IntervalIntegrable (fun s : ℝ => Real.log (s - 2) / (s - 1)) volume 3 t := by
    apply ContinuousOn.intervalIntegrable
    rw [Set.uIcc_of_le h0]
    apply ContinuousOn.div
    · apply ContinuousOn.log (by fun_prop)
      intro s hs; exact ne_of_gt (by linarith [hs.1])
    · fun_prop
    · intro s hs; exact ne_of_gt (by linarith [hs.1])
  constructor
  · apply intervalIntegral.integral_nonneg h0
    intro s hs
    exact div_nonneg (Real.log_nonneg (by linarith [hs.1])) (by linarith [hs.1])
  · rw [← integral_evalL]
    refine intervalIntegral.integral_mono_on h0 hfi ((evalL_cont pc).intervalIntegrable _ _) ?_
    intro s hs
    exact (f_le s hs.1 (by linarith [hs.2])).trans_eq (p_expand s)

