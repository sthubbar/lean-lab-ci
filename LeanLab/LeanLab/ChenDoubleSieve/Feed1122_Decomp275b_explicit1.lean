integral is at most 3.891854. -/
theorem explicit1 :
    4 * (∫ t in (96/29 : ℝ)..5,
      (2 + 2 * ∫ s in (3:ℝ)..t, Real.log (s - 2) / (s - 1)) / t) ≤ (3.891854 : ℝ) := by
  by_cases hint : IntervalIntegrable (fun t : ℝ =>
      (2 + 2 * ∫ s in (3:ℝ)..t, Real.log (s - 2) / (s - 1)) / t) volume (96/29) 5
  · have key : (∫ t in (96/29 : ℝ)..5,
        (2 + 2 * ∫ s in (3:ℝ)..t, Real.log (s - 2) / (s - 1)) / t) ≤
        ∫ t in (96/29 : ℝ)..5, evalL qc t := by
      refine intervalIntegral.integral_mono_on (by norm_num) hint
        ((evalL_cont qc).intervalIntegrable _ _) ?_
      intro t ht
      have h3 : (3:ℝ) ≤ t := by linarith [ht.1]
      obtain ⟨hI0, hI⟩ := inner_le t h3 ht.2
      have hw := w_le t ht.1
      have hw0 : 0 ≤ 1 / t := by apply div_nonneg <;> linarith [ht.1]
      rw [← q_expand, div_eq_mul_one_div]
      exact mul_le_mul (by linarith) hw hw0 (by linarith)
    rw [integral_evalL] at key
    have := value_le
    have h39 : (3.891854 : ℝ) = 3891854 / 1000000 := by norm_num
    rw [h39]
    linarith
  · rw [intervalIntegral.integral_undef hint]
    norm_num

