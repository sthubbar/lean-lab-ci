import Mathlib

/-!
Upper bound for the leaf integral behind index 1 of the Wu 2004 Section 10 display,
Wu 2004 arXiv 0705.1652, page 38 equations 10.2 and 10.3 and page 42.
The leaf statement is `leaf_explicit1` in `Feed1122_Decomp275b_values_explicit.lean`.

Method: with w = s/2 - 2 in the interval from -1/2 to 1/2, log of s - 2 is log 2 plus log of
1 + w, bounded above by a Taylor partial sum of length 25 plus 2 w^26. The reciprocal of
s - 1 = 3 + 2 w is bounded by an alternating geometric sum of length 18 plus a remainder.
The outer weight 1/t equals 58/241 times 1/(1 + u) with u = 58 t/241 - 1 of size at most
49/241, bounded by a geometric sum of length 16. All majorants are polynomials, integrated
exactly. A python check with exact fractions gives 4 times the majorant integral equal to
3.89185397484.., below 3.891854, against a true value 3.8918539726.
AI wrote the Lean code. Binary Goldbach is open.
-/

namespace LeanLab.ChenDoubleSieve.Feed1122Explicit1

open Real Finset MeasureTheory intervalIntegral

/-- Upper bound for log of 1 + w on the interval from -1/2 to 1/2. -/
theorem log_one_add_le (w : ℝ) (h0 : -1/2 ≤ w) (h1 : w ≤ 1/2) :
    log (1 + w) ≤ -(∑ i ∈ range 25, (-w) ^ (i + 1) / ((i : ℝ) + 1)) + 2 * w ^ 26 := by
  have hx : |-w| < 1 := by rw [abs_lt]; constructor <;> linarith
  have h := Real.abs_log_sub_add_sum_range_le hx 25
  have ha : |-w| ≤ 1/2 := by rw [abs_le]; constructor <;> linarith
  have hp : |-w| ^ (25 + 1) = w ^ 26 := by
    rw [abs_neg, pow_abs]; exact abs_of_nonneg (Even.pow_nonneg ⟨13, rfl⟩ w)
  rw [hp] at h
  have hw0 : 0 ≤ w ^ 26 := Even.pow_nonneg ⟨13, rfl⟩ w
  have hr : w ^ 26 / (1 - |-w|) ≤ 2 * w ^ 26 := by
    rw [div_le_iff₀ (by linarith)]; nlinarith
  have := (abs_le.mp h).2
  rw [show (1 - -w) = 1 + w by ring] at this
  linarith

/-- Alternating geometric upper bound for 1/(1 + y), even length. -/
theorem inv_one_add_le (y c : ℝ) (k : ℕ) (hk : Even k) (hc : c < 1) (hy : -c ≤ y) :
    1 / (1 + y) ≤ ∑ j ∈ range k, (-y) ^ j + y ^ k / (1 - c) := by
  have hpos : 0 < 1 + y := by linarith
  have hne : (-y) ≠ 1 := by intro h; linarith
  have hg := geom_sum_eq hne k
  rw [hg]
  have hyk : (-y) ^ k = y ^ k := Even.neg_pow hk y
  rw [hyk]
  have hy0 : 0 ≤ y ^ k := Even.pow_nonneg hk y
  have e1 : (y ^ k - 1) / (-y - 1) = 1 / (1 + y) - y ^ k / (1 + y) := by
    field_simp; ring
  rw [e1]
  have : y ^ k / (1 + y) ≤ y ^ k / (1 - c) :=
    div_le_div_of_nonneg_left hy0 (by linarith) (by linarith)
  linarith

noncomputable def Nf (s : ℝ) : ℝ :=
  6931471808 / 10000000000 - (∑ i ∈ range 25, (-(s / 2 - 2)) ^ (i + 1) / ((i : ℝ) + 1)) +
    2 * (s / 2 - 2) ^ 26

noncomputable def Gf (s : ℝ) : ℝ :=
  1 / 3 * (∑ j ∈ range 18, (-(2 / 3 * (s / 2 - 2))) ^ j + (2 / 3 * (s / 2 - 2)) ^ 18 / (1 - 1 / 3))

noncomputable def Rf (t : ℝ) : ℝ :=
  58 / 241 * (∑ j ∈ range 16, (-(58 / 241 * t - 1)) ^ j +
    (58 / 241 * t - 1) ^ 16 / (1 - 49 / 241))

theorem f_le (s : ℝ) (h0 : 3 ≤ s) (h1 : s ≤ 5) :
    log (s - 2) / (s - 1) ≤ Nf s * Gf s := by
  have hl : log (s - 2) ≤ Nf s := by
    have e : s - 2 = 2 * (1 + (s / 2 - 2)) := by ring
    rw [e, Real.log_mul (by norm_num) (by linarith)]
    have := log_one_add_le (s / 2 - 2) (by linarith) (by linarith)
    have := Real.log_two_lt_d9
    unfold Nf; linarith
  have hg : 1 / (s - 1) ≤ Gf s := by
    have e : 1 / (s - 1) = 1 / 3 * (1 / (1 + 2 / 3 * (s / 2 - 2))) := by
      field_simp; ring
    rw [e]; unfold Gf
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    exact inv_one_add_le _ _ 18 ⟨9, rfl⟩ (by norm_num) (by linarith)
  have hl0 : 0 ≤ log (s - 2) := Real.log_nonneg (by linarith)
  rw [div_eq_mul_one_div]
  exact mul_le_mul hl hg (by apply div_nonneg <;> linarith) (by linarith)

theorem w_le (t : ℝ) (h0 : 96 / 29 ≤ t) : 1 / t ≤ Rf t := by
  have e : 1 / t = 58 / 241 * (1 / (1 + (58 / 241 * t - 1))) := by
    have ht : 0 < t := by linarith
    rw [show (1 + (58 / 241 * t - 1)) = 58 / 241 * t by ring]
    field_simp
  rw [e]; unfold Rf
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  exact inv_one_add_le _ _ 16 ⟨8, rfl⟩ (by norm_num) (by linarith)

/-- A univariate polynomial as a coefficient list. -/
noncomputable def evalL (L : List (ℕ × ℝ)) (x : ℝ) : ℝ := (L.map fun e => e.2 * x ^ e.1).sum

noncomputable def primL (L : List (ℕ × ℝ)) (a x : ℝ) : ℝ :=
  (L.map fun e => e.2 * ((x ^ (e.1 + 1) - a ^ (e.1 + 1)) / ((e.1 : ℝ) + 1))).sum

theorem evalL_cont (L : List (ℕ × ℝ)) : Continuous fun x => evalL L x := by
  induction L with
  | nil => simp only [evalL, List.map_nil, List.sum_nil]; exact continuous_const
  | cons e L ih =>
    simp only [evalL, List.map_cons, List.sum_cons] at ih ⊢
    exact (by fun_prop : Continuous fun x : ℝ => e.2 * x ^ e.1).add ih

theorem integral_evalL (L : List (ℕ × ℝ)) (a b : ℝ) :
    ∫ x in a..b, evalL L x = primL L a b := by
  induction L with
  | nil => simp [evalL, primL]
  | cons e L ih =>
    simp only [evalL, primL, List.map_cons, List.sum_cons] at ih ⊢
    rw [intervalIntegral.integral_add, ih]
    · congr 1
      rw [intervalIntegral.integral_const_mul, integral_pow]
    · exact (by fun_prop : Continuous fun x : ℝ => e.2 * x ^ e.1).intervalIntegrable _ _
    · exact (evalL_cont L).intervalIntegrable _ _

