    listEvalN r1j13_terms y = cellPoly 4 (1 : Fin 3) r1j13_lo r1j13_hi (fun j => (r1j13_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r1j13_terms, cellPoly, r1j13_lo, r1j13_hi, reciprocalUpper,
