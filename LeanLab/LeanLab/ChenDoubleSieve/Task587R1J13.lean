    (∫ x in domain (fun j => (r1j13_lo j : ℝ)) (fun j => (r1j13_hi j : ℝ)), cellPoly 4 (1 : Fin 3) r1j13_lo r1j13_hi x) = ((11172643288063887936418425547300326557 / 313548247437051984733820812401633801250) : ℝ) := by
  have h := integral_listEvalBox r1j13_terms r1j13_lo r1j13_hi (by intro j; fin_cases j <;> norm_num [r1j13_lo, r1j13_hi])
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 3 → ℝ) : listEvalN r1j13_terms (fun j => x j - (fun j : Fin 3 => (r1j13_lo j : ℝ)) j) = cellPoly 4 (1 : Fin 3) r1j13_lo r1j13_hi x := by
    rw [r1j13_eval]
    congr 1
    funext j
    fin_cases j <;> norm_num [r1j13_lo, Fin.snoc, Fin.cons] <;> ring
  simp only [he] at h
