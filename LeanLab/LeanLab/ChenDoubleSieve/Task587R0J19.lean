    congr 1
    funext j
    fin_cases j <;> norm_num [r0j19_lo] <;> ring
  simp only [he] at h
  have hL : (![(100 / 353), (25 / 61), (25 / 61), (25 / 61)] : Fin 4 → ℝ) = (fun j => (r0j19_lo j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r0j19_lo]
  have hH : (![(10 / 29), (5 / 11), (5 / 11), (5 / 11)] : Fin 4 → ℝ) = (fun j => (r0j19_hi j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r0j19_hi]
  rw [hL, hH] at h
  rw [r0j19_moment] at h
