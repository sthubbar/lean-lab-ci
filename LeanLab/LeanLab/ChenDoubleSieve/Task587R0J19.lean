/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r0j19_moment : listMomentFirst r0j19_terms (100 / 353) (10 / 29) (25 / 61) (5 / 11) = (231604981945328935386171648296548755007224447 / 2747522346748169324074774227024986347677056000000) := by
  decide +kernel

/-- The coefficient list is exactly the centered reciprocal polynomial after translation.
Wu 2004 page 26, derived exact algebraic identity. -/
theorem r0j19_eval (y : Fin 4 → ℝ) :
    listEvalN r0j19_terms y = cellPoly 4 (2 : Fin 4) r0j19_lo r0j19_hi (fun j => (r0j19_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r0j19_terms, cellPoly, r0j19_lo, r0j19_hi, reciprocalUpper,
    sum_range_succ, Fin.prod_univ_succ]
  <;> ring

/-- The reciprocal polynomial has its exact rational integral on the ordered domain.
Wu 2004 page 26, derived polynomial quadrature. -/
theorem r0j19_integral :
    (∫ x in domain (fun j => (r0j19_lo j : ℝ)) (fun j => (r0j19_hi j : ℝ)), cellPoly 4 (2 : Fin 4) r0j19_lo r0j19_hi x) = ((231604981945328935386171648296548755007224447 / 2747522346748169324074774227024986347677056000000) : ℝ) := by
  have h := integral_listEvalFirst r0j19_terms (a := (100 / 353)) (b := (10 / 29)) (c := (25 / 61)) (d := (5 / 11)) (by norm_num) (by norm_num) (by norm_num)
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have hsL : ((Fin.cons ((100 / 353) : ℝ) (fun _ : Fin 3 => ((25 / 61) : ℝ))) : Fin 4 → ℝ) = (![(100 / 353), (25 / 61), (25 / 61), (25 / 61)] : Fin 4 → ℝ) := by
    ext j; fin_cases j <;> rfl
  have hsH : ((Fin.cons ((10 / 29) : ℝ) (fun _ : Fin 3 => ((5 / 11) : ℝ))) : Fin 4 → ℝ) = (![(10 / 29), (5 / 11), (5 / 11), (5 / 11)] : Fin 4 → ℝ) := by
    ext j; fin_cases j <;> rfl
  rw [hsL, hsH] at h
  have he (x : Fin 4 → ℝ) : listEvalN r0j19_terms (fun j => x j - (![(100 / 353), (25 / 61), (25 / 61), (25 / 61)] : Fin 4 → ℝ) j) = cellPoly 4 (2 : Fin 4) r0j19_lo r0j19_hi x := by
