/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r2j9_moment : listMomentN r2j9_terms (100 / 357) (5 / 12) = (224618085957724238028702572406975891995272772713550704737063666231 / 7322306648459845844942643928815457387423184087444408546427596800000) := by
  decide +kernel

/-- The coefficient list is exactly the centered reciprocal polynomial after translation.
Wu 2004 page 26, derived exact algebraic identity. -/
theorem r2j9_eval (y : Fin 3 → ℝ) :
    listEvalN r2j9_terms y = cellPoly 6 (1 : Fin 3) r2j9_lo r2j9_hi (fun j => (r2j9_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r2j9_terms, cellPoly, r2j9_lo, r2j9_hi, reciprocalUpper,
    sum_range_succ, Fin.prod_univ_succ]
  <;> ring

/-- The reciprocal polynomial has its exact rational integral on the ordered domain.
Wu 2004 page 26, derived polynomial quadrature. -/
theorem r2j9_integral :
    (∫ x in domain (fun j => (r2j9_lo j : ℝ)) (fun j => (r2j9_hi j : ℝ)), cellPoly 6 (1 : Fin 3) r2j9_lo r2j9_hi x) = ((224618085957724238028702572406975891995272772713550704737063666231 / 7322306648459845844942643928815457387423184087444408546427596800000) : ℝ) := by
  have h := integral_listEvalN r2j9_terms (a := (100 / 357)) (b := (5 / 12)) (by norm_num)
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 3 → ℝ) : listEvalN r2j9_terms (fun j => x j - (fun _ : Fin 3 => ((100 / 357) : ℝ)) j) = cellPoly 6 (1 : Fin 3) r2j9_lo r2j9_hi x := by
    rw [r2j9_eval]
    congr 1
    funext j
    fin_cases j <;> norm_num [r2j9_lo] <;> ring
  simp only [he] at h
  have hL : (fun _ : Fin 3 => ((100 / 357) : ℝ)) = (fun j => (r2j9_lo j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r2j9_lo]
  have hH : (fun _ : Fin 3 => ((5 / 12) : ℝ)) = (fun j => (r2j9_hi j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r2j9_hi]
  rw [hL, hH] at h
  rw [r2j9_moment] at h
  push_cast at h
  exact h

/-- The original I2 budget holds throughout phi at least seven halves.
Wu 2004 page 26, Table 1 row 3 page 30. -/
theorem r2j9_tail {ω : ℝ → ℝ} (hω : IsBuchstab ω) {φ : ℝ} (hφ : (7 / 2 : ℝ) ≤ φ) :
    buchstabIntegral ω 1 (fun j => (r2j9_lo j : ℝ)) (fun j => (r2j9_hi j : ℝ)) φ ≤ ((8633809 / 500000000) : ℝ) := by
  have h := cell_tail_integral hω (n := 1) (by norm_num) 6 r2j9_lo r2j9_hi hφ
    (by intro j; fin_cases j <;> norm_num [r2j9_lo])
    (by intro j; fin_cases j <;> norm_num [r2j9_lo, r2j9_hi])
    (by intro j; fin_cases j <;> norm_num [r2j9_hi])
  change buchstabIntegral ω 1 (fun j => (r2j9_lo j : ℝ)) (fun j => (r2j9_hi j : ℝ)) φ ≤ (5618 / 10000 : ℝ) * (∫ x in domain (fun j => (r2j9_lo j : ℝ)) (fun j => (r2j9_hi j : ℝ)), cellPoly 6 (1 : Fin 3) r2j9_lo r2j9_hi x) at h
  rw [r2j9_integral] at h
  exact h.trans (by norm_num)

