/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r0j15_moment : listMomentBox r0j15_terms r0j15_lo r0j15_hi = (3230036403231625175590898119569159633103 / 344907161617615460532485260024898049480000) := by
  decide +kernel

/-- The coefficient list is exactly the centered reciprocal polynomial after translation.
Wu 2004 page 26, derived exact algebraic identity. -/
theorem r0j15_eval (y : Fin 3 → ℝ) :
    listEvalN r0j15_terms y = cellPoly 4 (1 : Fin 3) r0j15_lo r0j15_hi (fun j => (r0j15_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r0j15_terms, cellPoly, r0j15_lo, r0j15_hi, reciprocalUpper,
    sum_range_succ, Fin.prod_univ_succ]
  <;> ring

/-- The reciprocal polynomial has its exact rational integral on the ordered domain.
Wu 2004 page 26, derived polynomial quadrature. -/
theorem r0j15_integral :
    (∫ x in domain (fun j => (r0j15_lo j : ℝ)) (fun j => (r0j15_hi j : ℝ)), cellPoly 4 (1 : Fin 3) r0j15_lo r0j15_hi x) = ((3230036403231625175590898119569159633103 / 344907161617615460532485260024898049480000) : ℝ) := by
  have h := integral_listEvalBox r0j15_terms r0j15_lo r0j15_hi (by intro j; fin_cases j <;> norm_num [r0j15_lo, r0j15_hi])
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 3 → ℝ) : listEvalN r0j15_terms (fun j => x j - (fun j : Fin 3 => (r0j15_lo j : ℝ)) j) = cellPoly 4 (1 : Fin 3) r0j15_lo r0j15_hi x := by
    rw [r0j15_eval]
    congr 1
    funext j
    fin_cases j <;> norm_num [r0j15_lo, Fin.snoc, Fin.cons] <;> ring
  simp only [he] at h
  have hD : Set.Icc (fun j : Fin 3 => (r0j15_lo j : ℝ)) (fun j : Fin 3 => (r0j15_hi j : ℝ)) = domain (fun j : Fin 3 => (r0j15_lo j : ℝ)) (fun j : Fin 3 => (r0j15_hi j : ℝ)) := by
    symm
    apply domain_eq_box_of_separated
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [r0j15_lo, r0j15_hi] <;> norm_num
  rw [hD] at h
  rw [r0j15_moment] at h
  push_cast at h
  exact h

