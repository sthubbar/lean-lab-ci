  have h := cell_tail_integral hω (n := 1) (by norm_num) 4 r0j15_lo r0j15_hi hφ
    (by intro j; fin_cases j <;> norm_num [r0j15_lo, Fin.snoc, Fin.cons])
    (by intro j; fin_cases j <;> norm_num [r0j15_lo, r0j15_hi])
    (by intro j; fin_cases j <;> norm_num [r0j15_hi, Fin.snoc, Fin.cons])
