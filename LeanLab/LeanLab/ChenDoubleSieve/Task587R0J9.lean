/-- The reciprocal polynomial has its exact rational integral on the ordered domain.
Wu 2004 page 26, derived polynomial quadrature. -/
theorem r0j9_integral :
    (∫ x in domain (fun j => (r0j9_lo j : ℝ)) (fun j => (r0j9_hi j : ℝ)), cellPoly 6 (1 : Fin 3) r0j9_lo r0j9_hi x) = ((120226154046540718828272111526164913326899878180710968732122565447292512905116693403 / 4862740402048292220348058455330139105952634633830060734762186711484747776560801600000) : ℝ) := by
  have h := integral_listEvalN r0j9_terms (a := (100 / 353)) (b := (25 / 61)) (by norm_num)
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 3 → ℝ) : listEvalN r0j9_terms (fun j => x j - (fun _ : Fin 3 => ((100 / 353) : ℝ)) j) = cellPoly 6 (1 : Fin 3) r0j9_lo r0j9_hi x := by
    rw [r0j9_eval]
    congr 1
    funext j
    fin_cases j <;> norm_num [r0j9_lo, Fin.snoc, Fin.cons] <;> ring
  simp only [he] at h
  have hL : (fun _ : Fin 3 => ((100 / 353) : ℝ)) = (fun j => (r0j9_lo j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r0j9_lo, Fin.snoc, Fin.cons]
  have hH : (fun _ : Fin 3 => ((25 / 61) : ℝ)) = (fun j => (r0j9_hi j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r0j9_hi, Fin.snoc, Fin.cons]
  rw [hL, hH] at h
  rw [r0j9_moment] at h
  push_cast at h
  exact h

