/-- The coefficient list is exactly the centered reciprocal polynomial after translation.
Wu 2004 page 26, derived exact algebraic identity. -/
theorem r0j9_eval (y : Fin 3 → ℝ) :
    listEvalN r0j9_terms y = cellPoly 6 (1 : Fin 3) r0j9_lo r0j9_hi (fun j => (r0j9_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r0j9_terms, cellPoly, r0j9_lo, r0j9_hi, reciprocalUpper,
