/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r0j9_moment : listMomentN r0j9_terms (100 / 353) (25 / 61) = (120226154046540718828272111526164913326899878180710968732122565447292512905116693403 / 4862740402048292220348058455330139105952634633830060734762186711484747776560801600000) := by
