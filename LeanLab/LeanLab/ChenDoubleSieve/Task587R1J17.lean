/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r1j17_moment : listMomentLast r1j17_terms (25 / 72) (100 / 243) (100 / 243) (10 / 23) = (4289433597169166638453356395713707272460506 / 37617211846242820872875624356963233289570188033) := by
  decide +kernel

/-- The coefficient list is exactly the centered reciprocal polynomial after translation.
Wu 2004 page 26, derived exact algebraic identity. -/
theorem r1j17_eval (y : Fin 4 → ℝ) :
    listEvalN r1j17_terms y = cellPoly 4 (2 : Fin 4) r1j17_lo r1j17_hi (fun j => (r1j17_lo j : ℝ) + y j) := by
  norm_num [listEvalN, r1j17_terms, cellPoly, r1j17_lo, r1j17_hi, reciprocalUpper,
    sum_range_succ, Fin.prod_univ_succ]
  <;> ring

/-- The reciprocal polynomial has its exact rational integral on the ordered domain.
Wu 2004 page 26, derived polynomial quadrature. -/
theorem r1j17_integral :
    (∫ x in domain (fun j => (r1j17_lo j : ℝ)) (fun j => (r1j17_hi j : ℝ)), cellPoly 4 (2 : Fin 4) r1j17_lo r1j17_hi x) = ((4289433597169166638453356395713707272460506 / 37617211846242820872875624356963233289570188033) : ℝ) := by
  have h := integral_listEvalLast r1j17_terms (a := (25 / 72)) (b := (100 / 243)) (c := (100 / 243)) (d := (10 / 23)) (by norm_num) (by norm_num) (by norm_num)
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  have he (x : Fin 4 → ℝ) : listEvalN r1j17_terms (fun j => x j - ((Fin.snoc (fun _ : Fin 3 => ((25 / 72) : ℝ)) ((100 / 243) : ℝ)) : Fin 4 → ℝ) j) = cellPoly 4 (2 : Fin 4) r1j17_lo r1j17_hi x := by
    rw [r1j17_eval]
    congr 1
    funext j
    fin_cases j <;> norm_num [r1j17_lo, Fin.snoc, Fin.cons] <;> ring
  simp only [he] at h
  have hL : ((Fin.snoc (fun _ : Fin 3 => ((25 / 72) : ℝ)) ((100 / 243) : ℝ)) : Fin 4 → ℝ) = (fun j => (r1j17_lo j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r1j17_lo, Fin.snoc, Fin.cons]
  have hH : ((Fin.snoc (fun _ : Fin 3 => ((100 / 243) : ℝ)) ((10 / 23) : ℝ)) : Fin 4 → ℝ) = (fun j => (r1j17_hi j : ℝ)) := by
    ext j; fin_cases j <;> norm_num [r1j17_hi, Fin.snoc, Fin.cons]
  rw [hL, hH] at h
  rw [r1j17_moment] at h
  push_cast at h
  exact h

/-- The original I2 budget holds throughout phi at least seven halves.
Wu 2004 page 26, Table 1 row 2 page 30. -/
theorem r1j17_tail {ω : ℝ → ℝ} (hω : IsBuchstab ω) {φ : ℝ} (hφ : (7 / 2 : ℝ) ≤ φ) :
    buchstabIntegral ω 2 (fun j => (r1j17_lo j : ℝ)) (fun j => (r1j17_hi j : ℝ)) φ ≤ ((92979 / 1000000000) : ℝ) := by
  have h := cell_tail_integral hω (n := 2) (by norm_num) 4 r1j17_lo r1j17_hi hφ
    (by intro j; fin_cases j <;> norm_num [r1j17_lo, Fin.snoc, Fin.cons])
    (by intro j; fin_cases j <;> norm_num [r1j17_lo, r1j17_hi])
    (by intro j; fin_cases j <;> norm_num [r1j17_hi, Fin.snoc, Fin.cons])
  change buchstabIntegral ω 2 (fun j => (r1j17_lo j : ℝ)) (fun j => (r1j17_hi j : ℝ)) φ ≤ (5618 / 10000 : ℝ) * (∫ x in domain (fun j => (r1j17_lo j : ℝ)) (fun j => (r1j17_hi j : ℝ)), cellPoly 4 (2 : Fin 4) r1j17_lo r1j17_hi x) at h
  rw [r1j17_integral] at h
  exact h.trans (by norm_num)

