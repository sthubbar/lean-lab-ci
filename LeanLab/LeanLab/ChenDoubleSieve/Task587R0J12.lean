/-- The exact rational coefficient moment. Wu 2004 page 26, derived finite certificate. -/
theorem r0j12_moment : listMomentLast r0j12_terms (50 / 227) (100 / 353) (25 / 61) (5 / 11) = (491425177702057016642572232087180445398767872675963805681855179518001472961 / 38983016685509626440599992299740000367634972728850150970889091715030307600000) := by
