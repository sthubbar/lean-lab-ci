private theorem Xi1_general_eq_c6 {s sp t : ℝ} (hsp : sp - 2 < 27/10)
    (h1 : (27/10 : ℝ) ≤ t) (h2 : t ≤ 14/5) :
    Wu04Functional.Xi1 s sp t =
      Wu04Integral.sigma0 t / (2 * t) * log (16 / ((s - 1) * (sp - 1))) +
        log ((t + 1) ^ 2 / ((s - 1) * (sp - 1))) / (2 * t) := by
