  have hp : (0 : ℝ) ≤ (0.4700036292094 : ℝ) := by norm_num
  have hlo' : (0.627455346352 : ℝ) ≤ log ((19/5) : ℝ) * (log ((24/5) : ℝ) - log 3) := by
