    have hb : (0 : ℝ) < 51/20 + 1 := by norm_num
    constructor
    · rw [le_div_iff₀ hb]
      nlinarith [ht.1, ht.2]
    · rw [div_le_iff₀ hb]
      nlinarith [ht.1, ht.2]
  have h := log_succ_integral_lower (a := (5/2 : ℝ)) (b := (13/5 : ℝ)) (c := (51/20 : ℝ))
    (r := (1/71 : ℝ)) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) hxr 8
