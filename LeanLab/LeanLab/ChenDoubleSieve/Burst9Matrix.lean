    have h2 : log ((29/10 - 1) * (319/100 - 1)) / 2 ≤ (1.42575543001 : ℝ) / 2 := by
      linarith [hP.2]
    exact mul_le_mul h2 h23.2 (by linarith [h23.1]) (by linarith [hP.1])
