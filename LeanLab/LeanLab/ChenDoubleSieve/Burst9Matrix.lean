  have hlow := sigma_lower_bound (a := 3) (b := ((24/5) : ℝ)) (c := ((19/5) : ℝ)) (m := ((29/10) : ℝ))
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) 12
