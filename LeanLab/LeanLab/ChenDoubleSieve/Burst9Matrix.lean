        (∫ t in (11/5 : ℝ)..(23/10 : ℝ), Wu04Integral.sigma0 t / (2 * t)) := by
    have hm := mul_le_mul hLP hA (by norm_num) (by linarith [hLP])
    linarith [hm]
  have hlast : (log ((29/10 - 1) * (319/100 - 1)) / 2) * log (23/22) ≤
