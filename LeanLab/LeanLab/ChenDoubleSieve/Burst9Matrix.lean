    (by norm_num) (by norm_num)
  have hI2 : IntervalIntegrable (fun t : ℝ => log (t + 1) / t) volume (12/5 : ℝ) (5/2 : ℝ) :=
    log_succ_div_integrable_exp (by norm_num) (by norm_num)
