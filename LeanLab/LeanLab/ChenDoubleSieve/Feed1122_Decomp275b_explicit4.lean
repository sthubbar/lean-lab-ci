import Mathlib

/-!
Certified lower bound work for the double integral behind index 4 of the Wu 2004 Section 10
display, Wu 2004 arXiv 0705.1652, page 42, equation 10.5 and the final display on page 42,
with kappa1 = 1/12 and kappa2 = 29/250. The target is the exact statement of
`leaf_explicit4` in `Feed1122_Decomp275b_values_explicit.lean`.

Method: on the triangle 1/12 ≤ t ≤ u ≤ 29/250 put x = (12 t + 12 u - 2)/3, which lies in
the interval from 0 to 98/375. Then 5 - 12 t - 12 u = 3 times 1 - x and
6 - 12 t - 12 u = 4 - 3 x. The logarithm is bounded below by a rational lower bound for
log 3 minus the Taylor majorant of minus log of 1 - x, the reciprocal of 4 - 3 x by a
geometric partial sum, and 1/u, 1/t by geometric partial sums of even length around 1/10. A python check
with exact fractions, degrees 8, 8 and 8 with the 1/v sums centred at 1/10, gives 48 times the
integral of the product minorant equal to 0.69737525, above 0.697375.
AI wrote the Lean code. Binary Goldbach is open.
-/

namespace LeanLab.ChenDoubleSieve.Feed1122Explicit4

open Real Finset MeasureTheory intervalIntegral

theorem partial_le_neglog (x : ℝ) (h0 : 0 ≤ x) (h1 : x < 1) (n : ℕ) :
    ∑ i ∈ range n, x ^ (i + 1) / ((i : ℝ) + 1) ≤ -log (1 - x) := by
  have hx : |x| < 1 := by rw [abs_of_nonneg h0]; exact h1
  exact sum_le_hasSum (range n) (fun i _ => by positivity)
    (Real.hasSum_pow_div_log_of_abs_lt_one hx)

theorem neglog_le (x : ℝ) (h0 : 0 ≤ x) (h1 : x < 1) (n : ℕ) :
    -log (1 - x) ≤ ∑ i ∈ range n, x ^ (i + 1) / ((i : ℝ) + 1) + x ^ (n + 1) / (1 - x) := by
  have hx : |x| < 1 := by rw [abs_of_nonneg h0]; exact h1
  have h := Real.abs_log_sub_add_sum_range_le hx n
  rw [abs_of_nonneg h0] at h
  have := (abs_le.mp h).1
  linarith

/-- Geometric partial sums are below the full sum. -/
theorem geom_le_inv (y : ℝ) (h0 : 0 ≤ y) (h1 : y < 1) (m : ℕ) :
    ∑ j ∈ range m, y ^ j ≤ 1 / (1 - y) := by
  have h := hasSum_geometric_of_lt_one h0 h1
  rw [one_div]
  exact sum_le_hasSum (range m) (fun i _ => by positivity) h

/-- A rational lower bound for log 3. -/
theorem log3_ge : (10986122 / 10000000 : ℝ) ≤ log 3 := by
  have h2 := Real.log_two_gt_d9
  have h := partial_le_neglog (1 / 3) (by norm_num) (by norm_num) 15
  have he : -log (1 - 1 / 3 : ℝ) = log 3 - log 2 := by
    rw [show (1 - 1 / 3 : ℝ) = 2 / 3 by norm_num, Real.log_div (by norm_num) (by norm_num)]
    ring
  rw [he] at h
  simp only [Finset.sum_range_succ, Finset.sum_range_zero] at h
  norm_num at h
  linarith

/-- Lower bound for the logarithm factor. -/
noncomputable def Lmin (n : ℕ) (x : ℝ) : ℝ :=
  10986122 / 10000000 - (∑ i ∈ range n, x ^ (i + 1) / ((i : ℝ) + 1) + x ^ (n + 1) / (1 - 98 / 375))

/-- Lower bound for the reciprocal of 4 - 3 x. -/
noncomputable def Gmin (k : ℕ) (x : ℝ) : ℝ := 1 / 4 * ∑ j ∈ range k, (3 / 4 * x) ^ j

/-- Lower bound for 1/v, a geometric partial sum around 1/10. -/
noncomputable def Imin (m : ℕ) (v : ℝ) : ℝ := 10 * ∑ j ∈ range m, (1 - 10 * v) ^ j

theorem Lmin_le (n : ℕ) (x : ℝ) (h0 : 0 ≤ x) (h1 : x ≤ 98 / 375) :
    Lmin n x ≤ log (3 * (1 - x)) := by
  rw [Real.log_mul (by norm_num) (by linarith)]
  have h := neglog_le x h0 (by linarith) n
  have hr : x ^ (n + 1) / (1 - x) ≤ x ^ (n + 1) / (1 - 98 / 375) := by
    apply div_le_div_of_nonneg_left (pow_nonneg h0 _) (by norm_num) (by linarith)
  have h3 := log3_ge
  unfold Lmin
  linarith

theorem Gmin_le (k : ℕ) (x : ℝ) (h0 : 0 ≤ x) (h1 : x ≤ 98 / 375) :
    Gmin k x ≤ 1 / (4 - 3 * x) := by
  have h := geom_le_inv (3 / 4 * x) (by positivity) (by linarith) k
  have he : 1 / (4 - 3 * x) = 1 / 4 * (1 / (1 - 3 / 4 * x)) := by
    field_simp
  rw [he]
  unfold Gmin
  exact mul_le_mul_of_nonneg_left h (by norm_num)

theorem Gmin_nonneg (k : ℕ) (x : ℝ) (h0 : 0 ≤ x) : 0 ≤ Gmin k x := by
  unfold Gmin
  exact mul_nonneg (by norm_num) (sum_nonneg (fun j _ => by positivity))

theorem Imin_le (m : ℕ) (hm : Even m) (v : ℝ) (h0 : 0 < v) :
    Imin m v ≤ 1 / v := by
  have hg := geom_sum_eq (x := 1 - 10 * v) (by intro h; linarith) m
  have hp : 0 ≤ (1 - 10 * v) ^ m := hm.pow_nonneg _
  have he : 1 / v = 10 * (1 / (10 * v)) := by field_simp
  rw [he]
  unfold Imin
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  rw [hg, show (1 - 10 * v - 1) = -(10 * v) by ring, div_neg, ← neg_div]
  apply div_le_div_of_nonneg_right _ (by linarith)
  linarith

theorem Imin_nonneg (m : ℕ) (v : ℝ) (h0 : 0 < v) (h1 : v < 1 / 5) : 0 ≤ Imin m v := by
  have hg := geom_sum_eq (x := 1 - 10 * v) (by intro h; linarith) m
  have hab : |1 - 10 * v| ≤ 1 := by rw [abs_le]; constructor <;> linarith
  have hp : (1 - 10 * v) ^ m ≤ 1 := by
    have := pow_le_one₀ (abs_nonneg _) hab (n := m)
    rw [← abs_pow] at this
    exact le_trans (le_abs_self _) this
  unfold Imin
  apply mul_nonneg (by norm_num)
  rw [hg, show (1 - 10 * v - 1) = -(10 * v) by ring, div_neg, ← neg_div]
  apply div_nonneg _ (by linarith)
  linarith

/-- The product minorant of the integrand. -/
noncomputable def Mmin (n k m : ℕ) (t u : ℝ) : ℝ :=
  Lmin n ((12 * t + 12 * u - 2) / 3) * Gmin k ((12 * t + 12 * u - 2) / 3) *
    Imin m u * Imin m t

/-- Pointwise lower bound of the integrand on the triangle. -/
theorem Mmin_le (n k m : ℕ) (hm : Even m) (t u : ℝ) (ht : 1 / 12 ≤ t) (htu : t ≤ u) (hu : u ≤ 29 / 250) :
    Mmin n k m t u ≤
      Real.log (5 - 12 * t - 12 * u) / (6 - 12 * t - 12 * u) / u / t := by
  set x := (12 * t + 12 * u - 2) / 3 with hx
  have hx0 : 0 ≤ x := by rw [hx]; linarith
  have hx1 : x ≤ 98 / 375 := by rw [hx]; linarith
  have e1 : 5 - 12 * t - 12 * u = 3 * (1 - x) := by rw [hx]; ring
  have e2 : 6 - 12 * t - 12 * u = 4 - 3 * x := by rw [hx]; ring
  have hlog : 0 ≤ log (3 * (1 - x)) := Real.log_nonneg (by linarith)
  have hw : 0 < 4 - 3 * x := by linarith
  have hupos : 0 < u := by linarith
  have htpos : 0 < t := by linarith
  have hrhs : Real.log (5 - 12 * t - 12 * u) / (6 - 12 * t - 12 * u) / u / t =
      log (3 * (1 - x)) * (1 / (4 - 3 * x)) * (1 / u) * (1 / t) := by
    rw [e1, e2]; field_simp
  rw [hrhs]
  unfold Mmin
  rw [← hx]
  have hG := Gmin_le k x hx0 hx1
  have hG0 := Gmin_nonneg k x hx0
  have hL := Lmin_le n x hx0 hx1
  have hIu := Imin_le m hm u hupos
  have hIu0 := Imin_nonneg m u hupos (by linarith)
  have hIt := Imin_le m hm t htpos
  have hIt0 := Imin_nonneg m t htpos (by linarith)
  have hw' : 0 ≤ 1 / (4 - 3 * x) := by positivity
  have s1 : Lmin n x * Gmin k x ≤ log (3 * (1 - x)) * (1 / (4 - 3 * x)) :=
    mul_le_mul hL hG hG0 hlog
  have s2 : Lmin n x * Gmin k x * Imin m u ≤
      log (3 * (1 - x)) * (1 / (4 - 3 * x)) * (1 / u) :=
    mul_le_mul s1 hIu hIu0 (mul_nonneg hlog hw')
  exact mul_le_mul s2 hIt hIt0 (mul_nonneg (mul_nonneg hlog hw') (by positivity))


/-- Clamp to the interval from 1/12 to 29/250. -/
noncomputable def cl (v : ℝ) : ℝ := max (1 / 12) (min v (29 / 250))

theorem cl_eq (v : ℝ) (h0 : 1 / 12 ≤ v) (h1 : v ≤ 29 / 250) : cl v = v := by
  unfold cl; rw [min_eq_left h1, max_eq_right h0]

theorem cl_ge (v : ℝ) : 1 / 12 ≤ cl v := le_max_left _ _

theorem cl_le (v : ℝ) : cl v ≤ 29 / 250 := by
  unfold cl; exact max_le (by norm_num) (min_le_right _ _)

theorem cl_cont : Continuous cl := by unfold cl; fun_prop

/-- The integrand with clamped variables, continuous everywhere. -/
noncomputable def Ft (t u : ℝ) : ℝ :=
  Real.log (5 - 12 * cl t - 12 * cl u) / (6 - 12 * cl t - 12 * cl u) / cl u

theorem Ft_cont : Continuous (Function.uncurry Ft) := by
  unfold Function.uncurry Ft
  have h1 : Continuous fun p : ℝ × ℝ => cl p.1 := cl_cont.comp continuous_fst
  have h2 : Continuous fun p : ℝ × ℝ => cl p.2 := cl_cont.comp continuous_snd
  apply Continuous.div
  · apply Continuous.div
    · apply Continuous.log (by fun_prop)
      intro p; have := cl_le p.1; have := cl_le p.2; linarith
    · fun_prop
    · intro p; have := cl_le p.1; have := cl_le p.2; linarith
  · exact h2
  · intro p; have := cl_ge p.2; linarith

theorem inner_eq (t : ℝ) (ht0 : 1 / 12 ≤ t) (ht1 : t ≤ 29 / 250) :
    (∫ u in t..(29/250 : ℝ),
        Real.log (5 - 12 * t - 12 * u) / (6 - 12 * t - 12 * u) / u) =
      ∫ u in t..(29/250 : ℝ), Ft t u := by
  refine intervalIntegral.integral_congr (fun u hu => ?_)
  rw [Set.uIcc_of_le ht1] at hu
  simp only [Ft, cl_eq t ht0 ht1, cl_eq u (by linarith [hu.1]) hu.2]

theorem inner_cont : Continuous fun t => ∫ u in t..(29/250 : ℝ), Ft t u := by
  have h := intervalIntegral.continuous_parametric_intervalIntegral_of_continuous
    (μ := volume) (a₀ := (29/250 : ℝ)) Ft_cont continuous_id
  have he : (fun t => ∫ u in t..(29/250 : ℝ), Ft t u) =
      fun t => -∫ u in (29/250 : ℝ)..id t, Ft t u := by
    funext t; rw [intervalIntegral.integral_symm]; rfl
  rw [he]; exact h.neg

theorem Mmin_cont (n k m : ℕ) : Continuous (Function.uncurry (Mmin n k m)) := by
  unfold Function.uncurry Mmin Lmin Gmin Imin
  fun_prop

theorem innerM_cont (n k m : ℕ) : Continuous fun t => ∫ u in t..(29/250 : ℝ), Mmin n k m t u := by
  have h := intervalIntegral.continuous_parametric_intervalIntegral_of_continuous
    (μ := volume) (a₀ := (29/250 : ℝ)) (Mmin_cont n k m) continuous_id
  have he : (fun t => ∫ u in t..(29/250 : ℝ), Mmin n k m t u) =
      fun t => -∫ u in (29/250 : ℝ)..id t, Mmin n k m t u := by
    funext t; rw [intervalIntegral.integral_symm]; rfl
  rw [he]; exact h.neg

/-- Reduction of the target to the double integral of the polynomial minorant. -/
theorem reduce (n k m : ℕ) (hm : Even m) :
    (∫ t in (1/12 : ℝ)..(29/250), ∫ u in t..(29/250 : ℝ), Mmin n k m t u) ≤
      ∫ t in (1/12 : ℝ)..(29/250),
        (∫ u in t..(29/250 : ℝ),
          Real.log (5 - 12 * t - 12 * u) / (6 - 12 * t - 12 * u) / u) / t := by
  have hcongr : (∫ t in (1/12 : ℝ)..(29/250),
        (∫ u in t..(29/250 : ℝ),
          Real.log (5 - 12 * t - 12 * u) / (6 - 12 * t - 12 * u) / u) / t) =
      ∫ t in (1/12 : ℝ)..(29/250), (∫ u in t..(29/250 : ℝ), Ft t u) / t := by
    refine intervalIntegral.integral_congr (fun t ht => ?_)
    rw [Set.uIcc_of_le (by norm_num)] at ht
    rw [inner_eq t ht.1 ht.2]
  rw [hcongr]
  refine intervalIntegral.integral_mono_on (by norm_num) ?_ ?_ ?_
  · exact (innerM_cont n k m).intervalIntegrable _ _
  · apply ContinuousOn.intervalIntegrable
    apply ContinuousOn.div inner_cont.continuousOn continuousOn_id
    intro t ht
    rw [Set.uIcc_of_le (by norm_num)] at ht
    simp only [id]; linarith [ht.1]
  · intro t ht
    have ht0 : 0 < t := by linarith [ht.1]
    rw [← inner_eq t ht.1 ht.2, ← intervalIntegral.integral_div]
    refine intervalIntegral.integral_mono_on ht.2 ?_ ?_ ?_
    · exact ((Mmin_cont n k m).comp (Continuous.prodMk continuous_const continuous_id)).intervalIntegrable _ _
    · apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le ht.2]
      apply ContinuousOn.div _ continuousOn_const (fun _ _ => ht0.ne')
      apply ContinuousOn.div
      · apply ContinuousOn.div
        · apply ContinuousOn.log (by fun_prop)
          intro u hu; exact ne_of_gt (by linarith [hu.2, ht.2])
        · fun_prop
        · intro u hu; exact ne_of_gt (by linarith [hu.2, ht.2])
      · exact continuousOn_id
      · intro u hu; exact ne_of_gt (by linarith [hu.1, ht.1])
    · intro u hu
      exact Mmin_le n k m hm t u ht.1 hu.1 hu.2


/-- A bivariate polynomial given as a list of exponent pairs and coefficients. -/
noncomputable def Pl (L : List (ℕ × ℕ × ℝ)) (t u : ℝ) : ℝ :=
  (L.map fun e => e.2.2 * t ^ e.1 * u ^ e.2.1).sum

/-- Its inner integral in u. -/
noncomputable def Ql (L : List (ℕ × ℕ × ℝ)) (t : ℝ) : ℝ :=
  (L.map fun e => e.2.2 * t ^ e.1 *
    (((29 / 250 : ℝ) ^ (e.2.1 + 1) - t ^ (e.2.1 + 1)) / ((e.2.1 : ℝ) + 1))).sum

/-- Exact double integral of a monomial over the triangle. -/
noncomputable def Aij (i j : ℕ) : ℝ :=
  ((29 / 250 : ℝ) ^ (j + 1) * (((29 / 250 : ℝ) ^ (i + 1) - (1 / 12 : ℝ) ^ (i + 1)) / ((i : ℝ) + 1)) -
    ((29 / 250 : ℝ) ^ (i + j + 1 + 1) - (1 / 12 : ℝ) ^ (i + j + 1 + 1)) / (((i + j + 1 : ℕ) : ℝ) + 1)) /
    ((j : ℝ) + 1)

theorem Pl_cont (L : List (ℕ × ℕ × ℝ)) (t : ℝ) : Continuous fun u => Pl L t u := by
  induction L with
  | nil => simp only [Pl, List.map_nil, List.sum_nil]; exact continuous_const
  | cons e L ih =>
    simp only [Pl, List.map_cons, List.sum_cons] at ih ⊢
    exact (by fun_prop : Continuous fun u : ℝ => e.2.2 * t ^ e.1 * u ^ e.2.1).add ih

theorem Ql_cont (L : List (ℕ × ℕ × ℝ)) : Continuous fun t => Ql L t := by
  induction L with
  | nil => simp only [Ql, List.map_nil, List.sum_nil]; exact continuous_const
  | cons e L ih =>
    simp only [Ql, List.map_cons, List.sum_cons] at ih ⊢
    exact (by fun_prop : Continuous fun t : ℝ => e.2.2 * t ^ e.1 *
      (((29 / 250 : ℝ) ^ (e.2.1 + 1) - t ^ (e.2.1 + 1)) / ((e.2.1 : ℝ) + 1))).add ih

theorem inner_poly (L : List (ℕ × ℕ × ℝ)) (t : ℝ) :
    ∫ u in t..(29/250 : ℝ), Pl L t u = Ql L t := by
  induction L with
  | nil => simp [Pl, Ql]
  | cons e L ih =>
    simp only [Pl, Ql, List.map_cons, List.sum_cons] at ih ⊢
    rw [intervalIntegral.integral_add, ih]
    · congr 1
      rw [intervalIntegral.integral_const_mul, integral_pow]
    · exact (by fun_prop : Continuous fun u : ℝ => e.2.2 * t ^ e.1 * u ^ e.2.1).intervalIntegrable _ _
    · exact (Pl_cont L t).intervalIntegrable _ _

theorem outer_poly (L : List (ℕ × ℕ × ℝ)) :
    ∫ t in (1/12 : ℝ)..(29/250), Ql L t = (L.map fun e => e.2.2 * Aij e.1 e.2.1).sum := by
  induction L with
  | nil => simp [Ql]
  | cons e L ih =>
    simp only [Ql, List.map_cons, List.sum_cons] at ih ⊢
    rw [intervalIntegral.integral_add, ih]
    · congr 1
      have he : (fun t : ℝ => e.2.2 * t ^ e.1 *
          (((29 / 250 : ℝ) ^ (e.2.1 + 1) - t ^ (e.2.1 + 1)) / ((e.2.1 : ℝ) + 1))) =
          fun t => e.2.2 / ((e.2.1 : ℝ) + 1) *
            ((29 / 250 : ℝ) ^ (e.2.1 + 1) * t ^ e.1 - t ^ (e.1 + e.2.1 + 1)) := by
        funext t; ring
      rw [he, intervalIntegral.integral_const_mul, intervalIntegral.integral_sub,
        intervalIntegral.integral_const_mul, integral_pow, integral_pow]
      · unfold Aij; push_cast; ring
      · exact (by fun_prop : Continuous fun t : ℝ =>
          (29 / 250 : ℝ) ^ (e.2.1 + 1) * t ^ e.1).intervalIntegrable _ _
      · exact (continuous_pow _).intervalIntegrable _ _
    · exact (by fun_prop : Continuous fun t : ℝ => e.2.2 * t ^ e.1 *
        (((29 / 250 : ℝ) ^ (e.2.1 + 1) - t ^ (e.2.1 + 1)) / ((e.2.1 : ℝ) + 1))).intervalIntegrable _ _
    · exact (Ql_cont L).intervalIntegrable _ _

