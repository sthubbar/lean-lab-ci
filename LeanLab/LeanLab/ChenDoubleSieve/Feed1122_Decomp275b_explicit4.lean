theorem Mmin_expand (t u : ℝ) : Mmin 8 8 8 t u = Pl coeffs t u := by
  unfold coeffs
  simp only [Mmin, Lmin, Gmin, Imin, Pl, List.map_cons, List.map_nil, List.sum_cons,
    List.sum_nil, Finset.sum_range_succ, Finset.sum_range_zero]
  ring

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- Exact evaluation of the double integral of the expanded minorant, compared with the target. -/
theorem value_ge : (0.697375 : ℝ) / 48 ≤ (coeffs.map fun e => e.2.2 * Aij e.1 e.2.1).sum := by
  unfold coeffs
  simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, Aij]
  norm_num

/-- Wu 2004 arXiv 0705.1652 page 42, equation 10.5 and the final display: the fourth integral
term with kappa1 = 1/12 and kappa2 = 29/250 is at least 0.697375. Exact statement of
`leaf_explicit4`. -/
theorem explicit4 :
    (0.697375 : ℝ) ≤ 48 * ∫ t in (1/12 : ℝ)..(29/250),
      (∫ u in t..(29/250 : ℝ),
        Real.log (5 - 12 * t - 12 * u) / (6 - 12 * t - 12 * u) / u) / t := by
  have h1 := reduce 8 8 8 ⟨4, by norm_num⟩
  have h2 : (∫ t in (1/12 : ℝ)..(29/250), ∫ u in t..(29/250 : ℝ), Mmin 8 8 8 t u) =
      (coeffs.map fun e => e.2.2 * Aij e.1 e.2.1).sum := by
    have he : (fun t => ∫ u in t..(29/250 : ℝ), Mmin 8 8 8 t u) = fun t => Ql coeffs t := by
      funext t
      rw [← inner_poly]
      congr 1
      funext u
      exact Mmin_expand t u
    rw [he]
    exact outer_poly coeffs
  have h3 := value_ge
  linarith



