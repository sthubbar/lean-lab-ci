theorem r3Ten_polynomial_certificate :
    (∫ x in domain r3TenLo r3TenHi, r3TenPoly x) ≤ (962 / 100000 : ℝ) := by
  have he (x : Fin 3 → ℝ) :
      listEvalN r3TenTerms (fun j => x j - r3TenLo j) = r3TenPoly x := by
    rw [r3TenTerms_eval]
    congr 1
    funext j
    ring
  have h := integral_listEvalLast r3TenTerms
    (by norm_num : (25 / 89 : ℚ) ≤ 100 / 291) (by norm_num : (100 / 291 : ℚ) ≤ 100 / 291)
    (by norm_num : (100 / 291 : ℚ) ≤ 2 / 5)
  have hlo : Fin.snoc (fun _ : Fin 2 => (25 / 89 : ℝ)) (100 / 291) = r3TenLo := by
    ext j; fin_cases j <;> rfl
  have hhi : Fin.snoc (fun _ : Fin 2 => (100 / 291 : ℝ)) (2 / 5) = r3TenHi := by
    ext j; fin_cases j <;> rfl
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at h
  rw [hlo, hhi] at h
  simp only [he] at h
  rw [r3TenTerms_moment] at h
  push_cast at h
  apply h.le.trans
