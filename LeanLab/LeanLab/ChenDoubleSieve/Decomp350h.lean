/-- This geometric polynomial bounds the reciprocal in the needed direction.
Source: page 42 finite computation, derived finite geometric identity. -/
theorem reciprocal14_upper {t : ℝ} (ht : t ∈ Icc kappa1 kappa2) : 1 / t ≤ reciprocal14 t := by
  have ha : (0 : ℝ) < kappa1 := by norm_num [kappa1]
  have ht0 := ha.trans_le ht.1
  have he : reciprocal14 t * t = 1 + (1 - t / kappa2) ^ 8 * (t - kappa1) / kappa1 := by
    norm_num [reciprocal14, kappa1, kappa2, sum_range_succ]
    ring
  rw [div_le_iff₀ ht0, he]
  have hn := div_nonneg (mul_nonneg (by positivity : 0 ≤ (1 - t / kappa2) ^ 8)
    (sub_nonneg.mpr ht.1)) ha.le
  linarith

