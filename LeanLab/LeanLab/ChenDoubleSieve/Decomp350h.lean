Source: page 42 finite computation, derived finite geometric identity. -/
theorem reciprocalOne14_upper {t : ℝ} (ht : t ∈ Icc kappa1 (1 / 10 : ℝ)) :
    1 / (1 - t) ≤ reciprocalOne14 t := by
