/-- The exact rational endpoint of both polynomial integrals.
Source: page 42 finite computation, derived arithmetic data. -/
def endpoint14 : ℚ := 

/-- The rational polynomial endpoint is below the printed F14 bound.
Source: page 42 finite computation, derived arithmetic certificate. -/
theorem endpoint14_upper : endpoint14 ≤ (9143 / 50000 : ℚ) := by decide +kernel

/-- The inner polynomial integral is exactly its endpoint polynomial.
Source: page 42 finite quadrature, derived exact integral identity. -/
theorem innerPolynomial14_integral (t : ℝ) :
    (∫ s in t..kappa2, (280761 / 500000 : ℝ) * logPolynomial14 s *
      reciprocal14 s ^ 2 * (s - t)) = innerPolynomial14 t := by
  unfold innerPolynomial14
  apply integral_eq_sub_of_hasDerivAt (fun s hs => innerPrimitive14_deriv t s)
  apply Continuous.intervalIntegrable
  unfold logPolynomial14 reciprocal14
  fun_prop

/-- Both outer polynomial integrals have the exact rational endpoint.
Source: page 42 finite quadrature, derived exact integral identity. -/
theorem polynomial14_endpoint :
    36 / 5 * (∫ t in kappa1..(1 / 10 : ℝ),
      reciprocal14 t ^ 2 * reciprocalOne14 t * innerPolynomial14 t) +
    8 * (∫ t in (1 / 10 : ℝ)..kappa2, reciprocal14 t ^ 2 * innerPolynomial14 t) =
      (endpoint14 : ℝ) := by
  have h1 : (∫ t in kappa1..(1 / 10 : ℝ),
      reciprocal14 t ^ 2 * reciprocalOne14 t * innerPolynomial14 t) =
        primitive14First (1 / 10) - primitive14First kappa1 := by
    apply integral_eq_sub_of_hasDerivAt (fun t ht => primitive14First_deriv t)
    apply Continuous.intervalIntegrable
    unfold reciprocal14 reciprocalOne14 innerPolynomial14 innerPrimitive14
    fun_prop
  have h2 : (∫ t in (1 / 10 : ℝ)..kappa2, reciprocal14 t ^ 2 * innerPolynomial14 t) =
      primitive14Second kappa2 - primitive14Second (1 / 10) := by
    apply integral_eq_sub_of_hasDerivAt (fun t ht => primitive14Second_deriv t)
    apply Continuous.intervalIntegrable
    unfold reciprocal14 innerPolynomial14 innerPrimitive14
    fun_prop
  rw [h1, h2]
  norm_num [primitive14First, primitive14Second, endpoint14, kappa1, kappa2]

/-- Positive reciprocal and logarithm enclosures dominate the full F14 kernel.
Source: page 42 finite quadrature, derived polynomial comparison. -/
theorem twofold14_polynomial_upper {a b : ℝ} {weight extra : ℝ → ℝ}
    (hab : a ≤ b) (ha : kappa1 ≤ a) (hb : b ≤ kappa2)
    (hE : ContinuousOn extra (Icc a b)) (hE0 : ∀ t ∈ Icc a b, 0 ≤ extra t)
    (hW0 : ∀ t ∈ Icc a b, 0 < weight t)
    (hW : ∀ t ∈ Icc a b, 1 / weight t ≤ reciprocal14 t * extra t) :
    twofoldMajorant (280761 / 500000) (fun _ => kappa2)
      (fun s => 1 / 2 - 2 * kappa1 - s) a b weight ≤
      ∫ t in a..b, reciprocal14 t ^ 2 * extra t * innerPolynomial14 t := by
  have hk0 : (0 : ℝ) < kappa1 := by norm_num [kappa1]
  have hdom : ∀ t ∈ Icc a b, t ∈ Icc kappa1 kappa2 :=
    fun t ht => ⟨ha.trans ht.1, ht.2.trans hb⟩
  have hinner0 : ∀ t ∈ Icc a b, ∀ s ∈ Icc t kappa2,
      0 ≤ (280761 / 500000 : ℝ) * log ((1 / 2 - 2 * kappa1 - s) / kappa2) / s *
        (1 / t - 1 / s) := by
    intro t ht s hs
    have ht0 := hk0.trans_le (hdom t ht).1
    have hs0 := ht0.trans_le hs.1
    have hsdom : s ∈ Icc kappa1 kappa2 := ⟨(hdom t ht).1.trans hs.1, hs.2⟩
    apply mul_nonneg
    · exact div_nonneg (mul_nonneg (by norm_num) (F14_log_nonneg hsdom)) hs0.le
    · exact sub_nonneg.mpr (one_div_le_one_div_of_le ht0 hs.1)
  unfold twofoldMajorant
  apply interval_integral_le_of_nonneg hab
  · intro t ht
    exact div_nonneg (integral_nonneg (hdom t ht).2 (hinner0 t ht)) (hW0 t ht).le
  · apply ContinuousOn.intervalIntegrable
    rw [uIcc_of_le hab]
    have hi : Continuous innerPolynomial14 := by unfold innerPolynomial14 innerPrimitive14; fun_prop
    have hr : Continuous reciprocal14 := by unfold reciprocal14; fun_prop
    exact ((hr.continuousOn.pow 2).mul hE).mul hi.continuousOn
  · intro t ht
    dsimp only
    rw [← intervalIntegral.integral_div]
    have hbound : (∫ s in t..kappa2,
        ((280761 / 500000 : ℝ) * log ((1 / 2 - 2 * kappa1 - s) / kappa2) / s *
          (1 / t - 1 / s)) / weight t) ≤
        ∫ s in t..kappa2, (reciprocal14 t ^ 2 * extra t) *
          ((280761 / 500000 : ℝ) * logPolynomial14 s * reciprocal14 s ^ 2 * (s - t)) := by
      apply interval_integral_le_of_nonneg (hdom t ht).2
      · intro s hs
        exact div_nonneg (hinner0 t ht s hs) (hW0 t ht).le
      · apply Continuous.intervalIntegrable
        unfold logPolynomial14 reciprocal14
        fun_prop
      · intro s hs
        have ht0 := hk0.trans_le (hdom t ht).1
        have hs0 := ht0.trans_le hs.1
        have hsdom : s ∈ Icc kappa1 kappa2 := ⟨(hdom t ht).1.trans hs.1, hs.2⟩
        have hlog0 := F14_log_nonneg hsdom
        have hlog := logPolynomial14_upper hsdom
        have hlogP0 : 0 ≤ logPolynomial14 s := hlog0.trans hlog
        have hrt := reciprocal14_upper (hdom t ht)
        have hrs := reciprocal14_upper hsdom
        have hrt0 : 0 ≤ reciprocal14 t := (one_div_nonneg.mpr ht0.le).trans hrt
        have hrs0 : 0 ≤ reciprocal14 s := (one_div_nonneg.mpr hs0.le).trans hrs
        have hextra0 := hE0 t ht
        have hweight := hW t ht
        have hweight0 := hW0 t ht
        have hst : 0 ≤ s - t := sub_nonneg.mpr hs.1
        calc
          _ = (280761 / 500000 : ℝ) * log ((1 / 2 - 2 * kappa1 - s) / kappa2) *
              (s - t) * (1 / s) ^ 2 * (1 / t) * (1 / weight t) := by
            field_simp [ht0.ne', hs0.ne', hweight0.ne']
            <;> ring
          _ ≤ (280761 / 500000 : ℝ) * logPolynomial14 s *
              (s - t) * reciprocal14 s ^ 2 * reciprocal14 t * (reciprocal14 t * extra t) := by
            gcongr
          _ = _ := by ring
    rw [intervalIntegral.integral_const_mul, innerPolynomial14_integral] at hbound
    exact hbound

/-- The elementary F14 logarithmic quadrature has a clean rational certificate.
Source: page 42 final numerical display after page 41 equation 10.12. -/
theorem F14_elementary_upper_clean :
    36 / 5 * twofoldMajorant (280761 / 500000) (fun _ => kappa2)
      (fun s => 1 / 2 - 2 * kappa1 - s) kappa1 (1 / 10) (fun t => t * (1 - t)) +
    8 * twofoldMajorant (280761 / 500000) (fun _ => kappa2)
      (fun s => 1 / 2 - 2 * kappa1 - s) (1 / 10) kappa2 id ≤ 0.182860 := by
  have hk0 : (0 : ℝ) < kappa1 := by norm_num [kappa1]
  have hfirst := twofold14_polynomial_upper (a := kappa1) (b := (1 / 10 : ℝ))
    (weight := fun t => t * (1 - t)) (extra := reciprocalOne14)
    (by norm_num [kappa1]) le_rfl (by norm_num [kappa2])
    (by unfold reciprocalOne14; fun_prop)
    (by
      intro t ht
      exact (one_div_nonneg.mpr (by linarith [ht.2])).trans (reciprocalOne14_upper ht))
    (by intro t ht; apply mul_pos (hk0.trans_le ht.1); linarith [ht.2])
    (by
      intro t ht
      have ht0 := hk0.trans_le ht.1
      have ht1 : 0 < 1 - t := by linarith [ht.2]
      have htfull : t ∈ Icc kappa1 kappa2 := ⟨ht.1, ht.2.trans (by norm_num [kappa2])⟩
      have he : (1 : ℝ) / (t * (1 - t)) = (1 / t) * (1 / (1 - t)) := by
        field_simp
      rw [he]
      exact mul_le_mul (reciprocal14_upper htfull) (reciprocalOne14_upper ht)
        (one_div_nonneg.mpr ht1.le)
        ((one_div_nonneg.mpr ht0.le).trans (reciprocal14_upper htfull)))
  have hsecond := twofold14_polynomial_upper (a := (1 / 10 : ℝ)) (b := kappa2)
    (weight := id) (extra := fun _ => 1)
    (by norm_num [kappa2]) (by norm_num [kappa1]) le_rfl (by fun_prop) (by intros; norm_num)
    (by intro t ht; dsimp; linarith [ht.1])
    (by
      intro t ht
      simpa using reciprocal14_upper
        (show t ∈ Icc kappa1 kappa2 from ⟨(by norm_num [kappa1] : kappa1 ≤ (1 / 10 : ℝ)).trans ht.1, ht.2⟩))
  have hc0 := (Rat.cast_le (K := ℝ)).2 endpoint14_upper
  have hc : (endpoint14 : ℝ) ≤ (0.182860 : ℝ) := by convert hc0 using 1 <;> norm_num
  simp only [mul_one] at hsecond
  linarith only [hfirst, hsecond, polynomial14_endpoint, hc]

