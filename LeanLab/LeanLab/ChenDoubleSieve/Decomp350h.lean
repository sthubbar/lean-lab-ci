/-- Positive geometric upper polynomial for the reciprocal on the printed range.
Source: page 42 finite computation, derived certificate data. -/
def reciprocal14 (t : ℝ) : ℝ :=
  ((∑ j ∈ range 8, (1 - t / kappa2) ^ j) +
