/-- A polynomial upper bound for the logarithm in the F14 inner integral.
Source: page 42 finite computation, derived positive logarithm series. -/
def logPolynomial14 (s : ℝ) : ℝ := (logConstant14 : ℝ) -
  ∑ j ∈ range 6, (4 * (s - kappa1)) ^ (j + 1) / (j + 1)

/-- The polynomial bounds the actual F14 logarithm from above.
Source: page 42 finite computation, derived positive logarithm series. -/
theorem logPolynomial14_upper {s : ℝ} (hs : s ∈ Icc kappa1 kappa2) :
    log ((1 / 2 - 2 * kappa1 - s) / kappa2) ≤ logPolynomial14 s := by
  have hx0 : 0 ≤ 4 * (s - kappa1) := by linarith [hs.1]
  have hx1 : 4 * (s - kappa1) < 1 := by norm_num [kappa1, kappa2] at hs ⊢; linarith [hs.2]
  have hh := hasSum_pow_div_log_of_abs_lt_one (x := 4 * (s - kappa1)) (by rwa [abs_of_nonneg hx0])
  have hlo := Summable.sum_le_tsum (range 6)
    (fun j hj => div_nonneg (pow_nonneg hx0 (j + 1)) (by positivity)) hh.summable
  rw [hh.tsum_eq] at hlo
  have he : (1 / 2 - 2 * kappa1 - s) / kappa2 =
      (125 / 58 : ℝ) * (1 - 4 * (s - kappa1)) := by norm_num [kappa1, kappa2]; ring
  rw [he, log_mul (by norm_num : (125 / 58 : ℝ) ≠ 0) (by linarith : 1 - 4 * (s - kappa1) ≠ 0)]
  unfold logPolynomial14
  linarith [logConstant14_upper]

/-- The F14 logarithm is positive throughout the printed interval.
Source: page 41 equation 10.12, derived domain check. -/
theorem F14_log_nonneg {s : ℝ} (hs : s ∈ Icc kappa1 kappa2) :
    0 ≤ log ((1 / 2 - 2 * kappa1 - s) / kappa2) := by
  apply log_nonneg
  rw [le_div_iff₀ (by norm_num [kappa2] : (0 : ℝ) < kappa2)]
  norm_num [kappa1, kappa2] at hs ⊢
  linarith [hs.2]

