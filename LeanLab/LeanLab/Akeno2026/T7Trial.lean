def KL (k : ℕ) : ℕ := tKL.getD k 0
def KU (k : ℕ) : ℕ := tKU.getD k 0

def chkK (k : ℕ) : Bool :=
  decide (KL (k + 1) * ((2 * (1519 - k) + 1) * (k - 160 + 1)) ≤
    KL k * ((2 * (1519 - k) + 1) * (k - 160 + 1)) + 2 * Grid160.cL6 k * (k - 160 + 1) + Grid160.cL5 (k - 160)) &&
  decide (KU k * (2 * (1519 - k) * (1519 - k + 1) * (k - 160)) +
    Grid160.cU6 k * (2 * (1519 - k) + 1) * (k - 160) + Grid160.cU5 (k - 160 + 1) * (1519 - k + 1) ≤
    KU (k + 1) * (2 * (1519 - k) * (1519 - k + 1) * (k - 160)))

theorem chk_K : ∀ k < 1472, 1360 ≤ k → chkK k = true := by decide +kernel

theorem tab_K_base : KL 1360 = 0 ∧ KU 1360 = 0 := by decide +kernel

theorem K_TB : ∀ k, 1360 ≤ k → k ≤ 1472 → TB Kfun 160 10000000000 KL KU k := by
  intro k hk
  induction k, hk using Nat.le_induction with
  | base =>
    intro _
    unfold TB Kfun; rw [tab_K_base.1, tab_K_base.2]; norm_num
  | succ k hk ih =>
    intro hkN
    have hgk := ih (by omega)
    have c := chk_K k (by omega) hk
    simp only [chkK, Bool.and_eq_true, decide_eq_true_eq] at c
    obtain ⟨c1, c2⟩ := c
    obtain ⟨j, hj⟩ : ∃ j, j = k - 160 := ⟨_, rfl⟩
    obtain ⟨n, hn⟩ : ∃ n, n = 1519 - k := ⟨_, rfl⟩
    rw [← hj, ← hn] at c1 c2
    have hkj : k = j + 160 := by omega
    have hkn : 1520 = k + n + 1 := by omega
    have hMr : (0 : ℝ) < (160 : ℕ) := by norm_num
