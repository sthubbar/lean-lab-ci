theorem TB_c5 (k : ℕ) (h1 : 200 ≤ k) (h2 : k ≤ 410) : TB (cR 5) 40 1000000000 cL5 cU5 k := by
  refine level_ind (f := cR 4) (e := cR 3) (Lf := cL4) (Uf := cU4) (Le := cL3) (Ue := cU3) (N := 410)
