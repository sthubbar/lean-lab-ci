/-- The constant table `10⁹` for `c₁ = 1` on `[1, ∞)`. -/
def cD (_ : ℕ) : ℕ := 1000000000

theorem chk_c2 : ∀ k < 300, 80 ≤ k →
    chkLc (cL2 (k + 1)) (cL2 k) (cD (k - 40)) (k - 40) = true ∧
    chkUc (cU2 (k + 1)) (cU2 k) (cD (k - 40)) (k - 40) = true := by decide +kernel

