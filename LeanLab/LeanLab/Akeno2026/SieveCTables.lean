/-! ### `T₅` for Kuhn's weight -/

/-- `T₅ = T₅,₀ + T₅,₁` as given on page 36 for Kuhn's weight:
`c₅(t) + (t/2) ∫_{t-1}^{t(1-1/s)} c₄(u)/(u(t-u)) du`. That this equals the simplex integral `T₅`
of page 32 is the paper's reduction via (44), not proved here. -/
noncomputable def T5kuhn (s t : ℝ) : ℝ :=
  cR 5 t + t / 2 * ∫ u in (t - 1)..(t * (1 - 1 / s)), cR 4 u / (u * (t - u))

/-- `K(x) = ∫_{t-1}^x c₄(u)/(t-u) du` at `t = 9.5`. -/
noncomputable def Kfun (x : ℝ) : ℝ := ∫ u in (19 / 2 - 1 : ℝ)..x, cR 4 u * (19 / 2 - u)⁻¹

theorem c4_refl_integrable {p q : ℝ} (hpq : p ≤ q) (hq : q < 19 / 2) :
    IntervalIntegrable (fun u => cR 4 u * (19 / 2 - u)⁻¹) volume p q := by
  have hc : ContinuousOn (fun u : ℝ => (19 / 2 - u)⁻¹) (uIcc p q) := by
    apply ContinuousOn.inv₀ (by fun_prop)
    intro u hu; rw [uIcc_of_le hpq] at hu; linarith [hu.2]
  exact ((cR_mono_nonneg 4).1.monotoneOn _ |>.intervalIntegrable).mul_continuousOn hc

theorem Kfun_delay {a b : ℝ} (ha : 19 / 2 - 1 ≤ a) (hab : a ≤ b) (hb : b < 19 / 2) :
    Kfun b - Kfun a = ∫ u in a..b, cR 4 u * (19 / 2 - u)⁻¹ := by
  unfold Kfun
  rw [intervalIntegral.integral_interval_sub_left (c4_refl_integrable (ha.trans hab) hb)
    (c4_refl_integrable ha (by linarith))]

set_option maxHeartbeats 1000000 in
/-- One grid step of `K`, `a = K/M`, `b = (K+1)/M`, `t = T/M` with `T = K + n + 1`, `K = J + M`. -/
theorem kgrid_step {G f e : ℝ → ℝ} {M J K n T D Gl Gu Lf Uf Le Ue Gl' Gu' : ℝ}
    (hM : 0 < M) (hK : K = J + M) (hJ0 : 0 < J) (hT : T = K + n + 1) (hn0 : 0 < n) (hD : 0 < D)
    (hdel : G ((K + 1) / M) - G (K / M) = ∫ u in K / M..(K + 1) / M, f u * (T / M - u)⁻¹)
    (hdelf : ∀ x ∈ Icc (K / M) ((K + 1) / M), f x - f (K / M) = ∫ v in K / M..x, e (v - 1) / (v - 1))
    (hfm : MonotoneOn f (Icc (K / M) ((K + 1) / M)))
    (hem : MonotoneOn e (Icc (J / M) ((J + 1) / M)))
    (hg : Gl / D ≤ G (K / M) ∧ G (K / M) ≤ Gu / D)
    (hf : Lf / D ≤ f (K / M) ∧ f (K / M) ≤ Uf / D)
    (he : Le / D ≤ e (J / M) ∧ e ((J + 1) / M) ≤ Ue / D) (hLf : 0 ≤ Lf) (hLe : 0 ≤ Le)
    (cL : Gl' * ((2 * n + 1) * (J + 1)) ≤ Gl * ((2 * n + 1) * (J + 1)) + 2 * Lf * (J + 1) + Le)
    (cU : Gu * (2 * n * (n + 1) * J) + Uf * (2 * n + 1) * J + Ue * (n + 1) ≤
      Gu' * (2 * n * (n + 1) * J)) :
    Gl' / D ≤ G ((K + 1) / M) ∧ G ((K + 1) / M) ≤ Gu' / D := by
  have hab : K / M ≤ (K + 1) / M := div_le_div_of_nonneg_right (by linarith) hM.le
  have hbt : (K + 1) / M < T / M := div_lt_div_of_pos_right (by linarith) hM
  have ep : K / M - 1 = J / M := by rw [hK]; field_simp; ring
  have eq : (K + 1) / M - 1 = (J + 1) / M := by rw [hK]; field_simp; ring
  have hp : 1 < K / M := by rw [lt_div_iff₀ hM]; linarith
  have he0 : 0 ≤ e (J / M) := le_trans (div_nonneg hLe hD.le) he.1
  have hinc := incr hp hab hdelf (by rw [ep, eq]; exact hem) (by rw [ep]; exact he0)
  rw [ep, eq] at hinc
  obtain ⟨hW, hV⟩ := weight_refl hab hbt
  have hn' : n ≠ 0 := hn0.ne'
  have hy : (T / M - K / M) / (T / M - (K + 1) / M) = (n + 1) / n := by
    rw [hT]
    have h1 : (K + n + 1) / M - K / M = (n + 1) / M := by field_simp; ring
    have h2 : (K + n + 1) / M - (K + 1) / M = n / M := by field_simp; ring
    rw [h1, h2]; field_simp
  rw [hy] at hW hV
  obtain ⟨hΛL, hΛU⟩ := log_grid_bounds hn0
  have hta : T / M - K / M = (n + 1) / M := by rw [hT]; field_simp; ring
  have hba : (K + 1) / M - K / M = 1 / M := by field_simp; ring
  rw [hta, hba] at hV
  have hfi : IntervalIntegrable (fun u => f u * (T / M - u)⁻¹) volume (K / M) ((K + 1) / M) := by
    have hc : ContinuousOn (fun u : ℝ => (T / M - u)⁻¹) (uIcc (K / M) ((K + 1) / M)) := by
      apply ContinuousOn.inv₀ (by fun_prop)
      intro u hu; rw [uIcc_of_le hab] at hu; linarith [hu.2]
    have hfm' : MonotoneOn f (uIcc (K / M) ((K + 1) / M)) := by rwa [uIcc_of_le hab]
    exact (hfm'.intervalIntegrable (μ := volume)).mul_continuousOn hc
  have hw0 : ∀ u ∈ Icc (K / M) ((K + 1) / M), 0 ≤ (T / M - u)⁻¹ :=
    fun u hu => inv_nonneg.mpr (by linarith [hu.2])
  have hwc : ContinuousOn (fun u : ℝ => (T / M - u)⁻¹) (Icc (K / M) ((K + 1) / M)) := by
    apply ContinuousOn.inv₀ (by fun_prop)
    intro u hu; linarith [hu.2]
  have hlo : ∀ u ∈ Icc (K / M) ((K + 1) / M),
      Lf / D + (Le / D / ((J + 1) / M)) * (u - K / M) ≤ f u := by
    intro u hu
    have h1 := (hinc u hu).1
    have hd : Le / D / ((J + 1) / M) ≤ e (J / M) / ((J + 1) / M) :=
      div_le_div_of_nonneg_right he.1 (by positivity)
    have hu0 : 0 ≤ u - K / M := by linarith [hu.1]
    linarith [mul_le_mul_of_nonneg_left hd hu0, hf.1]
  have hhi : ∀ u ∈ Icc (K / M) ((K + 1) / M),
      f u ≤ Uf / D + (Ue / D / (J / M)) * (u - K / M) := by
    intro u hu
    have h1 := (hinc u hu).2
    have hd : e ((J + 1) / M) / (J / M) ≤ Ue / D / (J / M) :=
      div_le_div_of_nonneg_right he.2 (by positivity)
    have hu0 : 0 ≤ u - K / M := by linarith [hu.1]
    linarith [mul_le_mul_of_nonneg_left hd hu0, hf.2]
  obtain ⟨s1, s2⟩ := wstep hab hfi hw0 hwc hW hV hlo hhi
  rw [← hdel] at s1 s2
  have hUf : 0 ≤ Uf / D := le_trans (div_nonneg hLf hD.le) (hf.1.trans hf.2)
  have hUe : 0 ≤ Ue / D := le_trans he0 (le_trans (hem ⟨le_rfl, by
      rw [div_le_div_iff_of_pos_right hM]; linarith⟩ ⟨by rw [div_le_div_iff_of_pos_right hM]; linarith,
      le_rfl⟩ (by rw [div_le_div_iff_of_pos_right hM]; linarith)) he.2)
  have hn1 : 0 ≤ (n + 1) / M := by positivity
  have hLfD : 0 ≤ Lf / D := div_nonneg hLf hD.le
  have hdlo : 0 ≤ Le / D / ((J + 1) / M) := by positivity
  have hdhi : 0 ≤ Ue / D / (J / M) := by positivity
  constructor
  · have hV1 : -(1 / M) + (n + 1) / M * (2 / (2 * n + 1)) ≤ -(1 / M) + (n + 1) / M * log ((n + 1) / n) :=
      by linarith [mul_le_mul_of_nonneg_left hΛL hn1]
    have e1 : Gl / D + Lf / D * (2 / (2 * n + 1)) + Le / D / ((J + 1) / M) *
        (-(1 / M) + (n + 1) / M * (2 / (2 * n + 1))) =
        (Gl * ((2 * n + 1) * (J + 1)) + 2 * Lf * (J + 1) + Le) / (D * ((2 * n + 1) * (J + 1))) := by
      field_simp; ring
    have e2 : Gl' / D = Gl' * ((2 * n + 1) * (J + 1)) / (D * ((2 * n + 1) * (J + 1))) := by
      field_simp
    have : Gl' / D ≤ Gl / D + Lf / D * (2 / (2 * n + 1)) + Le / D / ((J + 1) / M) *
        (-(1 / M) + (n + 1) / M * (2 / (2 * n + 1))) := by
      rw [e1, e2]; exact div_le_div_of_nonneg_right cL (by positivity)
    linarith [mul_le_mul_of_nonneg_left hΛL hLfD, mul_le_mul_of_nonneg_left hV1 hdlo, hg.1]
  · have hV1 : -(1 / M) + (n + 1) / M * log ((n + 1) / n) ≤
        -(1 / M) + (n + 1) / M * ((2 * n + 1) / (2 * n * (n + 1))) :=
      by linarith [mul_le_mul_of_nonneg_left hΛU hn1]
    have e1 : Gu / D + Uf / D * ((2 * n + 1) / (2 * n * (n + 1))) + Ue / D / (J / M) *
        (-(1 / M) + (n + 1) / M * ((2 * n + 1) / (2 * n * (n + 1)))) =
        (Gu * (2 * n * (n + 1) * J) + Uf * (2 * n + 1) * J + Ue * (n + 1)) /
          (D * (2 * n * (n + 1) * J)) := by
      field_simp; ring
    have e2 : Gu' / D = Gu' * (2 * n * (n + 1) * J) / (D * (2 * n * (n + 1) * J)) := by
      field_simp
    have : Gu / D + Uf / D * ((2 * n + 1) / (2 * n * (n + 1))) + Ue / D / (J / M) *
        (-(1 / M) + (n + 1) / M * ((2 * n + 1) / (2 * n * (n + 1)))) ≤ Gu' / D := by
      rw [e1, e2]; exact div_le_div_of_nonneg_right cU (by positivity)
    linarith [mul_le_mul_of_nonneg_left hΛU hUf, mul_le_mul_of_nonneg_left hV1 hdhi, hg.2]

end LeanLab.Akeno2026.SieveFns
