/-- Step checks for `K`, `j = k - 160`, `n = 1519 - k`. -/
def chkK (k : ℕ) : Bool :=
  decide (KL (k + 1) * ((2 * (1519 - k) + 1) * (k - 160 + 1)) ≤
    KL k * ((2 * (1519 - k) + 1) * (k - 160 + 1)) + 2 * Grid160.cL5 k * (k - 160 + 1) + Grid160.cL4 (k - 160)) &&
  decide (KU k * (2 * (1519 - k) * (1519 - k + 1) * (k - 160)) +
    Grid160.cU5 k * (2 * (1519 - k) + 1) * (k - 160) + Grid160.cU4 (k - 160 + 1) * (1519 - k + 1) ≤
    KU (k + 1) * (2 * (1519 - k) * (1519 - k + 1) * (k - 160)))

