noncomputable def T6kuhn (s t : ℝ) : ℝ :=
  cR 6 t + t / 2 * ∫ u in (t - 1)..(t * (1 - 1 / s)), cR 5 u / (u * (t - u))

/-- `K(x) = ∫_{t-1}^x c₅(u)/(t-u) du` at `t = 9.5`. -/
noncomputable def Kfun (x : ℝ) : ℝ := ∫ u in (19 / 2 - 1 : ℝ)..x, cR 5 u * (19 / 2 - u)⁻¹

theorem c5_refl_integrable {p q : ℝ} (hpq : p ≤ q) (hq : q < 19 / 2) :
    IntervalIntegrable (fun u => cR 5 u * (19 / 2 - u)⁻¹) volume p q := by
  have hc : ContinuousOn (fun u : ℝ => (19 / 2 - u)⁻¹) (uIcc p q) := by
    apply ContinuousOn.inv₀ (by fun_prop)
    intro u hu; rw [uIcc_of_le hpq] at hu; linarith [hu.2]
  exact ((cR_mono_nonneg 5).1.monotoneOn _ |>.intervalIntegrable).mul_continuousOn hc

theorem Kfun_delay {a b : ℝ} (ha : 19 / 2 - 1 ≤ a) (hab : a ≤ b) (hb : b < 19 / 2) :
    Kfun b - Kfun a = ∫ u in a..b, cR 5 u * (19 / 2 - u)⁻¹ := by
  unfold Kfun
  rw [intervalIntegral.integral_interval_sub_left (c5_refl_integrable (ha.trans hab) hb)
    (c5_refl_integrable ha (by linarith))]

