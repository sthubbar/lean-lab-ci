theorem certs_ok : C.all LeanLab.Saouter1998.Core.certB = true := by
  simp only [C, List.all_append, ok1, ok2, ok3, ok4, ok5, ok6, ok7, ok8, ok9, ok10, Bool.and_self]

theorem certs_match : C.map Prod.fst = Dall.map (fun d => Bq - d) := by decide +kernel

theorem Dall_le : ∀ d ∈ Dall, d ≤ Bq := by decide +kernel

theorem Dall_prime : ∀ d ∈ Dall, d ≤ Bq ∧ (Bq - d).Prime := by
  intro d hd
  refine ⟨Dall_le d hd, ?_⟩
  have h := LeanLab.Saouter1998.all_prime_of_certs certs_ok
  have hm : Bq - d ∈ C.map Prod.fst := by
    rw [certs_match]; exact List.mem_map.mpr ⟨d, hd, rfl⟩
  exact h _ hm

theorem sub_Dall {Ds : List ℕ} (h : Ds.all (fun d => Dall.contains d) = true) :
    ∀ d ∈ Ds, d ≤ Bq ∧ (Bq - d).Prime := by
  intro d hd
  have := List.all_eq_true.mp h d hd
  exact Dall_prime d (by simpa using this)

