/-
DESIGN QUEUE DQ3 and Q2, run 20261120T0802Z-11103, lean architect.
P0037, Deshouillers, te Riele and Saouter 1998, Theorem 2 page 206,
Section 5.2 page 212 and Table 2 page 214.

DECISION. The eleven Table 2 rows log10 B = 200, 210, ..., 300 are cited
computations: page 212 and Table 2 print only Nq and the timings, the prime
lists were generated by sieving plus strong pseudoprime tests and certified
by ECPP, and no list or certificate is printed. The DQ3 pilot on row 200,
Codex task654 and task654b, PR 1915, proved 172 coverage windows with no new
sorry, which confirms the cut is sound, but it reached only j up to 3,790,000
of the 500,000,001 offsets of one row in about five hours of prover time, so
the eleven rows would need over a thousand times that. The rows therefore
become one named hypothesis, DtRSTable2Hyp, of a conditional entry for
Theorem 2, and the coverage lanes stop.

Q2, the FALSE flag on table2_row_30, is not confirmed: the flag concerns the
lab sub-leaf leaf_batch2_block7 and only if a count is taken before the
Miller-Rabin filter; the row statement matches Table 2, Nq = 227. The rows
enter only as the hypothesis below, never as proved.

AI wrote the Lean code. Binary Goldbach is open.
-/
import LeanLab.DtRS1998.Decomp121bSecond

namespace LeanLab.DtRS1998.DQ3

open LeanLab Task71.Paper

/-- P0037 Table 2 page 214, one row: a list of at most `Nq` primes such that
every even number `B + 2 j`, `0 ≤ j ≤ 10^9 / 2`, is `q` plus a prime for some
`q` in the list. Word for word the body of `Decomp500a.table2_row_k`. -/
def Table2RowCert (B Nq : ℕ) : Prop :=
  ∃ qs : List ℕ, qs.length ≤ Nq ∧ (∀ q ∈ qs, q.Prime) ∧
    (List.range (10 ^ 9 / 2 + 1)).all (fun j =>
      qs.any (fun q => decide (q ≤ B + 2 * j ∧ (B + 2 * j - q).Prime))) = true

/-- P0037 Table 2 page 214, the printed column Nq, rows log10 B = 10 i. -/
def nqTable2 : ℕ → ℕ
  | 20 => 224 | 21 => 222 | 22 => 222 | 23 => 228 | 24 => 228 | 25 => 231
  | 26 => 226 | 27 => 223 | 28 => 225 | 29 => 226 | 30 => 227 | _ => 0

/-- NAMED HYPOTHESIS, cited computation. P0037 Section 5.2 page 212 and
Table 2 page 214: for each row i = 20 to 30 the certified list exists with the
printed Nq. -/
def DtRSTable2Hyp : Prop :=
  ∀ i : ℕ, 20 ≤ i → i ≤ 30 → Table2RowCert (10 ^ (10 * i)) (nqTable2 i)

/-- Twin check, row 200: the hypothesis row is the sealed leaf statement. -/
theorem row20_twin :
    Table2RowCert (10 ^ (10 * 20)) (nqTable2 20) ↔
      ∃ qs : List ℕ, qs.length ≤ 224 ∧ (∀ q ∈ qs, q.Prime) ∧
        (List.range (10 ^ 9 / 2 + 1)).all (fun j =>
          qs.any (fun q => decide
            (q ≤ 10 ^ 200 + 2 * j ∧ (10 ^ 200 + 2 * j - q).Prime))) = true := 
  Iff.rfl

/-- Twin check, row 300, the Q2 row. -/
theorem row30_twin :
    Table2RowCert (10 ^ (10 * 30)) (nqTable2 30) ↔
      ∃ qs : List ℕ, qs.length ≤ 227 ∧ (∀ q ∈ qs, q.Prime) ∧
        (List.range (10 ^ 9 / 2 + 1)).all (fun j =>
          qs.any (fun q => decide
            (q ≤ 10 ^ 300 + 2 * j ∧ (10 ^ 300 + 2 * j - q).Prime))) = true := 
  Iff.rfl

/-- The sealed leaves imply the hypothesis, so the hypothesis asks no more than
the eleven leaves did. CONDITIONAL on Decomp500a.table2_row_20 to 30. -/
theorem hyp_of_leaves : DtRSTable2Hyp := by
  intro i hlo hhi
  interval_cases i
  · exact Decomp500a.table2_row_20
  · exact Decomp500a.table2_row_21
  · exact Decomp500a.table2_row_22
  · exact Decomp500a.table2_row_23
  · exact Decomp500a.table2_row_24
  · exact Decomp500a.table2_row_25
  · exact Decomp500a.table2_row_26
  · exact Decomp500a.table2_row_27
  · exact Decomp500a.table2_row_28
  · exact Decomp500a.table2_row_29
  · exact Decomp500a.table2_row_30

/-- P0037 Theorem 2 page 206, second family, the exact statement of
`Decomp121b.second_family`, from the named hypothesis alone.
CONDITIONAL ON DtRSTable2Hyp; no sorry. -/
theorem second_family_of_table2_hyp (h : DtRSTable2Hyp) :
    ∀ i : ℕ, 20 ≤ i → i ≤ 30 → IntervalSum (10 ^ (10 * i)) (10 ^ 9) := by
  intro i hlo hhi
  obtain ⟨qs, _, hq, hc⟩ := h i hlo hhi
  exact Decomp121bSecond.interval_of_table2_certificate
    (Decomp121bSecond.table2_base_even i (by omega)) hq hc

/-- Vacuity guard: the hypothesis is not one false row in disguise, its Nq
values are exactly the printed ones, all within the page 212 range 222 to 231. -/
theorem nqTable2_range : ∀ i : ℕ, 20 ≤ i → i ≤ 30 →
    222 ≤ nqTable2 i ∧ nqTable2 i ≤ 231 := by
  intro i hlo hhi
  interval_cases i <;> simp [nqTable2]

end LeanLab.DtRS1998.DQ3

#print axioms LeanLab.DtRS1998.DQ3.row20_twin
#print axioms LeanLab.DtRS1998.DQ3.row30_twin
#print axioms LeanLab.DtRS1998.DQ3.second_family_of_table2_hyp
#print axioms LeanLab.DtRS1998.DQ3.nqTable2_range
#print axioms LeanLab.DtRS1998.DQ3.hyp_of_leaves
