      qs.any (fun q => decide (q ≤ 10^80 + 2*j ∧ (10^80 + 2*j - q).Prime))) = true :=
  offsets_certificate offset_bounds all_offsets

theorem certificate :
    ∃ qs : List ℕ, qs.length ≤ 206 ∧
      (∀ q ∈ qs, q.Prime ∧ 10 ^ 80 - 56907 ≤ q ∧ q ≤ 10 ^ 80) ∧
      (List.range (10 ^ 8 / 2 + 1)).all (fun j =>
        qs.any (fun q => decide
          (q ≤ 10 ^ 80 + 2 * j ∧ (10 ^ 80 + 2 * j - q).Prime))) = true := by
  exact ⟨qs, length_bound, fun q hq => ⟨all_primes q hq, bounds q hq⟩, coverage⟩

