          exact U6828.not_prime_of (d := 2) (by norm_num) (by norm_num) (by norm_num) hp)
        exact U6828.T40.row.2.2.2.1 p (by omega) hlt hp
      exact ⟨⟨h1, hpb⟩, hp⟩
    · rintro ⟨⟨h1, h2⟩, hp⟩
      exact ⟨⟨h1, by omega⟩, hp⟩
  rw [heq]
  exact count_300

