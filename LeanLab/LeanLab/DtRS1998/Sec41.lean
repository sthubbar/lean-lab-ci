import Mathlib
import LeanLab.Verifications.Pratt

namespace LeanLab.DtRS1998.Sec41

open LeanLab.Verifications.Pratt

/-- Walk `k` numbers from `m`; for each odd one, the head of `L` is `(0, d)`, `d` a proper
divisor of the number, or `(1, d)`, `d` a proper divisor of `e` minus it. -/
def chk (e : ℕ) : ℕ → ℕ → List (ℕ × ℕ) → Bool
  | _, 0, _ => true
  | m, k + 1, L =>
    if m % 2 = 0 then chk e (m + 1) k L else
    match L with
    | [] => false
    | (w, d) :: t =>
      (1 < d && d < (if w = 0 then m else e - m) && (if w = 0 then m else e - m) % d == 0) &&
        chk e (m + 1) k t

lemma not_prime_of {t d : ℕ} (h1 : 1 < d) (h2 : d < t) (h3 : t % d = 0) : ¬ t.Prime := by
  intro hp
  have := (Nat.prime_def.mp hp).2 d (Nat.dvd_of_mod_eq_zero h3)
  omega

theorem chk_sound (e : ℕ) : ∀ k m L, 3 ≤ m → chk e m k L = true →
    ∀ x, m ≤ x → x < m + k → x.Prime → ¬ (e - x).Prime := by
  intro k
  induction k with
  | zero => intro m L _ _ x h1 h2; omega
  | succ k ih =>
    intro m L hm h x h1 h2 hx
    unfold chk at h
    by_cases hev : m % 2 = 0
    · rw [if_pos hev] at h
      by_cases hxm : x = m
      · subst hxm
        exfalso
        have := hx.eq_one_or_self_of_dvd 2 (Nat.dvd_of_mod_eq_zero hev); omega
      · exact ih (m + 1) L (by omega) h x (by omega) (by omega) hx
    · rw [if_neg hev] at h
      match L, h with
      | (w, d) :: t, h =>
        simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
        obtain ⟨⟨⟨hd1, hd2⟩, hd3⟩, hrest⟩ := h
        by_cases hxm : x = m
        · subst hxm
          by_cases hw : w = 0
          · simp only [hw, if_true] at hd2 hd3
            exact absurd hx (not_prime_of hd1 hd2 hd3)
          · simp only [hw, if_false] at hd2 hd3
            exact not_prime_of hd1 hd2 hd3
        · exact ih (m + 1) t (by omega) hrest x (by omega) (by omega) hx

theorem pB {n : ℕ} (h : primeB n = true) : n.Prime := primeB_sound h

