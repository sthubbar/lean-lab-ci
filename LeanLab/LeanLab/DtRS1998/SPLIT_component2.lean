/-- The target statement of `component2`, proved from the eight block leaves.

A candidate `q` in `qs.take 64` is one of the eight displayed blocks, so the
block leaves make it prime.  A prime divisor `p` of a prime `q` equals `q`, and
then `i = 1` gives the required congruence by reflexivity.  No sorry of its own
and `component2` is not used. -/
theorem component2_split :
    ∀ q ∈ qs.take 64, ∀ p : ℕ, p.Prime → p ∣ q →
      ∃ i : ℕ, i < 16 ∧
        p ^ 315 % 15321986788854443284662612735663611380010431225771200 = q ^ (315 * i) % 15321986788854443284662612735663611380010431225771200 := by
  intro q hq p hp hpd
  have hqp : q.Prime := by
    rw [take64_blocks] at hq
    simp only [List.mem_append] at hq
    rcases hq with (((((((hq | hq) | hq) | hq) | hq) | hq) | hq) | hq)
    · exact leaf_block_1 q hq
    · exact leaf_block_2 q hq
    · exact leaf_block_3 q hq
    · exact leaf_block_4 q hq
    · exact leaf_block_5 q hq
    · exact leaf_block_6 q hq
    · exact leaf_block_7 q hq
    · exact leaf_block_8 q hq
  have hpq : q = p := (hqp.dvd_iff_eq (by have h2 := hp.two_le; omega)).mp hpd
  subst hpq
  exact ⟨1, by norm_num, by rw [Nat.mul_one]⟩

#print axioms component2_split

