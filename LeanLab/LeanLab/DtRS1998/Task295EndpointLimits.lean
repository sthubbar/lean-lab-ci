/-- The pure power-of-two construction cannot enter the small bitmap domain.
Supporting generator obstruction for P0037 Section 5.2 page 212. -/
theorem power_two_gap (E q : ℕ) (hE : 31 ≤ E) (hq : 1 ≤ q)
    (hqb : q < 10 ^ E) (hdiv : 2 ^ E ∣ q - 1) :
    31700 * 31700 < 10 ^ E - q := by
  have hB : 2 ^ E ∣ 10 ^ E :=
    pow_dvd_pow_of_dvd (by decide : (2 : ℕ) ∣ 10) E
  have hd : 2 ^ E ∣ 10 ^ E - (q - 1) := Nat.dvd_sub hB hdiv
  have hpos : 0 < 10 ^ E - (q - 1) := by omega
  have hle := Nat.le_of_dvd hpos hd
  have hpow : 2147483648 ≤ (2 : ℕ) ^ E := by
    calc
      2147483648 = (2 : ℕ) ^ 31 := by decide +kernel
      _ ≤ 2 ^ E := Nat.pow_le_pow_right (by decide) hE
  omega

#print axioms power_two_gap

