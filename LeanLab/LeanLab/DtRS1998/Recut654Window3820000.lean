/-- Pocklington certificates for the missing companion primes and their factors. -/
def patchCertificates : List Big.Cert := supportCertificates ++ directCertificates

/-- Each exceptional companion certificate has a prime first entry. -/
theorem patchCertificates_prime : ∀ c ∈ patchCertificates, c.1.Prime := by
  have hS : Big.chainP [] supportCertificates = true := by decide +kernel
  have hC : directCertificates.all (Big.pockK (supportCertificates.map Prod.fst)) = true := by
    decide +kernel
  intro c hc
  simp only [patchCertificates, List.mem_append] at hc
  rcases hc with hc | hc
  · exact Big.chainP_sound supportCertificates [] (by simp) hS c hc
  · exact Big.all_prime_overP hS hC c.1 (List.mem_map.mpr ⟨c, hc, rfl⟩)

