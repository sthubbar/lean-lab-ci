/-- P0037 page 207. There are exactly 446 odd primes at most 3163,
and 3163 is prime. Thus its one based odd prime index is 446. -/
theorem odd_index_3163 :
    Nat.Prime 3163 ∧ ((Finset.Icc 3 3163).filter Nat.Prime).card = 446 := by
  constructor
  · exact Sec2Ex.p3163
  · have heq := Task71.primesIn_eq listed_primes listed_bounds listed_complete
    change (Task71.primesIn 3 3163).card = 446
    rw [heq]
    decide +kernel

/-- P0037 page 207. The printed index and the previously certified minimal
Goldbach partition refer to the same prime 3163. -/
theorem indexed_sec2_example :
    ((Finset.Icc 3 3163).filter Nat.Prime).card = 446 ∧
    Nat.Prime 3163 ∧ 244885595672 - 3163 = 244885592509 ∧ Nat.Prime 244885592509 ∧
    ∀ p, p < 3163 → p.Prime → ¬ (244885595672 - p).Prime := by
  exact ⟨odd_index_3163.2, Sec2Ex.sec2_example⟩

