/-- Every prime in the printed closed interval belongs to the list. -/
theorem listed_complete : ∀ p : ℕ, 3 ≤ p → p ≤ 3163 → p.Prime → p ∈ ps := by
  intro p hp3 hp3163 hp
  have h0 := Task71.cover_sound ps 200 3 cs0 (by omega) scan0
  have h1 := Task71.cover_sound ps 200 203 cs1 (by omega) scan1
  have h2 := Task71.cover_sound ps 200 403 cs2 (by omega) scan2
  have h3 := Task71.cover_sound ps 200 603 cs3 (by omega) scan3
