  have h11 := Task71.cover_sound ps 200 2203 cs11 (by omega) scan11
  have h12 := Task71.cover_sound ps 200 2403 cs12 (by omega) scan12
  have h13 := Task71.cover_sound ps 200 2603 cs13 (by omega) scan13
  have h14 := Task71.cover_sound ps 200 2803 cs14 (by omega) scan14
  have h15 := Task71.cover_sound ps 161 3003 cs15 (by omega) scan15
  by_cases hb0 : p < 203
  · exact h0 p (by omega) hb0 hp
  by_cases hb1 : p < 403
  · exact h1 p (by omega) hb1 hp
  by_cases hb2 : p < 603
  · exact h2 p (by omega) hb2 hp
  by_cases hb3 : p < 803
  · exact h3 p (by omega) hb3 hp
