theorem k2 : chkN 999999999999990 10 L2 = true := by decide +kernel

theorem gap : ∀ x, 999999999999990 ≤ x → x < 1000000000000000 → ¬ x.Prime :=
  fun x h1 h2 => chkN_sound _ _ _ (by norm_num) k2 x h1 (by omega)

theorem worst : ∀ x, 999999999988841 ≤ x → x < 999999999997699 → x.Prime → ¬ (1000000087831838 - x).Prime := r1

theorem pW : Nat.Prime 87834139 := prime_of_chain S_ok (by decide +kernel)

/-- **Table 1, row log10 B = 15**: q1 = 10^15 - 11159, q243 and q300 = 10^15 - 11 are prime, no prime lies
strictly between q300 and 10^15, W = 10^15 + 87831838 is q243 plus a prime, and W - x is composite for every
prime x with q1 ≤ x < q243. -/
theorem row :
    Nat.Prime 999999999988841 ∧ Nat.Prime 999999999997699 ∧ Nat.Prime 999999999999989 ∧
    (∀ x, 999999999999989 < x → x < 1000000000000000 → ¬ x.Prime) ∧
    1000000087831838 - 999999999997699 = 87834139 ∧ Nat.Prime 87834139 ∧
    (∀ x, 999999999988841 ≤ x → x < 999999999997699 → x.Prime → ¬ (1000000087831838 - x).Prime) :=
  ⟨prime_of_chain S_ok (by decide +kernel), prime_of_chain S_ok (by decide +kernel),
    prime_of_chain S_ok (by decide +kernel),
    fun x h1 h2 => gap x (by omega) h2, by norm_num, pW, worst⟩

theorem row_lits : 999999999988841 = 10 ^ 15 - 11159 ∧ 999999999999989 = 10 ^ 15 - 11 ∧ 1000000087831838 = 10 ^ 15 + 87831838 := by norm_num

