/-- `25 ^ n * primorial n < 68 ^ n` from a certified theta bound. -/
private theorem primorial_of_theta_bound (n : ℕ) (hn : 0 < n)
    (h : (ThetaSieve.Q : ℝ) * PrimC3Cert.th n < (n : ℝ) * 18458400208034708012) :
    primorial n * 25 ^ n < 68 ^ n := by
  have hcq := PrimC3Cert.c_le PrimC3Cert.cpos
  rw [PrimC3Cert.cval] at hcq
  have h2 : (ThetaSieve.Q : ℝ) * PrimC3Cert.th n <
      ThetaSieve.Q * (n * Real.log (68 / 25)) := by
    calc (ThetaSieve.Q : ℝ) * PrimC3Cert.th n < (n : ℝ) * (18458400208034708012 : ℕ) := h
      _ ≤ (n : ℝ) * (ThetaSieve.Q * Real.log (68 / 25)) :=
          mul_le_mul_of_nonneg_left hcq (Nat.cast_nonneg n)
      _ = ThetaSieve.Q * (n * Real.log (68 / 25)) := by ring
  exact PrimC3Cert.primorial_of_theta n hn
    (lt_of_mul_lt_mul_left h2 (le_of_lt PrimC3Cert.Q_pos))

