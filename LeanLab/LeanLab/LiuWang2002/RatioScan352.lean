import LeanLab.LiuWang2002.ThetaCert352

/-!
Fixed precision integer certificates for Schoenfeld page 356, display 5.1 star.
Rounding is always upward, so precision loss cannot create a false certificate.
AI wrote the Lean code. Binary Goldbach is open.
-/
namespace LeanLab.LiuWang2002.Task352
set_option maxRecDepth 10000000
set_option maxRecDepth 100000
set_option exponentiation.threshold 1024

/-- A bounded integer ratio scan. Its scale is 2 to power 4096.
The state bounds primorial n times 25 to n divided by 68 to n.
Derived executable proof data for page 356, display 5.1 star. -/
def ratioCheck : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | k + 1, n, r =>
    let f := if 2 ≤ n + 1 ∧ Nat.minFac (n + 1) = n + 1 then n + 1 else 1
    let r' := (r * f * 25 + 67) / 68
    match r' with
    | 0 => decide (0 < ) && ratioCheck k (n + 1) 0
    | q + 1 => decide (q + 1 < ) && ratioCheck k (n + 1) (q + 1)

/-- A single primorial update using the smallest factor test.
Derived arithmetic transfer for page 356, display 5.1 star. -/
theorem primorial_next (n : ℕ) : primorial (n + 1) = primorial n *
    (if 2 ≤ n + 1 ∧ Nat.minFac (n + 1) = n + 1 then n + 1 else 1) := by
  simp only [← Nat.prime_def_minFac]
  rw [primorial_add n 1, Nat.Ico_succ_singleton]
  by_cases hp : (n + 1).Prime
  · rw [Finset.filter_eq_self.mpr (by simpa using hp), Finset.prod_singleton, if_pos hp]
  · rw [Finset.filter_eq_empty_iff.mpr (by simpa using hp), Finset.prod_empty, if_neg hp]

/-- Soundness of every fixed precision scan. The explicit invariant
accounts for all upward rounding. Derived certificate transfer for
page 356, display 5.1 star. -/
theorem ratioCheck_sound (k n r : ℕ)
    (hi : primorial n * 25 ^ n *  ≤ r * 68 ^ n)
    (hc : ratioCheck k n r = true) :
    ∀ m : ℕ, n < m → m ≤ n + k → primorial m * 25 ^ m < 68 ^ m := by
  induction k generalizing n r with
  | zero => intro m hm hm'; omega
  | succ k ih =>
    let f := if 2 ≤ n + 1 ∧ Nat.minFac (n + 1) = n + 1 then n + 1 else 1
    let r' := (r * f * 25 + 67) / 68
    have heq : ratioCheck (k + 1) n r =
        (decide (r' < ) && ratioCheck k (n + 1) r') := by
      rw [ratioCheck]
      change (match r' with
        | 0 => decide (0 < ) && ratioCheck k (n + 1) 0
        | q + 1 => decide (q + 1 < ) && ratioCheck k (n + 1) (q + 1)) = _
      cases r' <;> rfl
    rw [heq] at hc
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hc
    have hround : r * f * 25 ≤ r' * 68 := by dsimp [r']; omega
    have hnext : primorial (n + 1) * 25 ^ (n + 1) *  ≤ r' * 68 ^ (n + 1) := by
      calc
        _ = (primorial n * 25 ^ n * ) * (f * 25) := by
          rw [primorial_next, pow_succ]
          dsimp [f]
          ring
        _ ≤ (r * 68 ^ n) * (f * 25) := Nat.mul_le_mul_right _ hi
        _ = (r * f * 25) * 68 ^ n := by ring
        _ ≤ (r' * 68) * 68 ^ n := Nat.mul_le_mul_right _ hround
        _ = r' * 68 ^ (n + 1) := by rw [pow_succ]; ring
    intro m hm hm'
    by_cases he : m = n + 1
    · subst m
      have hh := hnext.trans_lt (Nat.mul_lt_mul_of_pos_right hc.1 (by positivity : 0 < 68 ^ (n + 1)))
      rw [Nat.mul_comm ()] at hh
      exact Nat.lt_of_mul_lt_mul_right hh
    · exact ih (n + 1) r' hnext hc.2 m (by omega) (by omega)

end LeanLab.LiuWang2002.Task352
#print axioms LeanLab.LiuWang2002.Task352.primorial_next
#print axioms LeanLab.LiuWang2002.Task352.ratioCheck_sound
