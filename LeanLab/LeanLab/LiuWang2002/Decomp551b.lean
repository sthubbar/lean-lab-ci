/-!
Proper subrange supplies for the sealed Decomp460c leaves.
Source Schoenfeld 1976 page 356, display 5.1 star, derived integer certificates.
The cutoffs are proof bookkeeping and are not printed paper constants.
All leaf dependent assemblies are CONDITIONAL ON the named open subranges.
AI wrote the Lean code. Binary Goldbach is open.
-/
namespace LeanLab.LiuWang2002.Task551

open LeanLab.LiuWang2002.P2M655.ThetaSieve


section
set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-- A segment chain from `3` whose segments pass `Seg.bok`, `chainOK`, and `primOK`
above `32000000` yields Schoenfeld's display 5.1 star on `(32000000, B]`. -/
private theorem theta_range_of_chain (s0 : Seg) (l : List Seg)
    (hs : (Seg.lo s0) = LLo 2 ∧ (Seg.hi s0) = LHi 2 ∧ (Seg.L s0) = 3)
    (hc : chainOK (s0 :: l) = true)
    (hok : ∀ x ∈ s0 :: l, Seg.bok x = true)
    (hp : ∀ x ∈ s0 :: l,
      32000000 + 1 < (Seg.L x) + 2 * (Seg.W x) → primOK (LLo 68 - LHi 25) x = true)
    (hend : 66000000 + 1 ≤ (Seg.L (chainEnd s0 l)) + 2 * (Seg.W (chainEnd s0 l)))
    (n : ℕ) (hn : 32000000 < n) (hn' : n ≤ 66000000) :
    primorial n * 25 ^ n < 68 ^ n :=
  primorial_range_of 32000000 66000000 s0 l hs hc hok hp hend (by decide +kernel) (by norm_num) n hn hn'

