theorem half_coeff_majorant125 :
    ∀ j : Fin 17, taylorCosCoeff125 16 halfParameter125 j +
      (if j = 0 then 3 * halfParameter125 ^ 17 / (17).factorial else 0) ≤ halfCoeff125 j := by
  decide +kernel

