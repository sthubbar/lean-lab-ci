def halfCoeffInt125 (j : ℤ) : ℚ :=
  if h : 0 ≤ j ∧ j < 17 then halfCoeff125 ⟨j.toNat, by omega⟩ else 0

def halfTransfer125 (i j : Fin 16) : ℚ :=
  (halfCoeffInt125 (2 * (j : ℤ) - i) + halfCoeffInt125 (2 * (j : ℤ) + i) +
    if j = 0 then 0 else halfCoeffInt125 ((i : ℤ) - 2 * j)) / 2

/-- The finite cosine coefficients of the degree k exponential Taylor polynomial. -/
def taylorCosCoeff125 (k : ℕ) (t : ℚ) (j : ℕ) : ℚ :=
  ∑ n ∈ range (k + 1), if j ≤ n ∧ Even (n - j) then
    (if j = 0 then 1 else 2) * t ^ n * Nat.choose n ((n - j) / 2) /
      ((n.factorial : ℚ) * 2 ^ n) else 0

