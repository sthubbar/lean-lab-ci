theorem half_perron_certificate125 :
    ∀ i : Fin 16, (∑ j : Fin 16, halfTransfer125 i j * halfVector125 j) ≤
      halfRadius125 * halfVector125 i := by
  decide +kernel

theorem half_coeff_nonneg125 : ∀ j : Fin 17, 0 ≤ halfCoeff125 j := by decide +kernel

theorem half_vector_pos125 : ∀ j : Fin 16, 0 < halfVector125 j := by decide +kernel

theorem half_parameter_box125 : (0 : ℚ) < halfParameter125 ∧ halfParameter125 < 1 := by
