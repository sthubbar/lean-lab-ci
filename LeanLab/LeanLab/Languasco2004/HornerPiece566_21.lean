/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_21_integral_exact :
    polynomialTerm 20 = antiOuter_21 (3041 / 7830) - antiOuter_21 (617 / 1620) := by
  have hi (t : ℝ) :
      (∫ u in ((-58 / 49) * t + (85 / 147))..((-1 / 4) * t + (1 / 4)), polynomial 20 t u) = antiInner_21 t ((-1 / 4) * t + (1 / 4)) - antiInner_21 t ((-58 / 49) * t + (85 / 147)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_21_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((617 / 1620) : ℝ)..(3041 / 7830), ∫ u in ((-58 / 49) * t + (85 / 147))..((-1 / 4) * t + (1 / 4)), polynomial 20 t u) =
      antiOuter_21 (3041 / 7830) - antiOuter_21 (617 / 1620) := by
    calc (∫ t in ((617 / 1620) : ℝ)..(3041 / 7830), ∫ u in ((-58 / 49) * t + (85 / 147))..((-1 / 4) * t + (1 / 4)), polynomial 20 t u) =
          ∫ t in ((617 / 1620) : ℝ)..(3041 / 7830), (antiInner_21 t ((-1 / 4) * t + (1 / 4)) - antiInner_21 t ((-58 / 49) * t + (85 / 147))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_21_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_21
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

