/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_10_integral_exact :
    polynomialTerm 9 = antiOuter_10 (34 / 99) - antiOuter_10 (151 / 450) := by
  have hi (t : ℝ) :
      (∫ u in (0 * t + (17 / 99))..((1 / 4) * t + (1 / 8)), polynomial 9 t u) = antiInner_10 t ((1 / 4) * t + (1 / 8)) - antiInner_10 t (0 * t + (17 / 99)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_10_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((151 / 450) : ℝ)..(34 / 99), ∫ u in (0 * t + (17 / 99))..((1 / 4) * t + (1 / 8)), polynomial 9 t u) =
      antiOuter_10 (34 / 99) - antiOuter_10 (151 / 450) := by
    calc (∫ t in ((151 / 450) : ℝ)..(34 / 99), ∫ u in (0 * t + (17 / 99))..((1 / 4) * t + (1 / 8)), polynomial 9 t u) =
          ∫ t in ((151 / 450) : ℝ)..(34 / 99), (antiInner_10 t ((1 / 4) * t + (1 / 8)) - antiInner_10 t (0 * t + (17 / 99))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_10_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_10
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

