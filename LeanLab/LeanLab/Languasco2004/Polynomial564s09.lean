/-- Numerical support: integral of a polynomial given by a coefficient function. -/
private lemma integral_poly_range (e : ℕ → ℝ) (n : ℕ) (a b : ℝ) :
    ∫ t in a..b, (Finset.range n).sum (fun k => e k * t^k)
      = (Finset.range n).sum (fun k => e k * ((b^(k+1) - a^(k+1))/(k+1))) := by
  refine (intervalIntegral.integral_finsetSum (s := Finset.range n)
    (f := fun k t => e k * t^k) ?_).trans ?_
  · intro k _
    exact (by fun_prop : Continuous fun t : ℝ => e k * t^k).intervalIntegrable _ _
  · exact Finset.sum_congr rfl fun k _ => by
      rw [intervalIntegral.integral_const_mul, integral_pow]

/-- Numerical support: the inner integral of a polynomial in the second variable. -/
private lemma integral_inner (U0 U1 L0 L1 : ℝ) (g : ℕ → ℝ) (n : ℕ) (t : ℝ) :
    ∫ u in (L0 + L1*t)..(U0 + U1*t), (Finset.range n).sum (fun j => g j * u^j)
      = (Finset.range n).sum
          (fun j => g j * (((U0 + U1*t)^(j+1) - (L0 + L1*t)^(j+1))/(j+1))) := by
  refine (intervalIntegral.integral_finsetSum (s := Finset.range n)
    (f := fun j u => g j * u^j) ?_).trans ?_
  · intro j _
    exact (by fun_prop : Continuous fun u : ℝ => g j * u^j).intervalIntegrable _ _
  · exact Finset.sum_congr rfl fun j _ => by
      rw [intervalIntegral.integral_const_mul, integral_pow]

