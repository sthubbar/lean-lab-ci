/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_02_integral_exact :
    polynomialTerm 1 = antiOuter_02 (17 / 54) - antiOuter_02 (17 / 57) := by
  have hi (t : ℝ) :
      (∫ u in ((-1 / 3) * t + (1 / 3))..((-1 / 8) * t + (7 / 24)), polynomial 1 t u) = antiInner_02 t ((-1 / 8) * t + (7 / 24)) - antiInner_02 t ((-1 / 3) * t + (1 / 3)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_02_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((17 / 57) : ℝ)..(17 / 54), ∫ u in ((-1 / 3) * t + (1 / 3))..((-1 / 8) * t + (7 / 24)), polynomial 1 t u) =
      antiOuter_02 (17 / 54) - antiOuter_02 (17 / 57) := by
    calc (∫ t in ((17 / 57) : ℝ)..(17 / 54), ∫ u in ((-1 / 3) * t + (1 / 3))..((-1 / 8) * t + (7 / 24)), polynomial 1 t u) =
          ∫ t in ((17 / 57) : ℝ)..(17 / 54), (antiInner_02 t ((-1 / 8) * t + (7 / 24)) - antiInner_02 t ((-1 / 3) * t + (1 / 3))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_02_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_02
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

