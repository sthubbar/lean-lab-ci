        (2 / 5) * w ^ 5 * (pt1 * pu1 * pv1 ^ 6)
      ≤ pt * pu * pv * (1 + 2 * (w * pv + (w * pv) ^ 3 / 3 + (w * pv) ^ 5 / 5 + (w * pv) ^ 7 / 7)) := by
  have hX : pt1 * pu1 * pv1 ^ 4 ≤ pt * pu * pv ^ 4 := by
