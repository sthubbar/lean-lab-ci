/-- The three factor minorant at `k = 1`, written out. -/
private theorem minorant_one_eq (ct cu cv t u : ℝ) :
    minorant 1 ct cu cv t u =
      invPoly5 t ct * invPoly7 u cu * invPoly5 (1 - t - u) cv *
        (1 + 2 * ((1 - t - 3 * u) * invPoly5 (1 - t - u) cv +
          ((1 - t - 3 * u) * invPoly5 (1 - t - u) cv) ^ 3 / 3 +
          ((1 - t - 3 * u) * invPoly5 (1 - t - u) cv) ^ 5 / 5 +
          ((1 - t - 3 * u) * invPoly5 (1 - t - u) cv) ^ 7 / 7)) := by
  norm_num [minorant]

/-- The two term truncation of the six term reciprocal polynomial is a lower bound. -/
private theorem invPoly5_linear_le (x c : ℝ) (hc : 0 < c) (h1 : -(1 / 4 : ℝ) ≤ 1 - x / c)
    (h2 : 1 - x / c ≤ 1 / 4) : (1 + (1 - x / c)) / c ≤ invPoly5 x c := by
  have hA : 0 ≤ 1 + (1 - x / c) := by linarith
  have hB : 0 ≤ 1 + (1 - x / c) ^ 2 := by positivity
  have hnn : 0 ≤ (1 - x / c) ^ 2 * ((1 + (1 - x / c)) * (1 + (1 - x / c) ^ 2)) :=
    mul_nonneg (sq_nonneg _) (mul_nonneg hA hB)
  have hdiff : invPoly5 x c - (1 + (1 - x / c)) / c =
      (1 - x / c) ^ 2 * ((1 + (1 - x / c)) * (1 + (1 - x / c) ^ 2)) / c := by
    unfold invPoly5
    field_simp
    ring
  have h0 : 0 ≤ invPoly5 x c - (1 + (1 - x / c)) / c := by
    rw [hdiff]
    exact div_nonneg hnn hc.le
  linarith

/-- The two term truncation of the eight term reciprocal polynomial is a lower bound. -/
private theorem invPoly7_linear_le (x c : ℝ) (hc : 0 < c) (h1 : -(1 / 4 : ℝ) ≤ 1 - x / c)
    (h2 : 1 - x / c ≤ 1 / 4) : (1 + (1 - x / c)) / c ≤ invPoly7 x c := by
  have hA : 0 ≤ 1 + (1 - x / c) := by linarith
  have hB : 0 ≤ 1 + (1 - x / c) ^ 2 + (1 - x / c) ^ 4 := by positivity
  have hnn : 0 ≤ (1 - x / c) ^ 2 * ((1 + (1 - x / c)) * (1 + (1 - x / c) ^ 2 + (1 - x / c) ^ 4)) :=
    mul_nonneg (sq_nonneg _) (mul_nonneg hA hB)
  have hdiff : invPoly7 x c - (1 + (1 - x / c)) / c =
      (1 - x / c) ^ 2 * ((1 + (1 - x / c)) * (1 + (1 - x / c) ^ 2 + (1 - x / c) ^ 4)) / c := by
    unfold invPoly7
    field_simp
    ring
  have h0 : 0 ≤ invPoly7 x c - (1 + (1 - x / c)) / c := by
    rw [hdiff]
    exact div_nonneg hnn hc.le
  linarith


