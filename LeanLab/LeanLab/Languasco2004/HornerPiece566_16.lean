/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_16_integral_exact :
    polynomialTerm 15 = antiOuter_16 (10 / 27) - antiOuter_16 (193 / 549) := by
  have hi (t : ℝ) :
      (∫ u in ((-58 / 49) * t + (85 / 147))..((-1 / 4) * t + (1 / 4)), polynomial 15 t u) = antiInner_16 t ((-1 / 4) * t + (1 / 4)) - antiInner_16 t ((-58 / 49) * t + (85 / 147)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_16_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((193 / 549) : ℝ)..(10 / 27), ∫ u in ((-58 / 49) * t + (85 / 147))..((-1 / 4) * t + (1 / 4)), polynomial 15 t u) =
      antiOuter_16 (10 / 27) - antiOuter_16 (193 / 549) := by
    calc (∫ t in ((193 / 549) : ℝ)..(10 / 27), ∫ u in ((-58 / 49) * t + (85 / 147))..((-1 / 4) * t + (1 / 4)), polynomial 15 t u) =
          ∫ t in ((193 / 549) : ℝ)..(10 / 27), (antiInner_16 t ((-1 / 4) * t + (1 / 4)) - antiInner_16 t ((-58 / 49) * t + (85 / 147))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_16_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_16
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

