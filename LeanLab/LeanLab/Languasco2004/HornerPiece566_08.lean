    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_08_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((109 / 330) : ℝ)..(1 / 3), ∫ u in ((-1 / 3) * t + (1 / 3))..(-6 * t + (20 / 9)), polynomial 7 t u) =
      antiOuter_08 (1 / 3) - antiOuter_08 (109 / 330) := by
    calc (∫ t in ((109 / 330) : ℝ)..(1 / 3), ∫ u in ((-1 / 3) * t + (1 / 3))..(-6 * t + (20 / 9)), polynomial 7 t u) =
          ∫ t in ((109 / 330) : ℝ)..(1 / 3), (antiInner_08 t (-6 * t + (20 / 9)) - antiInner_08 t ((-1 / 3) * t + (1 / 3))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_08_hasDerivAt t
           · apply Continuous.intervalIntegrable
