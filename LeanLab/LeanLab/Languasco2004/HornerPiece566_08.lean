/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_08_integral_exact :
    polynomialTerm 7 = antiOuter_08 (1 / 3) - antiOuter_08 (109 / 330) := by
  have hi (t : ℝ) :
