/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_06_integral_exact :
    polynomialTerm 5 = antiOuter_06 (109 / 330) - antiOuter_06 (221 / 693) := by
  have hi (t : ℝ) :
      (∫ u in ((-1 / 3) * t + (1 / 3))..(-1 * t + (113 / 198)), polynomial 5 t u) = antiInner_06 t (-1 * t + (113 / 198)) - antiInner_06 t ((-1 / 3) * t + (1 / 3)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_06_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((221 / 693) : ℝ)..(109 / 330), ∫ u in ((-1 / 3) * t + (1 / 3))..(-1 * t + (113 / 198)), polynomial 5 t u) =
      antiOuter_06 (109 / 330) - antiOuter_06 (221 / 693) := by
    calc (∫ t in ((221 / 693) : ℝ)..(109 / 330), ∫ u in ((-1 / 3) * t + (1 / 3))..(-1 * t + (113 / 198)), polynomial 5 t u) =
          ∫ t in ((221 / 693) : ℝ)..(109 / 330), (antiInner_06 t (-1 * t + (113 / 198)) - antiInner_06 t ((-1 / 3) * t + (1 / 3))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_06_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_06
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

