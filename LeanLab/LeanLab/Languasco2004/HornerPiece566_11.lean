/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_11_integral_exact :
    polynomialTerm 10 = antiOuter_11 (34 / 99) - antiOuter_11 (151 / 450) := by
  have hi (t : ℝ) :
      (∫ u in (-1 * t + (5 / 9))..((-1 / 3) * t + (1 / 3)), polynomial 10 t u) = antiInner_11 t ((-1 / 3) * t + (1 / 3)) - antiInner_11 t (-1 * t + (5 / 9)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_11_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((151 / 450) : ℝ)..(34 / 99), ∫ u in (-1 * t + (5 / 9))..((-1 / 3) * t + (1 / 3)), polynomial 10 t u) =
      antiOuter_11 (34 / 99) - antiOuter_11 (151 / 450) := by
    calc (∫ t in ((151 / 450) : ℝ)..(34 / 99), ∫ u in (-1 * t + (5 / 9))..((-1 / 3) * t + (1 / 3)), polynomial 10 t u) =
          ∫ t in ((151 / 450) : ℝ)..(34 / 99), (antiInner_11 t ((-1 / 3) * t + (1 / 3)) - antiInner_11 t (-1 * t + (5 / 9))) := by
            apply integral_congr
