/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_17_integral_exact :
    polynomialTerm 16 = antiOuter_17 (10 / 27) - antiOuter_17 (193 / 549) := by
  have hi (t : ℝ) :
      (∫ u in ((-1 / 4) * t + (1 / 4))..((-1 / 3) * t + (1 / 3)), polynomial 16 t u) = antiInner_17 t ((-1 / 3) * t + (1 / 3)) - antiInner_17 t ((-1 / 4) * t + (1 / 4)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_17_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((193 / 549) : ℝ)..(10 / 27), ∫ u in ((-1 / 4) * t + (1 / 4))..((-1 / 3) * t + (1 / 3)), polynomial 16 t u) =
      antiOuter_17 (10 / 27) - antiOuter_17 (193 / 549) := by
    calc (∫ t in ((193 / 549) : ℝ)..(10 / 27), ∫ u in ((-1 / 4) * t + (1 / 4))..((-1 / 3) * t + (1 / 3)), polynomial 16 t u) =
          ∫ t in ((193 / 549) : ℝ)..(10 / 27), (antiInner_17 t ((-1 / 3) * t + (1 / 3)) - antiInner_17 t ((-1 / 4) * t + (1 / 4))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_17_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_17
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

