/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_12_integral_exact :
    polynomialTerm 11 = antiOuter_12 (34 / 99) - antiOuter_12 (151 / 450) := by
  have hi (t : ℝ) :
      (∫ u in ((-1 / 3) * t + (1 / 3))..((1 / 3) * t + (7 / 54)), polynomial 11 t u) = antiInner_12 t ((1 / 3) * t + (7 / 54)) - antiInner_12 t ((-1 / 3) * t + (1 / 3)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_12_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((151 / 450) : ℝ)..(34 / 99), ∫ u in ((-1 / 3) * t + (1 / 3))..((1 / 3) * t + (7 / 54)), polynomial 11 t u) =
      antiOuter_12 (34 / 99) - antiOuter_12 (151 / 450) := by
    calc (∫ t in ((151 / 450) : ℝ)..(34 / 99), ∫ u in ((-1 / 3) * t + (1 / 3))..((1 / 3) * t + (7 / 54)), polynomial 11 t u) =
          ∫ t in ((151 / 450) : ℝ)..(34 / 99), (antiInner_12 t ((1 / 3) * t + (7 / 54)) - antiInner_12 t ((-1 / 3) * t + (1 / 3))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_12_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_12
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

