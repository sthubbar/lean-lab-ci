/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_03_integral_exact :
    polynomialTerm 2 = antiOuter_03 (221 / 693) - antiOuter_03 (17 / 54) := by
  have hi (t : ℝ) :
      (∫ u in (0 * t + (17 / 99))..((-1 / 3) * t + (1 / 3)), polynomial 2 t u) = antiInner_03 t ((-1 / 3) * t + (1 / 3)) - antiInner_03 t (0 * t + (17 / 99)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_03_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((17 / 54) : ℝ)..(221 / 693), ∫ u in (0 * t + (17 / 99))..((-1 / 3) * t + (1 / 3)), polynomial 2 t u) =
      antiOuter_03 (221 / 693) - antiOuter_03 (17 / 54) := by
    calc (∫ t in ((17 / 54) : ℝ)..(221 / 693), ∫ u in (0 * t + (17 / 99))..((-1 / 3) * t + (1 / 3)), polynomial 2 t u) =
          ∫ t in ((17 / 54) : ℝ)..(221 / 693), (antiInner_03 t ((-1 / 3) * t + (1 / 3)) - antiInner_03 t (0 * t + (17 / 99))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_03_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_03
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

