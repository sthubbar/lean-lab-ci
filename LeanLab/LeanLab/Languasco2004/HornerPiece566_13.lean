      fun_prop
  have he : (∫ t in ((34 / 99) : ℝ)..(25 / 72), ∫ u in ((-58 / 49) * t + (85 / 147))..((1 / 4) * t + (1 / 8)), polynomial 12 t u) =
      antiOuter_13 (25 / 72) - antiOuter_13 (34 / 99) := by
    calc (∫ t in ((34 / 99) : ℝ)..(25 / 72), ∫ u in ((-58 / 49) * t + (85 / 147))..((1 / 4) * t + (1 / 8)), polynomial 12 t u) =
