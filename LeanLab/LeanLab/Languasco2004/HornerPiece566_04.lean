/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_04_integral_exact :
    polynomialTerm 3 = antiOuter_04 (221 / 693) - antiOuter_04 (17 / 54) := by
  have hi (t : ℝ) :
