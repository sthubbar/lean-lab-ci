    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_04_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((17 / 54) : ℝ)..(221 / 693), ∫ u in ((-1 / 3) * t + (1 / 3))..((-1 / 8) * t + (7 / 24)), polynomial 3 t u) =
      antiOuter_04 (221 / 693) - antiOuter_04 (17 / 54) := by
    calc (∫ t in ((17 / 54) : ℝ)..(221 / 693), ∫ u in ((-1 / 3) * t + (1 / 3))..((-1 / 8) * t + (7 / 24)), polynomial 3 t u) =
          ∫ t in ((17 / 54) : ℝ)..(221 / 693), (antiInner_04 t ((-1 / 8) * t + (7 / 24)) - antiInner_04 t ((-1 / 3) * t + (1 / 3))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
