/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_23_integral_exact :
    polynomialTerm 22 = antiOuter_23 (121 / 291) - antiOuter_23 (3041 / 7830) := by
  have hi (t : ℝ) :
      (∫ u in (0 * t + (16 / 135))..((-1 / 4) * t + (1 / 4)), polynomial 22 t u) = antiInner_23 t ((-1 / 4) * t + (1 / 4)) - antiInner_23 t (0 * t + (16 / 135)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_23_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((3041 / 7830) : ℝ)..(121 / 291), ∫ u in (0 * t + (16 / 135))..((-1 / 4) * t + (1 / 4)), polynomial 22 t u) =
      antiOuter_23 (121 / 291) - antiOuter_23 (3041 / 7830) := by
    calc (∫ t in ((3041 / 7830) : ℝ)..(121 / 291), ∫ u in (0 * t + (16 / 135))..((-1 / 4) * t + (1 / 4)), polynomial 22 t u) =
          ∫ t in ((3041 / 7830) : ℝ)..(121 / 291), (antiInner_23 t ((-1 / 4) * t + (1 / 4)) - antiInner_23 t (0 * t + (16 / 135))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_23_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_23
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

