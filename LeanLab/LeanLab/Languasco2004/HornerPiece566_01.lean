/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_01_integral_exact :
    polynomialTerm 0 = antiOuter_01 (17 / 54) - antiOuter_01 (17 / 57) := by
  have hi (t : ℝ) :
      (∫ u in ((-12 / 11) * t + (17 / 33))..((-1 / 3) * t + (1 / 3)), polynomial 0 t u) = antiInner_01 t ((-1 / 3) * t + (1 / 3)) - antiInner_01 t ((-12 / 11) * t + (17 / 33)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_01_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((17 / 57) : ℝ)..(17 / 54), ∫ u in ((-12 / 11) * t + (17 / 33))..((-1 / 3) * t + (1 / 3)), polynomial 0 t u) =
      antiOuter_01 (17 / 54) - antiOuter_01 (17 / 57) := by
    calc (∫ t in ((17 / 57) : ℝ)..(17 / 54), ∫ u in ((-12 / 11) * t + (17 / 33))..((-1 / 3) * t + (1 / 3)), polynomial 0 t u) =
          ∫ t in ((17 / 57) : ℝ)..(17 / 54), (antiInner_01 t ((-1 / 3) * t + (1 / 3)) - antiInner_01 t ((-12 / 11) * t + (17 / 33))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_01_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_01
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

