/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_07_integral_exact :
    polynomialTerm 6 = antiOuter_07 (1 / 3) - antiOuter_07 (109 / 330) := by
  have hi (t : ℝ) :
      (∫ u in (0 * t + (17 / 99))..((-1 / 3) * t + (1 / 3)), polynomial 6 t u) = antiInner_07 t ((-1 / 3) * t + (1 / 3)) - antiInner_07 t (0 * t + (17 / 99)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_07_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((109 / 330) : ℝ)..(1 / 3), ∫ u in (0 * t + (17 / 99))..((-1 / 3) * t + (1 / 3)), polynomial 6 t u) =
      antiOuter_07 (1 / 3) - antiOuter_07 (109 / 330) := by
    calc (∫ t in ((109 / 330) : ℝ)..(1 / 3), ∫ u in (0 * t + (17 / 99))..((-1 / 3) * t + (1 / 3)), polynomial 6 t u) =
