/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_09_integral_exact :
    polynomialTerm 8 = antiOuter_09 (151 / 450) - antiOuter_09 (1 / 3) := by
  have hi (t : ℝ) :
      (∫ u in (0 * t + (17 / 99))..(-6 * t + (20 / 9)), polynomial 8 t u) = antiInner_09 t (-6 * t + (20 / 9)) - antiInner_09 t (0 * t + (17 / 99)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_09_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((1 / 3) : ℝ)..(151 / 450), ∫ u in (0 * t + (17 / 99))..(-6 * t + (20 / 9)), polynomial 8 t u) =
      antiOuter_09 (151 / 450) - antiOuter_09 (1 / 3) := by
    calc (∫ t in ((1 / 3) : ℝ)..(151 / 450), ∫ u in (0 * t + (17 / 99))..(-6 * t + (20 / 9)), polynomial 8 t u) =
          ∫ t in ((1 / 3) : ℝ)..(151 / 450), (antiInner_09 t (-6 * t + (20 / 9)) - antiInner_09 t (0 * t + (17 / 99))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_09_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_09
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

