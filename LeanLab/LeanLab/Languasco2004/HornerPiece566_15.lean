/-- Pages 271 to 273 support: both fundamental theorem applications retain the exact source bounds. -/
theorem component_15_integral_exact :
    polynomialTerm 14 = antiOuter_15 (193 / 549) - antiOuter_15 (25 / 72) := by
  have hi (t : ℝ) :
      (∫ u in ((-1 / 3) * t + (1 / 3))..((-23 / 15) * t + (7 / 9)), polynomial 14 t u) = antiInner_15 t ((-23 / 15) * t + (7 / 9)) - antiInner_15 t ((-1 / 3) * t + (1 / 3)) := by
    apply integral_eq_sub_of_hasDerivAt
    · intro u hu
      exact antiInner_15_hasDerivAt t u
    · apply Continuous.intervalIntegrable
      unfold polynomial
      norm_num [data, centres]
      try simp only [invPoly3, invPoly5, Midpoint566.invPoly1]
      fun_prop
  have he : (∫ t in ((25 / 72) : ℝ)..(193 / 549), ∫ u in ((-1 / 3) * t + (1 / 3))..((-23 / 15) * t + (7 / 9)), polynomial 14 t u) =
      antiOuter_15 (193 / 549) - antiOuter_15 (25 / 72) := by
    calc (∫ t in ((25 / 72) : ℝ)..(193 / 549), ∫ u in ((-1 / 3) * t + (1 / 3))..((-23 / 15) * t + (7 / 9)), polynomial 14 t u) =
          ∫ t in ((25 / 72) : ℝ)..(193 / 549), (antiInner_15 t ((-23 / 15) * t + (7 / 9)) - antiInner_15 t ((-1 / 3) * t + (1 / 3))) := by
            apply integral_congr
            intro t ht
            exact hi t
         _ = _ := by
           apply integral_eq_sub_of_hasDerivAt
           · intro t ht
             exact antiOuter_15_hasDerivAt t
           · apply Continuous.intervalIntegrable
             unfold antiInner_15
             fun_prop
  norm_num [polynomialTerm, data]
  simpa only [neg_div, neg_mul, zero_mul, zero_add, mul_one, one_mul, add_zero] using he

