def val (ka : ℕ × ℕ) : ℕ := ka.1 * 2 ^ (51 + 1) + 1

def okP (ka : ℕ × ℕ) : Bool := prothB ka.1 51 ka.2

/-- Boolean sharp chain check. -/
def chainB2 (B : ℕ) : List ℕ → Bool
  | a :: b :: t => (decide (a < b) && decide (b ≤ a + (B - 2))) && chainB2 B (b :: t)
  | _ => true

theorem chainB2_sound (B : ℕ) : ∀ l : List ℕ, chainB2 B l = true → l.IsChain (Step2 B)
  | [], _ => List.IsChain.nil
  | [_], _ => List.IsChain.singleton _
  | a :: b :: t, h => by
    simp only [chainB2, Bool.and_eq_true, decide_eq_true_eq] at h
    exact List.IsChain.cons_cons ⟨h.1.1, h.1.2⟩ (chainB2_sound B (b :: t) h.2)

/-- Every rung passes Proth's test, kernel checked. -/
theorem all_ok : pairs.all okP = true := by decide +kernel

theorem vals_prime : ∀ p ∈ pairs.map val, p.Prime := by
  intro p hp
  obtain ⟨ka, hka, rfl⟩ := List.mem_map.mp hp
  exact prime_of_prothB (List.all_eq_true.mp all_ok ka hka)

def v0 : ℕ := 8875694143621751943882526949377

theorem split : pairs.map val = v0 :: (pairs.tail.map val) := by decide +kernel

theorem chain : (v0 :: pairs.tail.map val).IsChain (Step2 (4 * 10 ^ 18)) :=
  chainB2_sound _ _ (by decide +kernel)

theorem last : (pairs.tail.map val).getLastD v0 = 8875694145618139111900712009729 := by decide +kernel

theorem v0_prime : v0.Prime := vals_prime v0 (by rw [split]; exact List.mem_cons_self ..)

theorem tail_prime : ∀ p ∈ pairs.tail.map val, p.Prime :=
  fun p hp => vals_prime p (by rw [split]; exact List.mem_cons_of_mem _ hp)

