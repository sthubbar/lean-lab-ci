    0 < (1 : ℝ) * (x - x ^ 3 - x ^ 5 + x ^ 7 + x ^ 9 - x ^ 11 - x ^ 13 + x ^ 15) - (0 : ℝ) * (0) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < y ^ 12 + 14 * x * y ^ 11 + 90 * x ^ 2 * y ^ 10 + 352 * x ^ 3 * y ^ 9 + 934 * x ^ 4 * y ^ 8 + 1772 * x ^ 5 * y ^ 7 + 2464 * x ^ 6 * y ^ 6 + 2528 * x ^ 7 * y ^ 5 + 1898 * x ^ 8 * y ^ 4 + 1020 * x ^ 9 * y ^ 3 + 380 * x ^ 10 * y ^ 2 + 96 * x ^ 11 * y + 16 * x ^ 12 :=
    fun y hy => by positivity
  have e : (1 : ℝ) * (x - x ^ 3 - x ^ 5 + x ^ 7 + x ^ 9 - x ^ 11 - x ^ 13 + x ^ 15) - (0 : ℝ) * (0) =
      x * (1 - x) ^ 2 * ((1 - x) ^ 12 + 14 * x * (1 - x) ^ 11 + 90 * x ^ 2 * (1 - x) ^ 10 + 352 * x ^ 3 * (1 - x) ^ 9 + 934 * x ^ 4 * (1 - x) ^ 8 + 1772 * x ^ 5 * (1 - x) ^ 7 + 2464 * x ^ 6 * (1 - x) ^ 6 + 2528 * x ^ 7 * (1 - x) ^ 5 + 1898 * x ^ 8 * (1 - x) ^ 4 + 1020 * x ^ 9 * (1 - x) ^ 3 + 380 * x ^ 10 * (1 - x) ^ 2 + 96 * x ^ 11 * (1 - x) + 16 * x ^ 12) := by
    ring
