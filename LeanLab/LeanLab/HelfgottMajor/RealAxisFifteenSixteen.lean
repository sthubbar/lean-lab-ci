import LeanLab.HelfgottMajor.RealAxisKernel

/-!
# Nonvanishing of `L(σ, χ)` on the positive real axis for the moduli 16 and 15

What is proved: for every non principal Dirichlet character `χ` modulo 16 and modulo 15 and every
real `σ > 0`, `L(σ, χ) ≠ 0`. These are the theorems `LFunction_ofReal_ne_zero_mod_16` and
`LFunction_ofReal_ne_zero_mod_15`.

Method: the kernel criterion `LFunction_ofReal_ne_zero_of_kernel`. The unit groups are
`Z/2 x Z/4`, generated by 15 and 3 modulo 16 and by 11 and 2 modulo 15, so a character is fixed
by `u = χ(g₁)`, a square root of one, and `v = χ(g₂)`, a fourth root of one. For each of the
seven non principal pairs a Gaussian integer `c` is chosen so that the real part of
`c * ∑_{a < q} χ(a) x^a` is an integer polynomial that factors exactly as `x (1 - x)^k R(x)`,
where `R` is written in Bernstein form in `x` and `1 - x` with nonnegative integer coefficients.

This is standard mathematics, the classical nonvanishing of Dirichlet L functions on the positive
real axis for small moduli. Nothing here is new.

AI wrote this Lean code. The binary Goldbach conjecture is open; this file does not touch it.
-/

namespace LeanLab.HelfgottMajor.RealAxisKernel

/-- The four fourth roots of one, with their squares and cubes. -/
private lemma fourth_root (v : ℂ) (h : v ^ 4 = 1) :
    (v = 1 ∧ v ^ 2 = 1 ∧ v ^ 3 = 1) ∨ (v = -1 ∧ v ^ 2 = 1 ∧ v ^ 3 = -1) ∨
    (v = Complex.I ∧ v ^ 2 = -1 ∧ v ^ 3 = -Complex.I) ∨
    (v = -Complex.I ∧ v ^ 2 = -1 ∧ v ^ 3 = Complex.I) := by
  have hf : (v ^ 2 - 1) * (v ^ 2 + 1) = 0 := by linear_combination h
  rcases mul_eq_zero.1 hf with h1 | h1
  · have h2 : v ^ 2 = (1 : ℂ) ^ 2 := by linear_combination h1
    rcases sq_eq_sq_iff_eq_or_eq_neg.1 h2 with rfl | rfl
    · exact Or.inl ⟨rfl, by norm_num, by norm_num⟩
    · exact Or.inr (Or.inl ⟨rfl, by norm_num, by norm_num⟩)
  · have h2 : v ^ 2 = Complex.I ^ 2 := by rw [Complex.I_sq]; linear_combination h1
    rcases sq_eq_sq_iff_eq_or_eq_neg.1 h2 with rfl | rfl
    · exact Or.inr (Or.inr (Or.inl ⟨rfl, Complex.I_sq, by rw [pow_succ, Complex.I_sq]; ring⟩))
    · exact Or.inr (Or.inr (Or.inr ⟨rfl, by rw [neg_sq, Complex.I_sq],
        by rw [pow_succ, neg_sq, Complex.I_sq]; ring⟩))

/-- The two square roots of one. -/
private lemma square_root (u : ℂ) (h : u ^ 2 = 1) : u = 1 ∨ u = -1 :=
  sq_eq_sq_iff_eq_or_eq_neg.1 (show u ^ 2 = (1 : ℂ) ^ 2 by rw [h, one_pow])

/-- The real part of a product written through real and imaginary parts. -/
private lemma re_aux (a b p q : ℝ) :
    (((a : ℂ) + (b : ℂ) * Complex.I) * ((p : ℂ) + (q : ℂ) * Complex.I)).re = a * p - b * q := by
  simp [Complex.mul_re]

/-- The sum of a non principal character over a full period vanishes. -/
private lemma range_sum_one {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (hχ : χ ≠ 1) :
    ∑ a ∈ Finset.range q, χ (a : ZMod q) * (1 : ℂ) ^ a = 0 := by
  have h := LeanLab.HelfgottMajor.StripBound123.sum_range_shift (q := q) (fun a => χ a) 0
  simp only [zero_add] at h
  simp only [one_pow, mul_one]
  rw [h]
  exact MulChar.sum_eq_zero_of_ne_one hχ

/-- A character vanishes at residues not coprime to the modulus. -/
private lemma nonunit_zero {q : ℕ} (χ : DirichletCharacter ℂ q) (k : ℕ) (h : ¬ Nat.Coprime k q) :
    χ (k : ZMod q) = 0 :=
  MulChar.map_nonunit χ (by rwa [ZMod.isUnit_iff_coprime])

/-- The polynomial `∑_(a < 16) χ(a) z^a` through the values of `χ` at the generators. -/
private lemma sum_16 (χ : DirichletCharacter ℂ 16) (u v v2 v3 : ℂ)
    (hu : χ ((15 : ℕ) : ZMod 16) = u) (hv : χ ((3 : ℕ) : ZMod 16) = v)
    (hv2 : v ^ 2 = v2) (hv3 : v ^ 3 = v3) (z : ℂ) :
    ∑ a ∈ Finset.range 16, χ (a : ZMod 16) * z ^ a =
      z + v * z ^ 3 + u * v3 * z ^ 5 + u * v2 * z ^ 7 + v2 * z ^ 9 + v3 * z ^ 11 + u * v * z ^ 13 + u * z ^ 15 := by
  have h0 : χ ((0 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 0 (by decide)
  have h1 : χ ((1 : ℕ) : ZMod 16) = 1 := by rw [Nat.cast_one, map_one]
  have h2 : χ ((2 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 2 (by decide)
  have h3 : χ ((3 : ℕ) : ZMod 16) = v := hv
  have h4 : χ ((4 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 4 (by decide)
  have h5 : χ ((5 : ℕ) : ZMod 16) = u * v3 := by
    have e : ((5 : ℕ) : ZMod 16) = ((15 : ℕ) : ZMod 16) * ((3 : ℕ) : ZMod 16) ^ 3 := by decide
    rw [e, map_mul, map_pow, hu, hv, hv3]
  have h6 : χ ((6 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 6 (by decide)
  have h7 : χ ((7 : ℕ) : ZMod 16) = u * v2 := by
    have e : ((7 : ℕ) : ZMod 16) = ((15 : ℕ) : ZMod 16) * ((3 : ℕ) : ZMod 16) ^ 2 := by decide
    rw [e, map_mul, map_pow, hu, hv, hv2]
  have h8 : χ ((8 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 8 (by decide)
  have h9 : χ ((9 : ℕ) : ZMod 16) = v2 := by
    have e : ((9 : ℕ) : ZMod 16) = ((3 : ℕ) : ZMod 16) ^ 2 := by decide
    rw [e, map_pow, hv, hv2]
  have h10 : χ ((10 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 10 (by decide)
  have h11 : χ ((11 : ℕ) : ZMod 16) = v3 := by
    have e : ((11 : ℕ) : ZMod 16) = ((3 : ℕ) : ZMod 16) ^ 3 := by decide
    rw [e, map_pow, hv, hv3]
  have h12 : χ ((12 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 12 (by decide)
  have h13 : χ ((13 : ℕ) : ZMod 16) = u * v := by
    have e : ((13 : ℕ) : ZMod 16) = ((15 : ℕ) : ZMod 16) * ((3 : ℕ) : ZMod 16) := by decide
    rw [e, map_mul, hu, hv]
  have h14 : χ ((14 : ℕ) : ZMod 16) = 0 := nonunit_zero χ 14 (by decide)
  have h15 : χ ((15 : ℕ) : ZMod 16) = u := hu
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15]
  ring

/-- One character class modulo 16: the kernel criterion with `c = a + b i`. -/
private lemma case_16 (χ : DirichletCharacter ℂ 16) (hχ : χ ≠ 1) (u v v2 v3 : ℂ)
    (hu : χ ((15 : ℕ) : ZMod 16) = u) (hv : χ ((3 : ℕ) : ZMod 16) = v)
    (hv2 : v ^ 2 = v2) (hv3 : v ^ 3 = v3) (a b : ℝ) (p q : ℝ → ℝ)
    (hP : ∀ x : ℝ, (x : ℂ) + v * (x : ℂ) ^ 3 + u * v3 * (x : ℂ) ^ 5 + u * v2 * (x : ℂ) ^ 7 + v2 * (x : ℂ) ^ 9 + v3 * (x : ℂ) ^ 11 + u * v * (x : ℂ) ^ 13 + u * (x : ℂ) ^ 15 =
      ((p x : ℝ) : ℂ) + ((q x : ℝ) : ℂ) * Complex.I)
    (hpos : ∀ x : ℝ, 0 < x → x < 1 → 0 < a * p x - b * q x) {σ : ℝ} (hσ : 0 < σ) :
    DirichletCharacter.LFunction χ (σ : ℂ) ≠ 0 := by
  have hre : ∀ x : ℝ, (((a : ℂ) + (b : ℂ) * Complex.I) *
      ∑ k ∈ Finset.range 16, χ (k : ZMod 16) * (x : ℂ) ^ k).re = a * p x - b * q x := by
    intro x
    rw [sum_16 χ u v v2 v3 hu hv hv2 hv3, hP x, re_aux]
  refine LFunction_ofReal_ne_zero_of_kernel χ hχ ((a : ℂ) + (b : ℂ) * Complex.I) ?_ ?_ hσ
  · intro x h0 h1
    rw [hre x]
    exact (hpos x h0 h1).le
  · refine ⟨1 / 2, by norm_num, by norm_num, ?_⟩
    rw [hre]
    exact hpos _ (by norm_num) (by norm_num)

