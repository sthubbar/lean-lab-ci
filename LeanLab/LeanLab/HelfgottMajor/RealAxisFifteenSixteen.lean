/-- PROVED. `L(σ, χ) ≠ 0` for every non principal character modulo 16 and every real
`σ > 0`. -/
theorem LFunction_ofReal_ne_zero_mod_16 (χ : DirichletCharacter ℂ 16) (hχ : χ ≠ 1) {σ : ℝ}
    (hσ : 0 < σ) : DirichletCharacter.LFunction χ (σ : ℂ) ≠ 0 := by
  have hu2 : χ ((15 : ℕ) : ZMod 16) ^ 2 = 1 := by
    have e : ((15 : ℕ) : ZMod 16) ^ 2 = 1 := by decide
    rw [← map_pow, e, map_one]
  have hv4 : χ ((3 : ℕ) : ZMod 16) ^ 4 = 1 := by
    have e : ((3 : ℕ) : ZMod 16) ^ 4 = 1 := by decide
    rw [← map_pow, e, map_one]
  rcases square_root _ hu2 with hu | hu <;>
    rcases fourth_root _ hv4 with ⟨hv, h2, h3⟩ | ⟨hv, h2, h3⟩ | ⟨hv, h2, h3⟩ | ⟨hv, h2, h3⟩ <;>
    rw [hv] at h2 h3
  · exfalso
    have h8 := sum_16 χ 1 1 1 1 hu hv h2 h3 1
    rw [range_sum_one χ hχ] at h8
    norm_num at h8
  · exact case_16 χ hχ 1 (-1) 1 (-1) hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 3 - x ^ 5 + x ^ 7 + x ^ 9 - x ^ 11 - x ^ 13 + x ^ 15)
      (fun x => 0)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_16_01 x h0 h1) hσ
  · exact case_16 χ hχ 1 Complex.I (-1) (-Complex.I) hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 7 - x ^ 9 + x ^ 15)
      (fun x => x ^ 3 - x ^ 5 - x ^ 11 + x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_16_02 x h0 h1) hσ
  · exact case_16 χ hχ 1 (-Complex.I) (-1) Complex.I hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 7 - x ^ 9 + x ^ 15)
      (fun x => -x ^ 3 + x ^ 5 + x ^ 11 - x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_16_03 x h0 h1) hσ
  · exact case_16 χ hχ (-1) 1 1 1 hu hv h2 h3 (1) (0)
      (fun x => x + x ^ 3 - x ^ 5 - x ^ 7 + x ^ 9 + x ^ 11 - x ^ 13 - x ^ 15)
      (fun x => 0)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_16_10 x h0 h1) hσ
  · exact case_16 χ hχ (-1) (-1) 1 (-1) hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 3 + x ^ 5 - x ^ 7 + x ^ 9 - x ^ 11 + x ^ 13 - x ^ 15)
      (fun x => 0)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_16_11 x h0 h1) hσ
  · exact case_16 χ hχ (-1) Complex.I (-1) (-Complex.I) hu hv h2 h3 (1) (1)
      (fun x => x + x ^ 7 - x ^ 9 - x ^ 15)
      (fun x => x ^ 3 + x ^ 5 - x ^ 11 - x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_16_12 x h0 h1) hσ
  · exact case_16 χ hχ (-1) (-Complex.I) (-1) Complex.I hu hv h2 h3 (1) (-1)
      (fun x => x + x ^ 7 - x ^ 9 - x ^ 15)
      (fun x => -x ^ 3 - x ^ 5 + x ^ 11 + x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_16_13 x h0 h1) hσ

/-- The polynomial `∑_(a < 15) χ(a) z^a` through the values of `χ` at the generators. -/
private lemma sum_15 (χ : DirichletCharacter ℂ 15) (u v v2 v3 : ℂ)
    (hu : χ ((11 : ℕ) : ZMod 15) = u) (hv : χ ((2 : ℕ) : ZMod 15) = v)
    (hv2 : v ^ 2 = v2) (hv3 : v ^ 3 = v3) (z : ℂ) :
    ∑ a ∈ Finset.range 15, χ (a : ZMod 15) * z ^ a =
      z + v * z ^ 2 + v2 * z ^ 4 + u * v * z ^ 7 + v3 * z ^ 8 + u * z ^ 11 + u * v3 * z ^ 13 + u * v2 * z ^ 14 := by
  have h0 : χ ((0 : ℕ) : ZMod 15) = 0 := nonunit_zero χ 0 (by decide)
  have h1 : χ ((1 : ℕ) : ZMod 15) = 1 := by rw [Nat.cast_one, map_one]
  have h2 : χ ((2 : ℕ) : ZMod 15) = v := hv
  have h3 : χ ((3 : ℕ) : ZMod 15) = 0 := nonunit_zero χ 3 (by decide)
  have h4 : χ ((4 : ℕ) : ZMod 15) = v2 := by
    have e : ((4 : ℕ) : ZMod 15) = ((2 : ℕ) : ZMod 15) ^ 2 := by decide
    rw [e, map_pow, hv, hv2]
  have h5 : χ ((5 : ℕ) : ZMod 15) = 0 := nonunit_zero χ 5 (by decide)
  have h6 : χ ((6 : ℕ) : ZMod 15) = 0 := nonunit_zero χ 6 (by decide)
  have h7 : χ ((7 : ℕ) : ZMod 15) = u * v := by
    have e : ((7 : ℕ) : ZMod 15) = ((11 : ℕ) : ZMod 15) * ((2 : ℕ) : ZMod 15) := by decide
    rw [e, map_mul, hu, hv]
  have h8 : χ ((8 : ℕ) : ZMod 15) = v3 := by
    have e : ((8 : ℕ) : ZMod 15) = ((2 : ℕ) : ZMod 15) ^ 3 := by decide
    rw [e, map_pow, hv, hv3]
  have h9 : χ ((9 : ℕ) : ZMod 15) = 0 := nonunit_zero χ 9 (by decide)
  have h10 : χ ((10 : ℕ) : ZMod 15) = 0 := nonunit_zero χ 10 (by decide)
  have h11 : χ ((11 : ℕ) : ZMod 15) = u := hu
  have h12 : χ ((12 : ℕ) : ZMod 15) = 0 := nonunit_zero χ 12 (by decide)
  have h13 : χ ((13 : ℕ) : ZMod 15) = u * v3 := by
    have e : ((13 : ℕ) : ZMod 15) = ((11 : ℕ) : ZMod 15) * ((2 : ℕ) : ZMod 15) ^ 3 := by decide
    rw [e, map_mul, map_pow, hu, hv, hv3]
  have h14 : χ ((14 : ℕ) : ZMod 15) = u * v2 := by
    have e : ((14 : ℕ) : ZMod 15) = ((11 : ℕ) : ZMod 15) * ((2 : ℕ) : ZMod 15) ^ 2 := by decide
    rw [e, map_mul, map_pow, hu, hv, hv2]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14]
  ring

/-- One character class modulo 15: the kernel criterion with `c = a + b i`. -/
private lemma case_15 (χ : DirichletCharacter ℂ 15) (hχ : χ ≠ 1) (u v v2 v3 : ℂ)
    (hu : χ ((11 : ℕ) : ZMod 15) = u) (hv : χ ((2 : ℕ) : ZMod 15) = v)
    (hv2 : v ^ 2 = v2) (hv3 : v ^ 3 = v3) (a b : ℝ) (p q : ℝ → ℝ)
    (hP : ∀ x : ℝ, (x : ℂ) + v * (x : ℂ) ^ 2 + v2 * (x : ℂ) ^ 4 + u * v * (x : ℂ) ^ 7 + v3 * (x : ℂ) ^ 8 + u * (x : ℂ) ^ 11 + u * v3 * (x : ℂ) ^ 13 + u * v2 * (x : ℂ) ^ 14 =
      ((p x : ℝ) : ℂ) + ((q x : ℝ) : ℂ) * Complex.I)
    (hpos : ∀ x : ℝ, 0 < x → x < 1 → 0 < a * p x - b * q x) {σ : ℝ} (hσ : 0 < σ) :
    DirichletCharacter.LFunction χ (σ : ℂ) ≠ 0 := by
  have hre : ∀ x : ℝ, (((a : ℂ) + (b : ℂ) * Complex.I) *
      ∑ k ∈ Finset.range 15, χ (k : ZMod 15) * (x : ℂ) ^ k).re = a * p x - b * q x := by
    intro x
    rw [sum_15 χ u v v2 v3 hu hv hv2 hv3, hP x, re_aux]
  refine LFunction_ofReal_ne_zero_of_kernel χ hχ ((a : ℂ) + (b : ℂ) * Complex.I) ?_ ?_ hσ
  · intro x h0 h1
    rw [hre x]
    exact (hpos x h0 h1).le
  · refine ⟨1 / 2, by norm_num, by norm_num, ?_⟩
    rw [hre]
    exact hpos _ (by norm_num) (by norm_num)

private lemma pos_15_01 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    0 < (1 : ℝ) * (x - x ^ 2 + x ^ 4 - x ^ 7 - x ^ 8 + x ^ 11 - x ^ 13 + x ^ 14) - (0 : ℝ) * (0) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < y ^ 11 + 12 * x * y ^ 10 + 66 * x ^ 2 * y ^ 9 + 221 * x ^ 3 * y ^ 8 + 505 * x ^ 4 * y ^ 7 + 837 * x ^ 5 * y ^ 6 + 1043 * x ^ 6 * y ^ 5 + 994 * x ^ 7 * y ^ 4 + 720 * x ^ 8 * y ^ 3 + 380 * x ^ 9 * y ^ 2 + 132 * x ^ 10 * y + 24 * x ^ 11 :=
    fun y hy => by positivity
  have e : (1 : ℝ) * (x - x ^ 2 + x ^ 4 - x ^ 7 - x ^ 8 + x ^ 11 - x ^ 13 + x ^ 14) - (0 : ℝ) * (0) =
      x * (1 - x) ^ 2 * ((1 - x) ^ 11 + 12 * x * (1 - x) ^ 10 + 66 * x ^ 2 * (1 - x) ^ 9 + 221 * x ^ 3 * (1 - x) ^ 8 + 505 * x ^ 4 * (1 - x) ^ 7 + 837 * x ^ 5 * (1 - x) ^ 6 + 1043 * x ^ 6 * (1 - x) ^ 5 + 994 * x ^ 7 * (1 - x) ^ 4 + 720 * x ^ 8 * (1 - x) ^ 3 + 380 * x ^ 9 * (1 - x) ^ 2 + 132 * x ^ 10 * (1 - x) + 24 * x ^ 11) := by
    ring
  rw [e]
  exact mul_pos (mul_pos h0 (pow_pos hy 2)) (key _ hy)

private lemma pos_15_02 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    0 < (2 : ℝ) * (x - x ^ 4 + x ^ 11 - x ^ 14) - (1 : ℝ) * (x ^ 2 + x ^ 7 - x ^ 8 - x ^ 13) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < 2 * y ^ 11 + 25 * x * y ^ 10 + 144 * x ^ 2 * y ^ 9 + 504 * x ^ 3 * y ^ 8 + 1190 * x ^ 4 * y ^ 7 + 1989 * x ^ 5 * y ^ 6 + 2399 * x ^ 6 * y ^ 5 + 2082 * x ^ 7 * y ^ 4 + 1263 * x ^ 8 * y ^ 3 + 495 * x ^ 9 * y ^ 2 + 99 * x ^ 10 * y :=
    fun y hy => by positivity
  have e : (2 : ℝ) * (x - x ^ 4 + x ^ 11 - x ^ 14) - (1 : ℝ) * (x ^ 2 + x ^ 7 - x ^ 8 - x ^ 13) =
      x * (1 - x) ^ 2 * (2 * (1 - x) ^ 11 + 25 * x * (1 - x) ^ 10 + 144 * x ^ 2 * (1 - x) ^ 9 + 504 * x ^ 3 * (1 - x) ^ 8 + 1190 * x ^ 4 * (1 - x) ^ 7 + 1989 * x ^ 5 * (1 - x) ^ 6 + 2399 * x ^ 6 * (1 - x) ^ 5 + 2082 * x ^ 7 * (1 - x) ^ 4 + 1263 * x ^ 8 * (1 - x) ^ 3 + 495 * x ^ 9 * (1 - x) ^ 2 + 99 * x ^ 10 * (1 - x)) := by
    ring
  rw [e]
  exact mul_pos (mul_pos h0 (pow_pos hy 2)) (key _ hy)

private lemma pos_15_03 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    0 < (2 : ℝ) * (x - x ^ 4 + x ^ 11 - x ^ 14) - (-1 : ℝ) * (-x ^ 2 - x ^ 7 + x ^ 8 + x ^ 13) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < 2 * y ^ 11 + 25 * x * y ^ 10 + 144 * x ^ 2 * y ^ 9 + 504 * x ^ 3 * y ^ 8 + 1190 * x ^ 4 * y ^ 7 + 1989 * x ^ 5 * y ^ 6 + 2399 * x ^ 6 * y ^ 5 + 2082 * x ^ 7 * y ^ 4 + 1263 * x ^ 8 * y ^ 3 + 495 * x ^ 9 * y ^ 2 + 99 * x ^ 10 * y :=
    fun y hy => by positivity
  have e : (2 : ℝ) * (x - x ^ 4 + x ^ 11 - x ^ 14) - (-1 : ℝ) * (-x ^ 2 - x ^ 7 + x ^ 8 + x ^ 13) =
      x * (1 - x) ^ 2 * (2 * (1 - x) ^ 11 + 25 * x * (1 - x) ^ 10 + 144 * x ^ 2 * (1 - x) ^ 9 + 504 * x ^ 3 * (1 - x) ^ 8 + 1190 * x ^ 4 * (1 - x) ^ 7 + 1989 * x ^ 5 * (1 - x) ^ 6 + 2399 * x ^ 6 * (1 - x) ^ 5 + 2082 * x ^ 7 * (1 - x) ^ 4 + 1263 * x ^ 8 * (1 - x) ^ 3 + 495 * x ^ 9 * (1 - x) ^ 2 + 99 * x ^ 10 * (1 - x)) := by
    ring
  rw [e]
  exact mul_pos (mul_pos h0 (pow_pos hy 2)) (key _ hy)

private lemma pos_15_10 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    0 < (1 : ℝ) * (x + x ^ 2 + x ^ 4 - x ^ 7 + x ^ 8 - x ^ 11 - x ^ 13 - x ^ 14) - (0 : ℝ) * (0) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < y ^ 12 + 14 * x * y ^ 11 + 90 * x ^ 2 * y ^ 10 + 353 * x ^ 3 * y ^ 9 + 945 * x ^ 4 * y ^ 8 + 1827 * x ^ 5 * y ^ 7 + 2627 * x ^ 6 * y ^ 6 + 2844 * x ^ 7 * y ^ 5 + 2316 * x ^ 8 * y ^ 4 + 1400 * x ^ 9 * y ^ 3 + 610 * x ^ 10 * y ^ 2 + 180 * x ^ 11 * y + 30 * x ^ 12 :=
    fun y hy => by positivity
  have e : (1 : ℝ) * (x + x ^ 2 + x ^ 4 - x ^ 7 + x ^ 8 - x ^ 11 - x ^ 13 - x ^ 14) - (0 : ℝ) * (0) =
      x * (1 - x) ^ 1 * ((1 - x) ^ 12 + 14 * x * (1 - x) ^ 11 + 90 * x ^ 2 * (1 - x) ^ 10 + 353 * x ^ 3 * (1 - x) ^ 9 + 945 * x ^ 4 * (1 - x) ^ 8 + 1827 * x ^ 5 * (1 - x) ^ 7 + 2627 * x ^ 6 * (1 - x) ^ 6 + 2844 * x ^ 7 * (1 - x) ^ 5 + 2316 * x ^ 8 * (1 - x) ^ 4 + 1400 * x ^ 9 * (1 - x) ^ 3 + 610 * x ^ 10 * (1 - x) ^ 2 + 180 * x ^ 11 * (1 - x) + 30 * x ^ 12) := by
    ring
  rw [e]
  exact mul_pos (mul_pos h0 (pow_pos hy 1)) (key _ hy)

private lemma pos_15_11 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    0 < (1 : ℝ) * (x - x ^ 2 + x ^ 4 + x ^ 7 - x ^ 8 - x ^ 11 + x ^ 13 - x ^ 14) - (0 : ℝ) * (0) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < y ^ 12 + 12 * x * y ^ 11 + 66 * x ^ 2 * y ^ 10 + 221 * x ^ 3 * y ^ 9 + 505 * x ^ 4 * y ^ 8 + 837 * x ^ 5 * y ^ 7 + 1045 * x ^ 6 * y ^ 6 + 1008 * x ^ 7 * y ^ 5 + 762 * x ^ 8 * y ^ 4 + 450 * x ^ 9 * y ^ 3 + 200 * x ^ 10 * y ^ 2 + 60 * x ^ 11 * y + 10 * x ^ 12 :=
    fun y hy => by positivity
  have e : (1 : ℝ) * (x - x ^ 2 + x ^ 4 + x ^ 7 - x ^ 8 - x ^ 11 + x ^ 13 - x ^ 14) - (0 : ℝ) * (0) =
      x * (1 - x) ^ 1 * ((1 - x) ^ 12 + 12 * x * (1 - x) ^ 11 + 66 * x ^ 2 * (1 - x) ^ 10 + 221 * x ^ 3 * (1 - x) ^ 9 + 505 * x ^ 4 * (1 - x) ^ 8 + 837 * x ^ 5 * (1 - x) ^ 7 + 1045 * x ^ 6 * (1 - x) ^ 6 + 1008 * x ^ 7 * (1 - x) ^ 5 + 762 * x ^ 8 * (1 - x) ^ 4 + 450 * x ^ 9 * (1 - x) ^ 3 + 200 * x ^ 10 * (1 - x) ^ 2 + 60 * x ^ 11 * (1 - x) + 10 * x ^ 12) := by
    ring
  rw [e]
  exact mul_pos (mul_pos h0 (pow_pos hy 1)) (key _ hy)

private lemma pos_15_12 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    0 < (1 : ℝ) * (x - x ^ 4 - x ^ 11 + x ^ 14) - (0 : ℝ) * (x ^ 2 - x ^ 7 - x ^ 8 + x ^ 13) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < y ^ 11 + 13 * x * y ^ 10 + 78 * x ^ 2 * y ^ 9 + 285 * x ^ 3 * y ^ 8 + 705 * x ^ 4 * y ^ 7 + 1242 * x ^ 5 * y ^ 6 + 1596 * x ^ 6 * y ^ 5 + 1506 * x ^ 7 * y ^ 4 + 1035 * x ^ 8 * y ^ 3 + 505 * x ^ 9 * y ^ 2 + 165 * x ^ 10 * y + 30 * x ^ 11 :=
    fun y hy => by positivity
  have e : (1 : ℝ) * (x - x ^ 4 - x ^ 11 + x ^ 14) - (0 : ℝ) * (x ^ 2 - x ^ 7 - x ^ 8 + x ^ 13) =
      x * (1 - x) ^ 2 * ((1 - x) ^ 11 + 13 * x * (1 - x) ^ 10 + 78 * x ^ 2 * (1 - x) ^ 9 + 285 * x ^ 3 * (1 - x) ^ 8 + 705 * x ^ 4 * (1 - x) ^ 7 + 1242 * x ^ 5 * (1 - x) ^ 6 + 1596 * x ^ 6 * (1 - x) ^ 5 + 1506 * x ^ 7 * (1 - x) ^ 4 + 1035 * x ^ 8 * (1 - x) ^ 3 + 505 * x ^ 9 * (1 - x) ^ 2 + 165 * x ^ 10 * (1 - x) + 30 * x ^ 11) := by
    ring
  rw [e]
  exact mul_pos (mul_pos h0 (pow_pos hy 2)) (key _ hy)

private lemma pos_15_13 (x : ℝ) (h0 : 0 < x) (h1 : x < 1) :
    0 < (1 : ℝ) * (x - x ^ 4 - x ^ 11 + x ^ 14) - (0 : ℝ) * (-x ^ 2 + x ^ 7 + x ^ 8 - x ^ 13) := by
  have hy : 0 < 1 - x := by linarith
  have key : ∀ y : ℝ, 0 < y →
      0 < y ^ 11 + 13 * x * y ^ 10 + 78 * x ^ 2 * y ^ 9 + 285 * x ^ 3 * y ^ 8 + 705 * x ^ 4 * y ^ 7 + 1242 * x ^ 5 * y ^ 6 + 1596 * x ^ 6 * y ^ 5 + 1506 * x ^ 7 * y ^ 4 + 1035 * x ^ 8 * y ^ 3 + 505 * x ^ 9 * y ^ 2 + 165 * x ^ 10 * y + 30 * x ^ 11 :=
    fun y hy => by positivity
  have e : (1 : ℝ) * (x - x ^ 4 - x ^ 11 + x ^ 14) - (0 : ℝ) * (-x ^ 2 + x ^ 7 + x ^ 8 - x ^ 13) =
      x * (1 - x) ^ 2 * ((1 - x) ^ 11 + 13 * x * (1 - x) ^ 10 + 78 * x ^ 2 * (1 - x) ^ 9 + 285 * x ^ 3 * (1 - x) ^ 8 + 705 * x ^ 4 * (1 - x) ^ 7 + 1242 * x ^ 5 * (1 - x) ^ 6 + 1596 * x ^ 6 * (1 - x) ^ 5 + 1506 * x ^ 7 * (1 - x) ^ 4 + 1035 * x ^ 8 * (1 - x) ^ 3 + 505 * x ^ 9 * (1 - x) ^ 2 + 165 * x ^ 10 * (1 - x) + 30 * x ^ 11) := by
    ring
  rw [e]
  exact mul_pos (mul_pos h0 (pow_pos hy 2)) (key _ hy)

/-- PROVED. `L(σ, χ) ≠ 0` for every non principal character modulo 15 and every real
`σ > 0`. -/
theorem LFunction_ofReal_ne_zero_mod_15 (χ : DirichletCharacter ℂ 15) (hχ : χ ≠ 1) {σ : ℝ}
    (hσ : 0 < σ) : DirichletCharacter.LFunction χ (σ : ℂ) ≠ 0 := by
  have hu2 : χ ((11 : ℕ) : ZMod 15) ^ 2 = 1 := by
    have e : ((11 : ℕ) : ZMod 15) ^ 2 = 1 := by decide
    rw [← map_pow, e, map_one]
  have hv4 : χ ((2 : ℕ) : ZMod 15) ^ 4 = 1 := by
    have e : ((2 : ℕ) : ZMod 15) ^ 4 = 1 := by decide
    rw [← map_pow, e, map_one]
  rcases square_root _ hu2 with hu | hu <;>
    rcases fourth_root _ hv4 with ⟨hv, h2, h3⟩ | ⟨hv, h2, h3⟩ | ⟨hv, h2, h3⟩ | ⟨hv, h2, h3⟩ <;>
    rw [hv] at h2 h3
  · exfalso
    have h8 := sum_15 χ 1 1 1 1 hu hv h2 h3 1
    rw [range_sum_one χ hχ] at h8
    norm_num at h8
  · exact case_15 χ hχ 1 (-1) 1 (-1) hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 2 + x ^ 4 - x ^ 7 - x ^ 8 + x ^ 11 - x ^ 13 + x ^ 14)
      (fun x => 0)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_15_01 x h0 h1) hσ
  · exact case_15 χ hχ 1 Complex.I (-1) (-Complex.I) hu hv h2 h3 (2) (1)
      (fun x => x - x ^ 4 + x ^ 11 - x ^ 14)
      (fun x => x ^ 2 + x ^ 7 - x ^ 8 - x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_15_02 x h0 h1) hσ
  · exact case_15 χ hχ 1 (-Complex.I) (-1) Complex.I hu hv h2 h3 (2) (-1)
      (fun x => x - x ^ 4 + x ^ 11 - x ^ 14)
      (fun x => -x ^ 2 - x ^ 7 + x ^ 8 + x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_15_03 x h0 h1) hσ
  · exact case_15 χ hχ (-1) 1 1 1 hu hv h2 h3 (1) (0)
      (fun x => x + x ^ 2 + x ^ 4 - x ^ 7 + x ^ 8 - x ^ 11 - x ^ 13 - x ^ 14)
      (fun x => 0)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_15_10 x h0 h1) hσ
  · exact case_15 χ hχ (-1) (-1) 1 (-1) hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 2 + x ^ 4 + x ^ 7 - x ^ 8 - x ^ 11 + x ^ 13 - x ^ 14)
      (fun x => 0)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_15_11 x h0 h1) hσ
  · exact case_15 χ hχ (-1) Complex.I (-1) (-Complex.I) hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 4 - x ^ 11 + x ^ 14)
      (fun x => x ^ 2 - x ^ 7 - x ^ 8 + x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_15_12 x h0 h1) hσ
  · exact case_15 χ hχ (-1) (-Complex.I) (-1) Complex.I hu hv h2 h3 (1) (0)
      (fun x => x - x ^ 4 - x ^ 11 + x ^ 14)
      (fun x => -x ^ 2 + x ^ 7 + x ^ 8 - x ^ 13)
      (fun x => by push_cast; ring) (fun x h0 h1 => pos_15_13 x h0 h1) hσ

end LeanLab.HelfgottMajor.RealAxisKernel

