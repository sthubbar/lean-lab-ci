/-- Decode the upward rounded cosine certificate at a reflected residue. -/
def cosLookup177 (r : ℕ) : ℚ :=
  (((((cosWord177 (r/128)) / 2^(35*(r%128))) % 2^35 : ℕ) : ℤ) - 10^10 : ℤ) / (10^10 : ℚ)

/-- Extend the packed cosine certificate periodically and by reflection. -/
def cosCached177 (r : ℕ) : ℚ := cosLookup177 (min (r%65536) (65536-r%65536))
/-- The rational exponential envelope evaluated using the packed cosine table. -/
def cachedTerm177 (ξ : ℚ) (r : ℕ) : ℚ :=
  expUpper177 (ξ * ∑ n ∈ range 16, cosCached177 (r*2^n))
/-- A block of 128 interior residue terms in the folded certificate. -/
def cachedBlock177 (ξ : ℚ) (b : ℕ) : ℚ :=
  ∑ r ∈ range 128, cachedTerm177 ξ (128*b+r+1)

/-- A correct table on the half grid gives the original cosine envelope at every residue. -/
theorem cosCached_eq177
    (hcorrect : ∀ r < 32769, cosUpper177 65536 r = cosLookup177 r) (r : ℕ) :
    cosUpper177 65536 r = cosCached177 r := by
  let s := min (r%65536) (65536-r%65536)
  have hr := Nat.mod_lt r (by norm_num : 0 < 65536)
  have hs : s ≤ 32768 := by dsimp [s]; omega
  have hs' : s < 65536 := by omega
  have hss : min (s%65536) (65536-s%65536) = s := by
    rw [Nat.mod_eq_of_lt hs']
    omega
  have heq : cosUpper177 65536 r = cosUpper177 65536 s := by
    unfold cosUpper177 gridAngle177
    rw [hss]
  change cosUpper177 65536 r = cosLookup177 s
  exact heq.trans (hcorrect s (by omega))

/-- Partition a rational finite sum into equal consecutive blocks. -/
theorem sum_blocks177 (f : ℕ → ℚ) (n m : ℕ) :
    (∑ r ∈ range (n*m), f r) = ∑ b ∈ range n, ∑ r ∈ range m, f (m*b+r) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.succ_mul, sum_range_add, sum_range_succ, ih]
    congr 1
    apply sum_congr rfl
    intro r hr
    congr 1
    ring

/-- The folded certificate is the sum of 256 blocks and the two endpoint corrections. -/
