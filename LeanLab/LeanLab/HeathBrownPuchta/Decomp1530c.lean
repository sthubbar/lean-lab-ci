    (hcorrect : ∀ r < 32769, cosUpper177 65536 r = cosLookup177 r) (ξ : ℚ) :
    Ffold177 ξ = (cachedTerm177 ξ 0 - cachedTerm177 ξ 32768 +
      2 * ∑ b ∈ range 256, cachedBlock177 ξ b) / 65536 := by
  have heq (r : ℕ) : expUpper177 (ξ * ∑ n ∈ range 16, cosUpper177 65536 (r*2^n)) =
      cachedTerm177 ξ r := by
    unfold cachedTerm177
    simp_rw [cosCached_eq177 hcorrect]
  unfold Ffold177
  simp_rw [heq]
  have hb := sum_blocks177 (fun r => cachedTerm177 ξ (r+1)) 256 128
  norm_num only [Nat.reduceMul] at hb
