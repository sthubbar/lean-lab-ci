import LeanLab.HeathBrownPuchta.Decomp1530b
import LeanLab.Linnik.Statements

namespace LeanLab.HeathBrownPuchta.Decomp1530c

open Finset Real LeanLab.HeathBrownPuchta.Decomp1530a LeanLab.HeathBrownPuchta.Decomp1530b
open LeanLab.Linnik
attribute [local instance 10] Classical.propDecidable
set_option maxHeartbeats 2000000

/-- Display 44: `F(ξ, h)` at `β = 0`, `ρ = 1`, written with cosines,
`2^{-h} Σ_{0 ≤ r < 2^h} exp(ξ Σ_{0 ≤ n < h} cos(2π r 2^n / 2^h))`. -/
noncomputable def Fzero (ξ : ℝ) (hh : ℕ) : ℝ :=
  (1 / 2 ^ hh) * ∑ r ∈ range (2 ^ hh),
    Real.exp (ξ * ∑ n ∈ range hh, Real.cos (2 * π * ((r : ℝ) * 2 ^ n / 2 ^ hh)))

/-- The Section 7 exponent `E = ξλ/log 2 - log F/(h log 2)`. -/
noncomputable def Emodel (ξ lam F0 : ℝ) (hh : ℕ) : ℝ :=
  ξ * lam / Real.log 2 - Real.log F0 / (hh * Real.log 2)

/-- `Σ 2^{a_i} - Σ 2^{b_j}` for exponent tuples `a`, `b`, display 45. -/
def Dsum {m k : ℕ} (ab : (Fin m → ℕ) × (Fin k → ℕ)) : ℤ :=
  ∑ i, (2 : ℤ) ^ ab.1 i - ∑ j, (2 : ℤ) ^ ab.2 j

/-- The moment `Σ_{0 ≤ r < 2^h} T_h(x_r)^m conj(T_h(x_r))^k`, `x_r = (β + r)/2^h`, display 45. -/
noncomputable def moment (hh m k : ℕ) (β : ℝ) : ℂ :=
  ∑ r ∈ range (2 ^ hh), TL hh ((β + r) / 2 ^ hh) ^ m *
    (starRingEnd ℂ) (TL hh ((β + r) / 2 ^ hh)) ^ k

/-- The representations `N = p + p' + 2^{ν₁} + ... + 2^{ν_K}`, `ϖN < p, p' ≤ N`,
`1 ≤ ν_i ≤ L`, Section 2. -/
noncomputable def reps (N : ℕ) (w : ℝ) (L K : ℕ) : Finset (ℕ × ℕ × (Fin K → ℕ)) :=
  (primesIn N w ×ˢ (primesIn N w ×ˢ Fintype.piFinset fun _ => Icc 1 L)).filter
    fun x => x.1 + x.2.1 + ∑ i, 2 ^ (x.2.2 i) = N

/-- `R(N) = ∫₀¹ S(α)² T(α)^K e(-αN) dα`, Section 2. -/
noncomputable def Rint (N : ℕ) (w : ℝ) (L K : ℕ) : ℂ :=
  ∫ α in (0 : ℝ)..1, Sp N w α ^ 2 * Tp L α ^ K * ee (-(α * N))

/-! ### Leaves: display 44 -/

/-- LEAF. Unit U-1530. At `α = r/2^h`, `Re T_h(α) = Σ_{0 ≤ n < h} cos(2π r 2^n/2^h)`;
Section 7, display 44. -/
theorem TL_re_at (hh r : ℕ) :
    (TL hh ((r : ℝ) / 2 ^ hh)).re =
      ∑ n ∈ range hh, Real.cos (2 * π * ((r : ℝ) * 2 ^ n / 2 ^ hh)) := by
  unfold TL ee
  simp only [Complex.re_sum]
  apply sum_congr rfl
  intro n hn
  rw [Complex.exp_re]
  simp [-Complex.ofReal_pow]
  congr 1
  ring

/-- The finite character orthogonality used in paper page 31, display 45. -/
theorem ee_grid_sum (d : ℕ) (hd : 0 < d) (D : ℤ) (β : ℝ) :
    ∑ r ∈ range d, ee ((β + r) * D / d) =
      if (d : ℤ) ∣ D then (d : ℂ) * ee (β * D / d) else 0 := by
  have hdr : (d : ℝ) ≠ 0 := by exact_mod_cast hd.ne'
  have hadd (x y : ℝ) : ee (x + y) = ee x * ee y := by
    unfold ee
    rw [Complex.ofReal_add, mul_add, Complex.exp_add]
  have hn (x : ℝ) (n : ℕ) : ee ((n : ℝ) * x) = ee x ^ n := by
    unfold ee
    rw [← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  have hint (n : ℤ) : ee (n : ℝ) = 1 := by simpa [ee] using ee_int_shift 0 n
  have hone : ee ((D : ℝ) / d) = 1 ↔ (d : ℤ) ∣ D := by
    constructor
    · intro h
      obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.mp h
      have hi := congrArg Complex.im hk
      norm_num [Complex.mul_im, Complex.mul_re] at hi
      have hh : (D : ℝ) = (d : ℝ) * k := by
        field_simp at hi
        nlinarith [Real.pi_pos]
      exact ⟨k, by exact_mod_cast hh⟩
    · rintro ⟨k, hk⟩
      rw [hk]
      push_cast
      rw [mul_div_cancel_left₀ _ hdr]
      exact hint k
  have hroot : ee ((D : ℝ) / d) ^ d = 1 := by
    rw [← hn, mul_div_cancel₀ _ hdr]
    exact hint D
  have heq : ∑ r ∈ range d, ee ((β + r) * D / d) =
      ee (β * D / d) * ∑ r ∈ range d, ee ((D : ℝ) / d) ^ r := by
    rw [mul_sum]
    apply sum_congr rfl
    intro r hr
    rw [← hn, ← hadd]
    congr 1
    ring
  rw [heq]
  by_cases hdiv : (d : ℤ) ∣ D
  · rw [if_pos hdiv, hone.mpr hdiv]
    simp [mul_comm]
  · rw [if_neg hdiv]
    have hne := mt hone.mp hdiv
    have hg := geom_sum_mul (ee ((D : ℝ) / d)) d
    rw [hroot, sub_self] at hg
    have hzero := (mul_eq_zero.mp hg).resolve_right (sub_ne_zero.mpr hne)
    rw [hzero, mul_zero]

/-- LEAF. Unit U-1530. The moment formula: the moment at `β` equals `2^h` times the sum of
`e(β D/2^h)` over the exponent tuples `a ∈ [0,h)^m`, `b ∈ [0,h)^k` whose difference
`D = Σ 2^{a_i} - Σ 2^{b_j}` is divisible by `2^h`; Section 7, display 45. -/
theorem moment_formula (hh m k : ℕ) (β : ℝ) :
    moment hh m k β = 2 ^ hh * ∑ ab ∈ ((Fintype.piFinset fun _ : Fin m => range hh) ×ˢ
        (Fintype.piFinset fun _ : Fin k => range hh)).filter (fun ab => (2 : ℤ) ^ hh ∣ Dsum ab),
      ee (β * (Dsum ab : ℝ) / 2 ^ hh) := by
  classical
  have hadd (x y : ℝ) : ee (x + y) = ee x * ee y := by
    unfold ee
    rw [Complex.ofReal_add, mul_add, Complex.exp_add]
  have hc (x : ℝ) : (starRingEnd ℂ) (ee x) = ee (-x) := by
    unfold ee
    rw [← Complex.exp_conj]
    congr 1
    simp [map_ofNat]
  have hprod (α : ℝ) (j : ℕ) (a : Fin j → ℕ) :
      (∏ i, ee (α * 2 ^ (a i))) = ee (α * ∑ i, (2 : ℝ) ^ (a i)) := by
    unfold ee
    rw [← Complex.exp_sum]
    congr 1
    push_cast
    simp only [mul_sum]
  have point (r : ℕ) :
      TL hh ((β + r) / 2 ^ hh) ^ m * (starRingEnd ℂ) (TL hh ((β + r) / 2 ^ hh)) ^ k =
      ∑ a ∈ Fintype.piFinset (fun _ : Fin m => range hh),
        ∑ b ∈ Fintype.piFinset (fun _ : Fin k => range hh),
          ee ((β + r) * (Dsum (a, b) : ℝ) / 2 ^ hh) := by
    unfold TL
    simp only [map_sum, Finset.sum_pow', map_prod, hc, sum_mul, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro a ha
    apply sum_congr rfl
    intro b hb
    have hneg : (∏ i, ee (-(((β + r) / 2 ^ hh) * 2 ^ (b i)))) =
        ee (-((β + r) / 2 ^ hh) * ∑ i, (2 : ℝ) ^ (b i)) := by
      convert hprod (-((β + r) / 2 ^ hh)) k b using 1
      apply prod_congr rfl
      intro i hi
      congr 1
      ring
    rw [hprod, hneg, ← hadd]
    congr 1
    unfold Dsum
    push_cast
    ring
  unfold moment
  simp_rw [point]
  calc
    _ = ∑ a ∈ Fintype.piFinset (fun _ : Fin m => range hh),
        ∑ b ∈ Fintype.piFinset (fun _ : Fin k => range hh),
          ∑ r ∈ range (2 ^ hh), ee ((β + r) * (Dsum (a, b) : ℝ) / 2 ^ hh) := by
      rw [sum_comm]
      apply sum_congr rfl
      intro a ha
      rw [sum_comm]
    _ = ∑ ab ∈ (Fintype.piFinset (fun _ : Fin m => range hh)) ×ˢ
        (Fintype.piFinset (fun _ : Fin k => range hh)),
          if (2 : ℤ) ^ hh ∣ Dsum ab then (2 : ℂ) ^ hh * ee (β * (Dsum ab : ℝ) / 2 ^ hh) else 0 := by
      rw [sum_product]
      apply sum_congr rfl
      intro a ha
      apply sum_congr rfl
      intro b hb
      simpa using ee_grid_sum (2 ^ hh) (by positivity) (Dsum (a, b)) β
    _ = _ := by rw [sum_filter, mul_sum]; apply sum_congr rfl; intro ab hab; split_ifs <;> simp_all

/-- LEAF. Unit U-1530. Every moment is at most the moment at `β = 0` in absolute value, and that
one is real: `|S(n, m, h, β)| ≤ S(n, m, h, 0)`; Section 7, after display 45. -/
theorem moment_abs_le (hh m k : ℕ) (β : ℝ) :
    ‖moment hh m k β‖ ≤ (moment hh m k 0).re ∧ (moment hh m k 0).im = 0 := by
  classical
  let s := ((Fintype.piFinset fun _ : Fin m => range hh) ×ˢ
    (Fintype.piFinset fun _ : Fin k => range hh)).filter (fun ab => (2 : ℤ) ^ hh ∣ Dsum ab)
  have hzero : moment hh m k 0 = ((2 ^ hh * s.card : ℕ) : ℂ) := by
    rw [moment_formula]
    change (2 : ℂ) ^ hh * (∑ ab ∈ s, ee (0 * (Dsum ab : ℝ) / 2 ^ hh)) = _
    simp [ee]
  rw [hzero]
  constructor
  · rw [moment_formula, Complex.natCast_re]
    change ‖(2 : ℂ) ^ hh * ∑ ab ∈ s, ee (β * (Dsum ab : ℝ) / 2 ^ hh)‖ ≤ _
    have hnorm (x : ℝ) : ‖ee x‖ = 1 := by simp [ee, Complex.norm_exp]
    calc
      _ = (2 : ℝ) ^ hh * ‖∑ ab ∈ s, ee (β * (Dsum ab : ℝ) / 2 ^ hh)‖ := by simp [norm_mul]
      _ ≤ (2 : ℝ) ^ hh * ∑ ab ∈ s, ‖ee (β * (Dsum ab : ℝ) / 2 ^ hh)‖ :=
        mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
      _ = ((2 ^ hh * s.card : ℕ) : ℝ) := by simp [hnorm]
  · simp only [Complex.natCast_im]

/-- The real power moment comparison used on paper pages 30 and 31, displays 45 and 46. -/
theorem re_power_sum_le (hh n : ℕ) (β : ℝ) {ρ : ℂ} (hρ : ‖ρ‖ = 1) :
    ∑ r ∈ range (2 ^ hh), (ρ * TL hh ((β + r) / 2 ^ hh)).re ^ n ≤
      ∑ r ∈ range (2 ^ hh), (TL hh ((r : ℝ) / 2 ^ hh)).re ^ n := by
  have htwo (z : ℂ) : (2 : ℂ) * (z.re : ℂ) = z + (starRingEnd ℂ) z := by
    simpa only [Complex.ofReal_mul, Complex.ofReal_ofNat] using (Complex.add_conj z).symm
  have hpoly (ρ : ℂ) (β : ℝ) :
      (2 : ℂ) ^ n * ((∑ r ∈ range (2 ^ hh), (ρ * TL hh ((β + r) / 2 ^ hh)).re ^ n : ℝ) : ℂ) =
        ∑ j ∈ range (n + 1), (n.choose j : ℂ) * ρ ^ j * (starRingEnd ℂ) ρ ^ (n - j) *
          moment hh j (n - j) β := by
    push_cast
    rw [mul_sum]
    simp_rw [← mul_pow, htwo, map_mul, add_pow, mul_pow]
    rw [sum_comm]
    apply sum_congr rfl
    intro j hj
    unfold moment
    rw [mul_sum]
    apply sum_congr rfl
    intro r hr
    ring
  have hleft := congrArg Complex.re (hpoly ρ β)
  have hright := congrArg Complex.re (hpoly 1 0)
  have hterm (j : ℕ) :
      ((n.choose j : ℂ) * ρ ^ j * (starRingEnd ℂ) ρ ^ (n - j) * moment hh j (n - j) β).re ≤
        (n.choose j : ℝ) * (moment hh j (n - j) 0).re := by
    calc
      _ ≤ ‖(n.choose j : ℂ) * ρ ^ j * (starRingEnd ℂ) ρ ^ (n - j) * moment hh j (n - j) β‖ :=
        Complex.re_le_norm _
      _ = (n.choose j : ℝ) * ‖moment hh j (n - j) β‖ := by simp [norm_mul, norm_pow, hρ]
      _ ≤ _ := mul_le_mul_of_nonneg_left (moment_abs_le hh j (n - j) β).1 (Nat.cast_nonneg _)
  have hsum := sum_le_sum (s := range (n + 1)) (fun j hj => hterm j)
  have hnr : (0 : ℝ) < 2 ^ n := by positivity
  have hcast : (2 : ℂ) ^ n = Complex.ofReal ((2 : ℝ) ^ n) := by norm_cast
  rw [hcast, Complex.re_ofReal_mul, Complex.ofReal_re, Complex.re_sum] at hleft
  rw [hcast, Complex.re_ofReal_mul, Complex.ofReal_re, Complex.re_sum] at hright
  simp only [map_one, one_pow, mul_one, one_mul, zero_add,
    Complex.mul_re, Complex.natCast_re, Complex.natCast_im, zero_mul, sub_zero] at hright
  nlinarith

/-- LEAF. Unit U-1530. For `ξ ≥ 0` and `|ρ| = 1` the inner average of display 43 is at most its
value at `β = 0`, `ρ = 1`; proof by the power series of `exp`, `Re w = (w + conj w)/2` and
`moment_abs_le`; Section 7, display 44. -/
theorem avg_le_avg_zero (ξ : ℝ) (hξ : 0 ≤ ξ) {ρ : ℂ} (hρ : ‖ρ‖ = 1) (hh : ℕ) (β : ℝ) :
    avg ξ ρ hh β ≤ avg ξ 1 hh 0 := by
  have hs (f : ℕ → ℝ) :
      HasSum (fun n : ℕ => ∑ r ∈ range (2 ^ hh), (ξ * f r) ^ n / n.factorial)
        (∑ r ∈ range (2 ^ hh), Real.exp (ξ * f r)) := by
    apply hasSum_sum
    intro r hr
    simpa only [Real.exp_eq_exp_ℝ] using NormedSpace.expSeries_div_hasSum_exp (ξ * f r)
  have hfactor (f : ℕ → ℝ) (n : ℕ) :
      (∑ r ∈ range (2 ^ hh), (ξ * f r) ^ n / n.factorial) =
        (ξ ^ n / n.factorial) * ∑ r ∈ range (2 ^ hh), f r ^ n := by
    rw [mul_sum]
    apply sum_congr rfl
    intro r hr
    rw [mul_pow]
    ring
  have ht (n : ℕ) :
      (∑ r ∈ range (2 ^ hh), (ξ * (ρ * TL hh ((β + r) / 2 ^ hh)).re) ^ n / n.factorial) ≤
      ∑ r ∈ range (2 ^ hh), (ξ * (TL hh ((r : ℝ) / 2 ^ hh)).re) ^ n / n.factorial := by
    rw [hfactor, hfactor]
    exact mul_le_mul_of_nonneg_left (re_power_sum_le hh n β hρ) (by positivity)
  have he := hasSum_le ht (hs (fun r => (ρ * TL hh ((β + r) / 2 ^ hh)).re))
    (hs (fun r => (TL hh ((r : ℝ) / 2 ^ hh)).re))
  unfold avg
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  simpa only [one_mul, zero_add] using he

/-- LEAF. Unit U-1530. `F(ξ, h) ≥ 1` at `β = 0`, `ρ = 1`: the cosines average to `0` over `r`
for each `n < h`, so Jensen gives the bound; Section 7, display 44. -/
theorem Fzero_ge_one (ξ : ℝ) (hh : ℕ) : 1 ≤ Fzero ξ hh := by
  have hd : (0 : ℝ) < 2 ^ hh := by positivity
  have hcos (n : ℕ) (hn : n < hh) :
      ∑ r ∈ range (2 ^ hh), Real.cos (2 * π * ((r : ℝ) * 2 ^ n / 2 ^ hh)) = 0 := by
    let a : ℝ := 2 * π * 2 ^ n / 2 ^ hh
    have hlt : (2 : ℝ) ^ n < 2 ^ hh := (pow_lt_pow_right₀ (by norm_num) hn)
    have ha0 : 0 < a / 2 := by dsimp [a]; positivity
    have hapi : a / 2 < π := by
      dsimp [a]
      rw [div_div, div_lt_iff₀ (by positivity : (0 : ℝ) < 2 ^ hh * 2)]
      nlinarith [Real.pi_pos]
    have hs : Real.sin ((2 : ℝ) ^ n * π) = 0 := by
      exact_mod_cast Real.sin_nat_mul_pi (2 ^ n)
    have hangle : ((2 ^ hh : ℕ) : ℝ) * a / 2 = (2 : ℝ) ^ n * π := by
      dsimp [a]
      push_cast
      field_simp
    have hformula := Real.sin_mul_sum_cos (2 ^ hh) a 0
    rw [hangle, hs, zero_mul] at hformula
    have hsin : Real.sin (a / 2) ≠ 0 := (Real.sin_pos_of_pos_of_lt_pi ha0 hapi).ne'
    have hsum := (mul_eq_zero.mp hformula).resolve_left hsin
    simp only [add_zero] at hsum
    convert hsum using 1
    apply sum_congr rfl
    intro r hr
    congr 1
    dsimp [a]
    ring
  have hzero : ∑ r ∈ range (2 ^ hh), ∑ n ∈ range hh,
      Real.cos (2 * π * ((r : ℝ) * 2 ^ n / 2 ^ hh)) = 0 := by
    rw [sum_comm]
    exact sum_eq_zero fun n hn => hcos n (mem_range.mp hn)
  have he : (2 : ℝ) ^ hh ≤ ∑ r ∈ range (2 ^ hh),
      Real.exp (ξ * ∑ n ∈ range hh, Real.cos (2 * π * ((r : ℝ) * 2 ^ n / 2 ^ hh))) := by
    calc
      _ = ∑ r ∈ range (2 ^ hh), (1 + ξ * ∑ n ∈ range hh,
          Real.cos (2 * π * ((r : ℝ) * 2 ^ n / 2 ^ hh))) := by
        rw [sum_add_distrib, ← mul_sum, hzero]
        simp
      _ ≤ _ := sum_le_sum fun r hr => by
        have hx := Real.add_one_le_exp (ξ * ∑ n ∈ range hh, Real.cos (2 * π * ((r : ℝ) * 2 ^ n / 2 ^ hh)))
        linarith
  unfold Fzero
  rw [one_div_mul_eq_div, le_div_iff₀ hd, one_mul]
  exact he

/-- A rationally bounded cosine Taylor remainder for the computation in Section 7,
pages 30 and 31, display 44. -/
theorem cos_taylor177 (x : ℝ) (hx : |x| ≤ 4) :
    |Real.cos x - ∑ n ∈ range 16, (-1 : ℝ)^n * x^(2*n) / (2*n).factorial| ≤
      (1 / 10^12 : ℝ) := by
  have hn : ‖(x : ℂ) * Complex.I‖ ≤ 4 := by simpa using hx
  have h := Complex.exp_bound' (n := 32) (x := (x : ℂ) * Complex.I) (by
    norm_num only [Nat.reduceAdd, Nat.cast_ofNat]
    linarith)
  have hr := (Complex.abs_re_le_norm ((Complex.exp ((x : ℂ) * Complex.I)) -
    ∑ m ∈ range 32, ((x : ℂ) * Complex.I)^m / m.factorial)).trans h
  have heq : (Complex.exp ((x : ℂ) * Complex.I) -
      ∑ m ∈ range 32, ((x : ℂ) * Complex.I)^m / m.factorial).re =
      Real.cos x - ∑ n ∈ range 16, (-1 : ℝ)^n * x^(2*n) / (2*n).factorial := by
    rw [Complex.sub_re, Complex.exp_ofReal_mul_I_re]
    norm_num [sum_range_succ, pow_succ, Complex.mul_re, Complex.mul_im,
      Complex.div_re, Complex.div_im, Complex.normSq, Nat.factorial]
  rw [heq] at hr
  calc
    _ ≤ ‖(x : ℂ) * Complex.I‖ ^ 32 / (32).factorial * 2 := hr
    _ ≤ (4 : ℝ)^32 / (32).factorial * 2 := by gcongr
    _ ≤ _ := by norm_num [Nat.factorial]

/-- Reduce a rational grid cosine modulo its period and reflect into the half grid.
Section 7, page 30, display 44. -/
theorem cos_grid_fold177 (d r : ℕ) (hd : 0 < d) :
    Real.cos (2 * π * (r : ℝ) / d) =
      Real.cos (2 * π * (min (r % d) (d - r % d) : ℕ) / d) := by
  have hd0 : (d : ℝ) ≠ 0 := by positivity
  have hmod : Real.cos (2 * π * (r : ℝ) / d) = Real.cos (2 * π * (r % d : ℕ) / d) := by
    have heq : 2 * π * (r : ℝ) / d =
        2 * π * (r % d : ℕ) / d + (r / d : ℕ) * (2 * π) := by
      have hh := Nat.mod_add_div r d
      have hc : (r : ℝ) = (r % d : ℕ) + (d : ℝ) * (r / d : ℕ) := by exact_mod_cast hh.symm
      rw [hc]
      field_simp
    rw [heq, Real.cos_add_nat_mul_two_pi]
  rw [hmod]
  by_cases h : r % d ≤ d - r % d
  · rw [min_eq_left h]
  · rw [min_eq_right (by omega : d - r % d ≤ r % d)]
    have hr := Nat.mod_lt r hd
    have heq : 2 * π * ((d - r % d : ℕ) : ℝ) / d =
        2 * π - 2 * π * (r % d : ℕ) / d := by
      rw [Nat.cast_sub (by omega : r % d ≤ d)]
      field_simp
    rw [heq, Real.cos_two_pi_sub]

/-- Round a rational upward to the grid of denominator D for the display 44 computation. -/
def roundUp177 (D : ℕ) (q : ℚ) : ℚ := (⌈q * D⌉ : ℚ) / D

/-- Upward rounding has error at most one grid step. -/
theorem roundUp_bounds177 (D : ℕ) (hD : 0 < D) (q : ℚ) :
    q ≤ roundUp177 D q ∧ roundUp177 D q ≤ q + 1 / D := by
  have hD' : (0 : ℚ) < D := by exact_mod_cast hD
  have hlo := Int.le_ceil (q * D)
  have hup := (Int.ceil_lt_add_one (q * D)).le
  unfold roundUp177
  constructor
  · exact (le_div_iff₀ hD').mpr hlo
  · apply (div_le_iff₀ hD').mpr
    rw [add_mul, one_div_mul_cancel (ne_of_gt hD')]
    exact hup


/-- The rational cosine Taylor polynomial through degree 30. -/
def cosPoly177 (q : ℚ) : ℚ :=
  ∑ n ∈ range 16, (-1 : ℚ)^n * q^(2*n) / (2*n).factorial

/-- A rational approximation to the reflected grid angle using the lower 20 digit pi bound. -/
def gridAngle177 (d r : ℕ) : ℚ :=
  2 * (314159265358979323846 / 10^20 : ℚ) * min (r % d) (d - r % d) / d

/-- An upward rounded rational cosine bound for display 44. -/
def cosUpper177 (d r : ℕ) : ℚ :=
  roundUp177 (10^10) (cosPoly177 (gridAngle177 d r) + 1 / 10^11)

/-- The reflected rational angle is at most 4 in absolute value, with error at most 10^-19. -/
theorem gridAngle_bounds177 (d r : ℕ) (hd : 0 < d) :
    |(gridAngle177 d r : ℝ)| ≤ 4 ∧
    |2 * π * (min (r % d) (d - r % d) : ℕ) / d - (gridAngle177 d r : ℝ)| ≤
      (1 / 10^19 : ℝ) := by
  let s := min (r % d) (d - r % d)
  have hr := Nat.mod_lt r hd
  have hs : 2 * s ≤ d := by dsimp [s]; omega
  have hsr : (0 : ℝ) ≤ s := Nat.cast_nonneg _
  have hs' : 2 * (s : ℝ) ≤ d := by exact_mod_cast hs
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  have hlo := Real.pi_gt_d20
  have hup := Real.pi_lt_d20
  have heq : (gridAngle177 d r : ℝ) =
      (314159265358979323846 / 10^20 : ℝ) * (2 * (s : ℝ) / d) := by
    simp only [gridAngle177, Rat.cast_div, Rat.cast_mul, Rat.cast_ofNat, Rat.cast_pow,
      Rat.cast_natCast]
    dsimp [s]
    ring
  have hz : 0 ≤ 2 * (s : ℝ) / d := by positivity
  have ho : 2 * (s : ℝ) / d ≤ 1 := (div_le_one hd').mpr hs'
  constructor
  · rw [heq, abs_of_nonneg (by positivity)]
    nlinarith
  · rw [heq]
    have heq' : 2 * π * (s : ℝ) / d -
        314159265358979323846 / 10^20 * (2 * (s : ℝ) / d) =
        (π - 314159265358979323846 / 10^20) * (2 * (s : ℝ) / d) := by ring
    change |2 * π * (s : ℝ) / d - _| ≤ _
    rw [heq', abs_of_nonneg (mul_nonneg (by linarith) hz)]
    nlinarith

/-- Casting the rational cosine polynomial gives the real Taylor polynomial. -/
theorem cosPoly_cast177 (q : ℚ) : (cosPoly177 q : ℝ) =
    ∑ n ∈ range 16, (-1 : ℝ)^n * (q : ℝ)^(2*n) / (2*n).factorial := by
  simp [cosPoly177]

/-- A degree 15 exponential polynomial on x/32, raised to power 32, bounds exp x for |x| ≤ 32. -/
theorem exp_scaled177 (x : ℝ) (hx : |x| ≤ 32) :
    Real.exp x ≤ ((∑ n ∈ range 16, (x/32)^n / n.factorial) + 1 / 10^12)^32 := by
  have ha : |x/32| ≤ 1 := by rw [abs_div]; norm_num; linarith
  have hh := Real.exp_bound (n := 16) ha (by norm_num)
  have he : Real.exp (x/32) ≤ (∑ n ∈ range 16, (x/32)^n / n.factorial) + 1/10^12 := by
    have hp : |x/32|^16 ≤ 1 := pow_le_one₀ (abs_nonneg _) ha
    have hb : |x/32|^16 * ((16+1 : ℕ) / ((16).factorial * (16 : ℝ))) ≤ 1/10^12 := by
      calc
        _ ≤ 1 * ((16+1 : ℕ) / ((16).factorial * (16 : ℝ))) := by gcongr
        _ ≤ _ := by norm_num [Nat.factorial]
    have ht := (abs_sub_le_iff.mp hh).1
    linarith
  calc
    Real.exp x = (Real.exp (x/32))^32 := by rw [← Real.exp_nat_mul]; congr 1; norm_num; ring
    _ ≤ _ := pow_le_pow_left₀ (Real.exp_nonneg _) he _


/-- The rational cosine envelope bounds the grid cosine and has absolute value at most 1.001. -/
theorem cosUpper_bounds177 (d r : ℕ) (hd : 0 < d) :
    Real.cos (2 * π * (r : ℝ) / d) ≤ (cosUpper177 d r : ℝ) ∧
    |(cosUpper177 d r : ℝ)| ≤ 1001 / 1000 := by
  have hb := gridAngle_bounds177 d r hd
  have ht := cos_taylor177 (gridAngle177 d r : ℝ) hb.1
  rw [← cosPoly_cast177] at ht
  have hc := (Real.abs_cos_sub_cos_le
    (2 * π * (min (r % d) (d - r % d) : ℕ) / d) (gridAngle177 d r)).trans hb.2
  rw [← cos_grid_fold177 d r hd] at hc
  have htl := (abs_sub_le_iff.mp ht).1
  have htr := (abs_sub_le_iff.mp ht).2
  have hcl := (abs_sub_le_iff.mp hc).1
  have hcr := (abs_sub_le_iff.mp hc).2
  have hu := roundUp_bounds177 (10^10) (by norm_num)
    (cosPoly177 (gridAngle177 d r) + 1 / 10^11)
  have hul := (Rat.cast_le (K := ℝ)).mpr hu.1
  have hur := (Rat.cast_le (K := ℝ)).mpr hu.2
  norm_num only [Rat.cast_add, Rat.cast_div, Rat.cast_one, Rat.cast_pow, Rat.cast_ofNat,
    Rat.cast_natCast, Nat.cast_pow, Nat.cast_ofNat] at hul hur
  have hul' : (cosPoly177 (gridAngle177 d r) : ℝ) + 1 / 10^11 ≤ (cosUpper177 d r : ℝ) := by
    convert hul using 1 <;> norm_num [cosUpper177]
  have hur' : (cosUpper177 d r : ℝ) ≤ (cosPoly177 (gridAngle177 d r) : ℝ) + 1 / 10^11 + 1 / 10^10 := by
    convert hur using 1 <;> norm_num [cosUpper177]
  constructor
  · linarith
  · rw [abs_le]
    constructor
    · have hh := Real.neg_one_le_cos (2 * π * (r : ℝ) / d)
      linarith
    · have hh := Real.cos_le_one (2 * π * (r : ℝ) / d)
      linarith

/-- An upward rounded rational exponential envelope, with final denominator 10^8. -/
def expUpper177 (q : ℚ) : ℚ :=
  roundUp177 (10^8) (((∑ n ∈ range 16, (q/32)^n / n.factorial) + 1 / 10^12)^32)

/-- The rational exponential envelope bounds exp q on |q| ≤ 32. -/
theorem expUpper_bound177 (q : ℚ) (hq : |(q : ℝ)| ≤ 32) :
    Real.exp (q : ℝ) ≤ (expUpper177 q : ℝ) := by
  have hb := (roundUp_bounds177 (10^8) (by norm_num)
    (((∑ n ∈ range 16, (q/32)^n / n.factorial) + 1 / 10^12)^32)).1
  have hb' := (Rat.cast_le (K := ℝ)).mpr hb
  simp only [Rat.cast_pow, Rat.cast_add, Rat.cast_sum, Rat.cast_div, Rat.cast_ofNat,
    Rat.cast_one, Rat.cast_natCast] at hb'
  exact (exp_scaled177 (q : ℝ) hq).trans hb' 

/-- The rational upper certificate sum for display 44, with rounded cosine and exponential envelopes. -/
def Fupper177 (ξ : ℚ) (hh : ℕ) : ℚ :=
  (∑ r ∈ range (2^hh), expUpper177 (ξ *
    ∑ n ∈ range hh, cosUpper177 (2^hh) (r * 2^n))) / 2^hh

/-- The Section 7 finite real sum is at most its rational certificate for 0 ≤ xi ≤ 5/4 and h ≤ 16. -/
theorem Fzero_le_Fupper177 (ξ : ℚ) (hξ : 0 ≤ ξ) (hξu : ξ ≤ 5/4)
    (hh : ℕ) (hh16 : hh ≤ 16) : Fzero (ξ : ℝ) hh ≤ (Fupper177 ξ hh : ℝ) := by
  have hξ' : (0 : ℝ) ≤ ξ := by exact_mod_cast hξ
  have hξu' : (ξ : ℝ) ≤ 5/4 := by
    have ht : ξ * 4 ≤ 5 := by linarith
    have ht' : (ξ : ℝ) * 4 ≤ 5 := by exact_mod_cast ht
    linarith
  have hpos : 0 < 2^hh := by positivity
  have hpoint (r : ℕ) :
      Real.exp ((ξ : ℝ) * ∑ n ∈ range hh, Real.cos (2 * π * ((r : ℝ) * 2^n / 2^hh))) ≤
        (expUpper177 (ξ * ∑ n ∈ range hh, cosUpper177 (2^hh) (r * 2^n)) : ℝ) := by
    let s : ℚ := ∑ n ∈ range hh, cosUpper177 (2^hh) (r * 2^n)
    have hsum : |(s : ℝ)| ≤ (hh : ℝ) * (1001/1000) := by
      change |((∑ n ∈ range hh, cosUpper177 (2^hh) (r * 2^n) : ℚ) : ℝ)| ≤ _
      rw [Rat.cast_sum]
      calc
        _ ≤ ∑ n ∈ range hh, |(cosUpper177 (2^hh) (r * 2^n) : ℝ)| := abs_sum_le_sum_abs _ _
        _ ≤ ∑ n ∈ range hh, (1001/1000 : ℝ) := sum_le_sum fun n hn => (cosUpper_bounds177 _ _ hpos).2
        _ = _ := by simp
    have harg : |((ξ * s : ℚ) : ℝ)| ≤ 32 := by
      rw [Rat.cast_mul, abs_mul, abs_of_nonneg hξ']
      have hh' : (hh : ℝ) ≤ 16 := by exact_mod_cast hh16
      nlinarith [abs_nonneg (s : ℝ)]
    apply le_trans _ (expUpper_bound177 (ξ * s) harg)
    apply Real.exp_le_exp.mpr
    rw [Rat.cast_mul, Rat.cast_sum]
    apply mul_le_mul_of_nonneg_left _ hξ'
    apply sum_le_sum
    intro n hn
    convert (cosUpper_bounds177 (2^hh) (r * 2^n) hpos).1 using 1
    congr 1
    push_cast
    ring
  unfold Fzero Fupper177
  push_cast
  rw [one_div_mul_eq_div]
  apply div_le_div_of_nonneg_right _ (by positivity)
  exact sum_le_sum fun r hr => hpoint r

/-- Reflecting a residue preserves its distance from zero modulo d. -/
theorem residue_reflect177 (d r k : ℕ) (hr : r ≤ d) :
    min (((d-r)*k) % d) (d - ((d-r)*k) % d) =
      min ((r*k) % d) (d - (r*k) % d) := by
  have heq : (d-r)*k + r*k = d*k := by
    rw [← add_mul, Nat.sub_add_cancel hr]
  have hh := Nat.add_mod_add_ite ((d-r)*k) (r*k) d
  rw [heq, Nat.mul_mod_right, zero_add] at hh
  split_ifs at hh <;> omega

/-- The rational cosine envelope has the reflection symmetry of display 44. -/
theorem cosUpper_reflect177 (d r k : ℕ) (hr : r ≤ d) :
    cosUpper177 d ((d-r)*k) = cosUpper177 d (r*k) := by
  unfold cosUpper177 gridAngle177
  rw [residue_reflect177 d r k hr]

/-- Pair a symmetric finite rational sum, keeping the two fixed endpoints. -/
theorem sum_half177 (f : ℕ → ℚ) (m : ℕ) (hm : 0 < m)
    (hsym : ∀ r ≤ 2*m, f (2*m-r) = f r) :
    (∑ r ∈ range (2*m), f r) =
      f 0 + f m + 2 * ∑ r ∈ range (m-1), f (r+1) := by
  have hm' : m = (m-1)+1 := by omega
  have hlo : (∑ r ∈ range m, f r) = f 0 + ∑ r ∈ range (m-1), f (r+1) := by
    conv_lhs => rw [hm', sum_range_succ']
    ring
  have hhi : (∑ r ∈ range m, f (m+r)) = f m + ∑ r ∈ range (m-1), f (m+(r+1)) := by
    rw [show (∑ r ∈ range m, f (m+r)) = ∑ r ∈ range ((m-1)+1), f (m+r) by rw [← hm']]
    rw [sum_range_succ']
    simp only [add_zero]
    ring
  have hmirror : (∑ r ∈ range (m-1), f (m+(r+1))) = ∑ r ∈ range (m-1), f (r+1) := by
    rw [← sum_range_reflect (fun r => f (m+(r+1))) (m-1)]
    apply sum_congr rfl
    intro r hr
    have hrr := mem_range.mp hr
    rw [show m+(m-1-1-r+1) = 2*m-(r+1) by omega]
    exact hsym (r+1) (by omega)
  rw [show 2*m=m+m by omega, sum_range_add, hlo, hhi, hmirror]
  ring

/-- The rational certificate with the outer residue reflection folded into 32769 terms. -/
def Ffold177 (ξ : ℚ) : ℚ :=
  let f := fun r => expUpper177 (ξ * ∑ n ∈ range 16, cosUpper177 65536 (r * 2^n))
  (f 0 + f 32768 + 2 * ∑ r ∈ range 32767, f (r+1)) / 65536

/-- The full rational certificate equals the folded certificate by reflection. -/
theorem Fupper_eq_fold177 (ξ : ℚ) : Fupper177 ξ 16 = Ffold177 ξ := by
  let f := fun r => expUpper177 (ξ * ∑ n ∈ range 16, cosUpper177 65536 (r * 2^n))
  have hs : ∀ r ≤ 2*32768, f (2*32768-r) = f r := by
    intro r hr
    dsimp [f]
    congr 2
    apply sum_congr rfl
    intro n hn
    exact cosUpper_reflect177 65536 r (2^n) hr
  have hh := sum_half177 f 32768 (by norm_num) hs
  change (∑ r ∈ range 65536, f r) / 65536 = _
  rw [show 65536 = 2*32768 by norm_num, hh]
  rfl

