/-- Correct cosine data, block bounds and endpoint arithmetic imply the required folded bound. -/
theorem Ffold_bound_of_blocks177
    (hcorrect : ∀ r < 32769, cosUpper177 65536 r = cosLookup177 r)
    (ξ B : ℚ) (bounds : Array ℕ)
    (hblocks : ∀ b : Fin 256, cachedBlock177 ξ b ≤ (bounds[b.val]?.getD 0 : ℚ)/1000)
    (hend : (cachedTerm177 ξ 0 - cachedTerm177 ξ 32768 +
      2 * ∑ b ∈ range 256, (bounds[b]?.getD 0 : ℚ)/1000) / 65536 ≤ B) : Ffold177 ξ ≤ B := by
  rw [Ffold_eq_blocks177 hcorrect]
  apply le_trans _ hend
  gcongr
  exact hblocks ⟨_, mem_range.mp ‹_ ∈ range 256›⟩





